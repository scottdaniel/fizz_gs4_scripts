#Fizzlestiks-prep.lic
#Bard version of Salvi-prep.lic (Fizzlestiks). Gearing up for combat is clearing
#hands, rubbing his five magic items (gold coin, small statue, moonstone cube,
#white crystal, black crystal) for whichever of their spells are not already
#up, readying the mace, and starting the one-handed tambourine in the off-hand
#for the hunt (the two-handed drum is the town instrument, see
#Fizzlestiks-prerest.lic).

module FizzlestiksPrep

# Stop playing the town drum before gearing up for combat -- kills the instrument
# along with the script (playsongs.lic's before_dying stows it). Kill is async,
# so wait for it to actually finish before "clear hands" below sends its own
# fput commands, to avoid the two scripts racing on the same hands.
if Script.running?("playsongs")
  Script.kill("playsongs")
  wait_while { Script.running?("playsongs") }
end

# clear hands -- "store weapon" routes the mace to the readied sheath per the
# in-game STORE config; "stow all" mops up anything left in the off-hand.
fput "store weapon"
fput "stow all"

# rub stuff, but only if the spell isn't already active -- and only pause
# after ones that actually ran, instead of always eating 3s per item. Done
# with hands cleared (above), before the weapon comes back out.
unless Spell[1701].active?
  Script.run("qverb", "rub gold coin")
  pause 3
end
unless Spell[1712].active?
  Script.run("qverb", "rub small statue")
  pause 3
end
unless Spell[1705].active?
  Script.run("qverb", "rub moonstone cube")
  pause 3
end
unless Spell[509].active?
  Script.run("qverb", "rub white crystal")
  pause 3
end
unless GameObj.loot.find { |i| i.name =~ /#{Char.name} disk/ }
  Script.run("qverb", "rub black crystal")
  pause 3
end

fput "ready weapon"

# Protects the custom weapon for the rest of the session: if anything knocks it
# out of his hand mid-hunt, this stops bigshot and goes looking for it instead
# of letting him swing fists. Restarted here in case it ever dies; it re-runs
# this script after a successful recovery, so keep this a no-op when running.
Script.start("Fizzlestiks-disarmguard") unless Script.running?("Fizzlestiks-disarmguard")

# Puts away loot eloot has no room for and unpauses it, so a full cloak can't
# leave you fighting with your hands full (see eloot_guard.lic).
Script.start("eloot_guard") unless Script.running?("eloot_guard")

# Music whether or not you're AFK: he's a bard, so unlike the other characters'
# prep scripts this ignores the afk_now UserVar (11/12).
#
# Tambourine for the hunt: one-handed, so it sits in the left hand while the
# mace stays in the right. Only if READY WEAPON actually put the weapon in
# hand -- playsongs would otherwise happily fill the free right hand and he'd
# walk out unarmed. Killed again by Fizzlestiks-prerest.lic when he returns to
# town to rest.
pause 0.5
if checkright && !Script.running?("playsongs")
  Script.start("playsongs", "tambourine")
end

end #End of module
