# Fizzleworth-attack-reim.lic
# The attack script for ;treim, for Fizzleworth in the Settlement of Reim:
#
#   ;treim fizzleworth-attack-reim.lic
#
# (;fizzreim starts treim with this itself.)
#
# WHY A WRAPPER AROUND ULTIMA. treim starts its custom attack script ONCE per spawned wave
# and does not look at it again, but Fizzleworth-attack-ultima is built for bigshot, which
# relaunches it after every pass until the target is dead: one pass is Web, 710, 706 and a
# 10 s hold, then it exits. That kills the ordinary Reim wave (one ethereal villager every
# ~35 s dies inside the 710 DoT) but not a rare spawn: the Patrol Leader took 80 s and the
# Guard Captain 95 s by hand on 11/21, and a single pass would have left either one alive and
# hitting while treim waited. So this script does what bigshot does: run ultima pass after
# pass until no living hostile is left in the room, then give up the launch.
#
# Everything else -- the Web/Maelstrom/Tether finish, crowd control on a crowd, the mana
# gating and recovery (demon mana, sacrifice mana, Symbol of Mana), the out-of-mana back-off --
# is ultima's, untouched, so a fix there applies here. Nothing in ultima's Den/Rift
# special cases (inciters, the Rift hazards, the minotaurs, the one-shot animate) can match a
# Reim creature, which are all "ethereal ...", "ghostly ...", "celestial ...", "unworldly ..."
# or a named rare.
#
# BOSSES GET A CURSE, THEN PAIN AND MANA DISRUPTION. A rare spawn (Patrol Leader, Guard Captain, ... the
# Emperor: any creature whose noun is in treim's boss list) is opened the way the Duskruin champions are in
# Fizzleworth-duskattack: Curse (715) once, from GUARDED stance (that is the Hex, -24 TD; from defensive
# the same spell is a Pox that only hurts), to push its TD down, then Pain (711, 11 mana) and Mana
# Disruption (702, 2 mana) alternately, which keeps the mana bill down (by hand on 11/21 the Guard Captain
# went down to about seven Pains with crits of 105 and 200, and the Foreign Dignitary to 8 Pains). The loop
# casts at the rare one spell after another until it is dead, REIM_PAIN_MAX casts (the Curse counts) have gone
# out at that one creature (default 16), or mana is down to the next spell plus 21 -- the cost of ultima's
# Web, 710 and 706 -- so the finish is always affordable. If the spell whose turn it is can't be afforded
# but the other can, the other is cast. After that, ultima takes over as for any other creature (its mana
# recovery included). Knobs, read live:
#   ;vars set reim_pain=off          no opener at all (default on)
#   ;vars set reim_curse=off         skip the 715 (default on)
#   ;vars set reim_pain_max=N        casts per rare (default 16)
#   ;vars set reim_pain_reserve=N    mana kept back for ultima's finish (default 21)
# A burst costs about 70 mana (the Curse, four Pains, four Disruptions), and ultima only tops the pool off
# below 45, so when a rare shows up and mana is under that plus the reserve this refills first, the way
# ultima does: the demon's stored mana (once per hunt, the same $demonmana_taken latch), `sacrifice mana`
# (1 shadow essence, if off cooldown), then Symbol of Mana. `;Fizzleworth-attack-reim refill` runs just that
# refill and exits (;fizzreim uses it before it decides it is out of mana).
#
# LOOT. Reim corpses only carry silver (about a third of the kills, 180-390 each; the Patrol Leader had
# 387) and "ethereal hands" pull a corpse away within seconds, so as soon as the room is clear after a
# fight this runs ;eloot once, the same call you made by hand after every kill. Neither treim nor
# ultima loots. `;vars set reim_loot=off` turns it off.
#
# THE SPHERE (`;Fizzleworth-attack-reim sphere`, started by ;fizzreim). Once every rare is dead and REIM INFO
# says "throne room", the Emperor and Empress are not waves: in the Vault Entry (25142, through the
# Throne Room's rhimar door) `touch sphere` summons both ("Two figures ripple into existence in front of
# you"), and you are driven to your knees (5 s roundtime). Scott killed the Emperor in 48 s on 11/24 and
# was then nearly killed by the berserk Empress (she stuns for 6 rounds, shakes the ground every 10 s so
# you fall over, throws boulders), so this mode kills the EMPRESS FIRST, with a Hex and then Pain (200 a
# hit), heals with REIM BOOST HEAL, and BAILS OUT when health drops under reim_sphere_bail (default 50%):
# stand and `go rhimar door` (the one exit; REIM CAMP is refused inside the castle). The result goes in
# $reim_sphere_result: :won, :door, :stuck, :dead, :nosphere, :nopair, :left. Knobs: reim_sphere_bail (50), reim_sphere_heal (70, % health for REIM BOOST HEAL).
#
# SAFETY. One launch never runs longer than MAX_SECONDS (treim starts a fresh one on the next
# wave), stops if you die or leave Reim, and backs off when ultima returns at once without
# casting anything (so it can never spin hot).

module FizzReimAttack
  ULTIMA      = "Fizzleworth-attack-ultima"
  MAX_SECONDS = 300   # longest one launch may run; the next spawn starts another
  GRACE       = 2.5   # seconds with an empty room before this launch is over (a pair's second mob walks in late)
  IN_REIM     = /Reim (?:Settlement|Castle)|Pitfall Trap/i
  IGNORE      = /animated|verlok|minor demon|raven/i

  def self.in_reim?
    XMLData.room_title.to_s =~ IN_REIM ? true : false
  end

  def self.hostiles
    GameObj.targets.select { |t| t && t.status.to_s !~ /dead|gone/ && t.name.to_s !~ IGNORE }
  rescue StandardError
    []
  end

  # treim's Treim::Bosses::BOSS_NOUNS: the nouns of the named rare spawns
  BOSS_NOUNS = %w[Cook Shopkeeper Innkeeper Bartender Leader Lord Lady Queen King Captain Sergeant
                  Hostler Master Torturer Butler Dignitary Prince Princess Jester Emperor Empress] unless defined?(BOSS_NOUNS)
  CAST_DONE  = /Cast Roundtime \d+|Roundtime: \d+ sec|can't think clearly enough to prepare|don't have a spell prepared|^Wait \d+ sec|You can't cast|You have no/i unless defined?(CAST_DONE)
  WOUNDED    = /can't think clearly enough to prepare/i unless defined?(WOUNDED)

  def self.boss?(t)
    t && t.noun.to_s =~ /\A(?:#{BOSS_NOUNS.join('|')})\z/ ? true : false
  end

  def self.uv_on?(name)
    v = UserVars.send(name)
    return true if v.nil?
    return v if v == true || v == false
    v.to_s !~ /\A\s*(?:0|false|off|no)\s*\z/i
  end

  def self.uv_int(name, default)
    v = UserVars.send(name)
    v.to_s =~ /\A\s*\d+\s*\z/ ? v.to_i : default
  end

  def self.spell_cost(num, default)
    c = Spell[num].mana_cost.to_i
    c.positive? ? c : default
  rescue StandardError
    default
  end

  def self.pain_cost;  spell_cost(711, 11); end
  def self.mdis_cost;  spell_cost(702, 2);  end
  def self.curse_cost; spell_cost(715, 15); end

  def self.cost_of(num)
    { 711 => pain_cost, 702 => mdis_cost, 715 => curse_cost }.fetch(num)
  end

  # what a typical burst on one rare takes: the Curse, then four Pains and four Mana Disruptions
  def self.burst_mana
    curse_cost + 4 * pain_cost + 4 * mdis_cost
  end

  # ultima's recover_mana, for the moment a rare turns up with too little in the pool for a Pain burst.
  # true if it did something that should have brought mana back.
  # REIM BOOST MANA: 50 mana for 250 quest energy. Success is judged by the mana that came back (the
  # replies haven't been seen); after a miss (no energy, say) it isn't tried again for five minutes.
  def self.boost_mana
    return false unless uv_on?(:reim_qboost)
    return false if Time.now.to_f < @boost_fail_until.to_f
    before = checkmana
    waitrt?
    waitcastrt?
    r = dothistimeout("reim boost mana", 4, /energy|restor|mana|boost|cannot|can't|not enough/i).to_s
    sleep 1
    gained = checkmana - before
    echo "reim boost mana: #{gained >= 15 ? "+#{gained}" : 'nothing'} (#{r.strip[0, 100]})"
    @boost_fail_until = Time.now.to_f + 300 if gained < 15
    gained >= 15
  end

  def self.refill_mana
    unless $demonmana_taken
      $demonmana_taken = true
      before = checkmana
      Script.run("demonmana", "get") if Script.exists?("demonmana")
      return true if checkmana > before
    end
    return true if boost_mana
    essence  = (Resources.shadow_essence.to_i rescue 0)
    cooldown = (Effects::Cooldowns.to_h.keys.any? { |k| k.to_s =~ /sacrifice\s*\(\s*mana\s*\)/i } rescue false)
    if essence.positive? && !cooldown
      waitrt?
      waitcastrt?
      r = dothistimeout("sacrifice mana", 4, /mana surge into you|overwhelm you with shadow essence|don't have (?:enough|any)/i)
      waitrt?
      return true if r.to_s =~ /mana surge into you|overwhelm you with shadow essence/i
    end
    if !(Effects::Cooldowns.active?("Symbol of Mana") rescue true) && (Experience.deeds.to_i rescue 0) > 3
      fput "symbol of mana"
      waitrt?
      return true
    end
    false
  end

  # Curse (715) picks its curse from the caster's STANCE (gswiki Curse_(715)): guarded = Hex (brackish blue
  # thread, "looks very vulnerable", -24/25 TD, no warding check); defensive = Pox (sickly green, "looks
  # extremely ill", health loss only). Ultima casts from defensive, and the first Reim Curse (11/24, the
  # Bartender) was a Pox that left TD at +307. So the stance is set to guarded first; ultima's next pass
  # puts it back to defensive on its own.
  def self.go_guarded
    return if checkstance == "guarded"
    waitrt?
    fput "stance guarded"
    20.times do
      break if checkstance == "guarded"
      sleep 0.1
    end
  end

  def self.alive?(t)
    t && GameObj.targets.any? { |x| x.id.to_i == t.id.to_i && x.status.to_s !~ /dead|gone/ }
  end

  # Cast `cmd` and read every line through the cast's own terminal line.
  def self.cast_collect(cmd, timeout = 6, done = CAST_DONE)
    lines = []
    nil while get?
    put cmd
    deadline = Time.now.to_f + timeout
    loop do
      line = get?
      if line.nil?
        sleep 0.1
      else
        lines << line
        break if line =~ done
      end
      break if Time.now.to_f >= deadline
    end
    lines.join("\n")
  end

  # Curse once, then Pain and Mana Disruption in turns, at the rare until it is dead, the per-creature cap
  # is reached or the mana floor is hit. @boss[id] counts the casts at each rare within one launch (run
  # resets it: ids are only good for a login).
  def self.boss_burst(boss)
    @boss ||= {}
    id      = boss.id.to_i
    st      = (@boss[id] ||= { casts: 0, cursed: false, turn: 0 })
    cap     = uv_int(:reim_pain_max, 16)
    reserve = uv_int(:reim_pain_reserve, 21)
    while alive?(boss) && st[:casts] < cap
      break unless in_reim?
      break if checkdead || $bigshot_flee

      if !st[:cursed] && uv_on?(:reim_curse)
        st[:cursed] = true                      # one try, whatever happens
        next if checkmana < curse_cost + reserve
        spell = 715
      else
        order = st[:turn].even? ? [711, 702] : [702, 711]
        spell = order.find { |n| checkmana >= cost_of(n) + reserve }
        if spell.nil?
          st[:casts] = cap                      # not even a Mana Disruption: ultima takes over (and recovers mana)
          break
        end
        st[:turn] += 1
      end

      waitrt?
      waitcastrt?
      go_guarded if spell == 715
      fput "target ##{id}" unless XMLData.current_target_id.to_i == id
      text = cast_collect("incant #{spell}")
      st[:casts] += 1
      if spell == 715
        echo(text =~ /very vulnerable/i ? "Curse: Hex landed on #{boss.name.to_s.sub(/\A(?:an?|the) /i, '')} (-24 TD)." :
                                           "Curse: not the Hex (#{text[/looks [a-z ]+|loses [a-z ]+|stumbles|shakes/i] || 'no curse message'}); stance was #{checkstance}.")
      end
      if text =~ WOUNDED
        Script.run("eherbs", "--spellcast")
        st[:casts] = cap
        break
      end
      break if text =~ /You have no|You can't cast|don't have a spell prepared/i
      waitcastrt?
      waitrt?
    end
  end

  # --- the Emperor and the Empress ------------------------------------------------------------------------------

  SPHERE_MAX  = 420
  SPHERE_DONE = Regexp.union(CAST_DONE, /still stunned|You must be standing/i)
  VAULT_ENTRY = 25142

  def self.hp_pct;  (Char.percent_health.to_i rescue 100); end
  def self.in_vault?; (Room.current&.id).to_i == VAULT_ENTRY; end

  def self.sphere_pair
    hostiles.select { |t| t.noun.to_s =~ /\A(?:Emperor|Empress)\z/ || t.name.to_s =~ /Emperor|Empress/ }
  end

  # the Empress first (she is the one that stuns and knocks you down), then the Emperor, then whatever else
  def self.sphere_target
    list = hostiles
    list.find { |t| t.noun.to_s == "Empress" || t.name.to_s =~ /Empress/ } ||
      list.find { |t| t.noun.to_s == "Emperor" || t.name.to_s =~ /Emperor/ } || list.first
  end

  # true if the sphere answered with the pair
  def self.touch_sphere
    r = dothistimeout("touch sphere", 6, /Two figures ripple|You dare seek|What were you referring to|You can't|cannot/i).to_s
    echo "touch sphere: #{r.strip[0, 100]}"
    r =~ /Two figures ripple|You dare seek/i ? true : false
  end

  # REIM BOOST HEAL (50 health for 250 quest energy). 11/24: his `reim boost heal` at 70% health was followed
  # by full health and "You feel rejuvinated." One miss (no energy, refused) and it is not tried again in this fight.
  def self.sphere_heal
    return false if @sphere_no_heal || !uv_on?(:reim_qboost)
    return false if hp_pct >= uv_int(:reim_sphere_heal, 70)
    return false if Time.now.to_f < @sphere_heal_at.to_f + 4
    @sphere_heal_at = Time.now.to_f
    before = checkhealth.to_i
    waitrt?
    waitcastrt?
    r = dothistimeout("reim boost heal", 4, /rejuvinat|rejuvenat|energy|cannot|can't|not enough|wait \d+/i).to_s
    sleep 1
    gained = checkhealth.to_i - before
    echo "REIM BOOST HEAL: #{gained >= 15 ? "+#{gained}" : 'nothing'} (#{r.strip[0, 80]})"
    @sphere_no_heal = true if gained < 15 && r !~ /wait \d+/i
    true
  end

  # Out of the Vault Entry: `go rhimar door` when standing, STAND first when down (the Empress shakes the ground
  # every 10 s). REIM CAMP is NOT an option: inside the castle the game answers "You cannot transport to the Reim
  # Base Camp from here." (11/24 19:09, from the Throne Room and from this very room). Returns :door, :stuck or :dead.
  def self.bail_out(why)
    echo "BAIL OUT (#{why}): health #{hp_pct}%, mana #{checkmana}. Leaving by the rhimar door."
    started = Time.now.to_f
    loop do
      return :dead if checkdead
      return :door unless in_vault?
      return :stuck if Time.now.to_f - started > 60
      if checkstunned
        sleep 0.3
        next
      end
      waitrt?
      if checkstanding
        dothistimeout("go rhimar door", 5, /You step through|You must be standing|still stunned|can't go|cannot|Roundtime/i)
        sleep 0.3
      else
        dothistimeout("stand", 5, /You stand|already|still stunned|Roundtime/i)
      end
    end
  end

  def self.sphere_result(r)
    $reim_sphere_result = r
    echo "sphere: #{r}."
    r
  end

  def self.sphere_bail(why)
    sphere_result(bail_out(why))
  end

  # The fight. Empress first: Curse once (as the Hex, if the mana allows), then Pain until she is dead; then the
  # Emperor the same way. Bails out under reim_sphere_bail % health, when it can't cast (head wounds) or can't
  # find the mana for another Pain, or after SPHERE_MAX seconds.
  def self.sphere
    $reim_sphere_result = nil
    @camp_refused = false
    @sphere_no_heal = false
    @sphere_heal_at = 0.0
    @sphere_cursed  = {}
    @sphere_refill  = 0.0
    bail    = uv_int(:reim_sphere_bail, 50)
    started = Time.now.to_f
    seen    = {}
    looted  = {}

    unless sphere_pair.any?
      return sphere_result(:nosphere) unless in_vault? && touch_sphere
      waited = Time.now.to_f
      sleep 0.3 until sphere_pair.any? || Time.now.to_f - waited > 8
    end
    return sphere_result(:nopair) if sphere_pair.empty?
    echo "the Emperor and Empress are here: Empress first, bailing out under #{bail}% health."

    loop do
      return sphere_result(:left) unless in_reim?
      return sphere_result(:dead) if checkdead
      return sphere_bail("health #{hp_pct}% is under #{bail}%") if hp_pct < bail
      return sphere_bail("#{SPHERE_MAX} s and not finished") if Time.now.to_f - started > SPHERE_MAX
      sphere_pair.each { |t| seen[t.id.to_i] = t.name }
      seen.each_key do |id|
        next if looted[id] || GameObj.targets.any? { |x| x.id.to_i == id && x.status.to_s !~ /dead|gone/ }
        looted[id] = true
        loot if hp_pct >= 75 && !hostiles.empty?     # the corpse is pulled away within seconds
      end
      break if hostiles.empty? || (sphere_pair.empty? && !seen.empty?)
      if checkstunned
        sleep 0.3
        next
      end
      next if sphere_heal
      tgt = sphere_target
      next if tgt.nil?

      spell = 711
      if uv_on?(:reim_curse) && !@sphere_cursed[tgt.id.to_i] && tgt.noun.to_s =~ /Emperor|Empress/ &&
         checkmana >= curse_cost + 3 * pain_cost + uv_int(:reim_pain_reserve, 21)
        spell = 715
        @sphere_cursed[tgt.id.to_i] = true
      end
      if checkmana < cost_of(spell)
        if Time.now.to_f - @sphere_refill > 15
          @sphere_refill = Time.now.to_f
          refill_mana
        end
        return sphere_bail("out of mana (#{checkmana})") if checkmana < pain_cost
        next
      end

      waitrt?
      waitcastrt?
      go_guarded if spell == 715
      fput "target ##{tgt.id}" unless XMLData.current_target_id.to_i == tgt.id.to_i
      text = cast_collect("incant #{spell}", 6, SPHERE_DONE)
      if spell == 715
        echo(text =~ /very vulnerable/i ? "Curse: Hex landed on #{tgt.name.to_s.sub(/\A(?:an?|the) /i, '')} (-24 TD)." : "Curse: not the Hex (stance was #{checkstance}).")
        fput "stance defensive"
      end
      return sphere_bail("can't think clearly enough to cast") if text =~ WOUNDED
      sleep 0.5 if text =~ /still stunned/i
    end

    loot if hp_pct >= 60
    sphere_result(:won)
  end

  # ;eloot the corpses the fight left (it searches them and gathers the silver)
  def self.loot
    return unless uv_on?(:reim_loot)
    return unless Script.exists?("eloot")
    return if Script.running?("eloot")
    Script.run("eloot")
  rescue StandardError => e
    echo "loot: #{e.class} #{e.message}"
  end

  def self.run
    @boss      = {}
    @refilled  = {}
    fought     = false
    started    = Time.now.to_f
    empty_at   = nil
    quick      = 0
    loop do
      break unless in_reim?
      break if checkdead
      break if $bigshot_flee
      now = Time.now.to_f
      break if now - started > MAX_SECONDS

      if hostiles.empty?
        if fought
          fought = false
          loot unless checkdead
        end
        empty_at ||= now
        break if now - empty_at > GRACE
        sleep 0.4
        next
      end
      empty_at = nil

      fought = true
      if uv_on?(:reim_pain) && (boss = hostiles.find { |t| boss?(t) })
        @boss ||= {}
        @refilled ||= {}
        if checkmana < burst_mana + uv_int(:reim_pain_reserve, 21) && !@refilled[boss.id.to_i]
          @refilled[boss.id.to_i] = true       # one try per rare
          refill_mana
        end
        st = (@boss[boss.id.to_i] ||= { casts: 0, cursed: false, turn: 0 })
        if st[:casts] < uv_int(:reim_pain_max, 16) && checkmana >= mdis_cost + uv_int(:reim_pain_reserve, 21)
          boss_burst(boss)
          next
        end
      end

      t0 = Time.now.to_f
      Script.run(ULTIMA)
      took = Time.now.to_f - t0
      # ultima exits at once when it has nothing it will do (no target it likes, out of mana
      # with the back-off already spent): don't hammer it
      quick = took < 1.0 ? quick + 1 : 0
      sleep(quick >= 3 ? 3 : 0.4)
    end
  end
end

# `;Fizzleworth-attack-reim refill`: just the mana refill, then exit (fizzreim calls this when mana is low)
case Script.current.vars[1].to_s.downcase
when "refill" then FizzReimAttack.refill_mana
when "sphere" then FizzReimAttack.sphere
else FizzReimAttack.run
end
