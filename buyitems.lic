#buyitems.lic

# Withdraws 10,000 silver from the bank, then buys rub-items from the
# pawnshop's arcana/magic table: quartz orb, crystal amulet, black crystal,
# white crystal, small statue, moonstone cube. Each item is stowed right
# after it's bought. Deposits whatever silver is left back at the bank
# before returning to town.
#
# ARCANA_TABLE_CMD/TABLE_NAME below are set for River's Rest (north, arcana
# table). Adjust them for other towns' pawnshops as needed.

module Buyitems

ARCANA_TABLE_CMD = "north"
TABLE_NAME = "arcana table"

ITEMS = [
	"quartz orb",
	"crystal amulet",
	"black crystal",
	"white crystal",
	"small statue",
	"moonstone cube"
]

# "look on <table>" replies across multiple lines, e.g.:
#   On the magic table:
#   Special [20]: a crumpled scroll, a heavy quartz orb, ..., a white crystal
#   Total items: 20
# so read until the "Total items:" line (or a "nothing here" reply) instead
# of returning after just the first line.
def self.table_contents
	fput "look on #{TABLE_NAME}"
	lines = []
	end_time = Time.now.to_f + 5
	loop do
		line = get?
		if line.nil?
			break if Time.now.to_f > end_time
			sleep 0.1
			next
		end
		lines << line
		break if line =~ /^Total items:/i || line =~ /don't see|nothing (here|on)/i
	end
	lines.join(' ')
end

BUY_SUCCESS = /You decide to purchase/
BUY_HANDS_FULL = /hands are full/
BUY_FAILURE = /#{BUY_HANDS_FULL}|don't have enough|don't see|can't afford/

def self.order_and_buy(item_name)
	buy_result = dothistimeout "buy #{item_name}", 5, /#{BUY_SUCCESS}|#{BUY_FAILURE}/
	if buy_result =~ BUY_HANDS_FULL
		fput "stow left"
		buy_result = dothistimeout "buy #{item_name}", 5, /#{BUY_SUCCESS}|#{BUY_FAILURE}/
	end
	if buy_result =~ BUY_SUCCESS
		fput "stow my #{item_name}"
	else
		echo "Failed to buy '#{item_name}': #{buy_result}"
	end
end

if Char.percent_encumbrance > 0
	echo "You're already #{Char.encumbrance} encumbrance (#{Char.percent_encumbrance}%) -- stow or drop something before running this."
	exit
end

Script.run("go2", "bank")
have_money = dothistimeout "withdraw 10000 silver", 5, /10,000 silvers/
if !have_money
	echo "Couldn't withdraw 10,000 silver from the bank -- stopping."
	exit
end

Script.run("go2", "pawnshop")
fput ARCANA_TABLE_CMD

contents = table_contents || ""
ITEMS.each do |item|
	if contents =~ /#{item}/i
		order_and_buy(item)
	else
		echo "'#{item}' isn't on the #{TABLE_NAME}, skipping."
	end
end

Script.run("go2", "bank")
fput "deposit all"

Script.run("go2", "town")

end #End of module
