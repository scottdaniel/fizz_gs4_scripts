=begin
      author: Fizzleworth
        name: mdemon_refresh
        game: gemstone
        tags: sorcerer, demon, minor summoning
    requires: Lich > 5.14.2
     version: 0.3
        note: Written with assistance from Claude (Anthropic).

  Keeps a Sorcerer's Minor Summoning (725) demon refreshed.

  Watches the Minor Summoning spell duration. When it drops below the configured
  buffer, it stows whatever's in your left hand (if anything), rummages a vakra
  runestone out of your kit, rubs it to refresh the demon, puts the runestone
  away, then gets your original left-hand item back.

  If no vakra runestone is found in your kit, the script needs fizzfuse to make a
  new one -- which will pull you away from the hunt (bank + alchemist trip). How
  that's handled is controlled by AUTO_FUSE_RUNESTONE below:
    true  - automatically runs fizzfuse to fuse a new vakra runestone, but with
            FUSE_ONLY_WHEN_RESTING_IN_TOWN (default) only once you're sitting in
            town with nothing hostile around; until then it just waits. bigshot
            is paused while fizzfuse walks.
    false - pauses and waits for you to type "nod" before fusing, so it never
            interrupts a hunt without your say-so.

  Usage:  ;mdemon_refresh
  Stop:   ;kill mdemon_refresh

  Also, once per rest (sitting, mana >= SEND_MANA_AT, nothing hostile around), it
  sends the demon the mana it can hold (;demonmana send); attack-ultima / sac4mana
  ask for it back with ;demonmana get the first time mana runs low in a hunt.

  If it's still "on its way" after STUCK_WARN_MINUTES (11/05: a grantris stranded after a stop at Kilron's
  pawnshop never came back), it says so once and suggests ;summond to replace it.

  Calls the demon back (11/04, after it was left behind once more -- in the Rift's swim
  home): while Minor Summoning is up and the demon isn't in the room, it sends a silent
  `tell mdemon return` every CALL_GAP_SECONDS. The reply names the demon, so the script
  learns its id and stops asking while it is standing there. "The magic in your location
  is interfering with your <demon> returning to you" slows the asking to every
  CALL_BLOCKED_GAP_SECONDS. A real order is echoed once ("ordered it back"); the silent
  "already here" replies are not.
=end

module MdemonRefresh
  # === config (edit to taste) ===================================================
  MINOR_SUMMONING_SPELL   = "Minor Summoning"
  REFRESH_THRESHOLD_MINUTES = 10
  CHECK_INTERVAL_SECONDS  = 15
  SEND_MANA_AT            = 40   # resting with at least this much mana -> fill the demon (;demonmana)
  CALL_GAP_SECONDS         = 15  # demon missing from the room: order it back this often
  CALL_BLOCKED_GAP_SECONDS = 90  # ...but this rarely where the game says the magic interferes
  STUCK_WARN_MINUTES       = 10  # still "on its way" after this long: say once that it may be lost
  RETURN_REPLY = /already here!|acknowledges your order|interfering with your|You have no minor demon at this time/i
  DEMON_LINK   = %r{(?:[Bb]ut your|Your|your) <pushBold/><a exist="(\d+)" noun="([\w,'-]+)">([\w\-' ]+)</a><popBold/>}
  # No vakra runestone left: true = fuse a new one with fizzfuse (a bank + alchemist trip,
  # then it walks back). With FUSE_ONLY_WHEN_RESTING_IN_TOWN it never starts that
  # mid-hunt -- it waits until you're resting in town. false = ask you to NOD first.
  AUTO_FUSE_RUNESTONE     = true
  FUSE_ONLY_WHEN_RESTING_IN_TOWN = true

  # === helpers ===================================================================
  def self.rummage_and_rub
    held_item_id = checkleft ? GameObj.left_hand.id : nil

    if held_item_id
      fput "stow left"
      waitrt?
    end

    result = Lich::Util.issue_command(
      "rumm in my kit for runestone vakra",
      /drawn on it|can't seem to locate/,
      include_end: false, quiet: true, silent: true
    ).last.to_s

    return :missing if result =~ /can't seem to locate/

    waitrt?
    fput "rub my runestone"
    waitrt?
    fput "put runestone in my kit"
    :ok
  ensure
    if held_item_id
      fput "get ##{held_item_id}"
      waitrt?
    end
  end

  def self.demon_here?
    return false unless @demon_id
    Array(GameObj.npcs).any? { |n| n && n.id.to_s == @demon_id.to_s }
  end

  # `tell mdemon return` when the demon isn't in the room (see the header). The first call
  # also learns the demon's id from the reply, whatever illusion it is wearing.
  def self.call_demon_back
    return unless Effects::Spells.active?(MINOR_SUMMONING_SPELL)
    return if checkdead || checkstunned
    now = Time.now.to_f
    return if now - @last_call.to_f < (@call_blocked ? CALL_BLOCKED_GAP_SECONDS : CALL_GAP_SECONDS)
    if demon_here?
      @away_since = nil
      return
    end
    @last_call = now
    text = Lich::Util.quiet_command_xml("tell mdemon return", RETURN_REPLY).to_a.join("\n")
    @demon_id = Regexp.last_match(1) if text =~ DEMON_LINK
    @call_blocked = text =~ /interfering with your/i ? true : false
    if text =~ /acknowledges your order/i
      echo "Demon wasn't here -- ordered it back."
      @away_since ||= now
      warn_if_stuck(now, text)
    elsif text =~ /already here!|You have no minor demon/i
      @away_since = nil
    end
  rescue StandardError => e
    echo "call_demon_back: #{e.class} #{e.message}"
  end

  # 11/04-05: a grantris stranded after stops at Kilron's pawnshop (a verlok passed the same stop fine) "began to travel" to every order for half
  # an hour of logged-in time and never arrived. Say so once per absence (time counts only while
  # this script runs, so mostly logged in).
  def self.warn_if_stuck(now, text)
    if now - @away_since < STUCK_WARN_MINUTES * 60
      @stuck_warned = false
      return
    end
    return if @stuck_warned
    @stuck_warned = true
    name = text =~ DEMON_LINK ? Regexp.last_match(3) : "demon"
    type = name.split.last.to_s.split("'").first.to_s.downcase
    # an igaesha's noun is "smoke", "fog", ...; a disguised demon's is "weasel", "gnoll", ...
    type = "<type>" unless %w[grik imp abyran grantris igaesha verlok aishan shien arashan].include?(type)
    _respond "<pushBold/>[mdemon_refresh] Your #{name} has been on its way for #{STUCK_WARN_MINUTES}+ minutes and hasn't arrived; it may be stuck. ;summond #{type} offers to send it back and summon a new one.<popBold/>"
  end

  # Once per rest, as soon as there's mana to spare (the send costs ~30 and the rest
  # regens it, so the demon's store is free; sending at the end of a rest isn't).
  def self.store_mana_while_resting
    unless checksitting
      @mana_stored = false
      return
    end
    return if @mana_stored || Char.mana < SEND_MANA_AT
    return unless Effects::Spells.active?(MINOR_SUMMONING_SPELL)
    return if GameObj.targets.any? { |t| t && t.status.to_s !~ /dead|gone/ }
    @mana_stored = true
    Script.run("demonmana", "send")
  end

  # No built-in "in town": compare this room's location with the one bigshot rests in
  # (UserVars.op["resting_room_id"]); false when it isn't configured.
  def self.in_town?
    id = (UserVars.op.is_a?(Hash) ? UserVars.op["resting_room_id"].to_s.strip : "")
    return false if id.empty?
    resting = Room.list[id.to_i]
    !!(resting && Room.current.location == resting.location)
  rescue StandardError
    false
  end

  def self.safe_to_fuse?
    return true unless FUSE_ONLY_WHEN_RESTING_IN_TOWN
    in_town? && checksitting && GameObj.targets.none? { |t| t && t.status.to_s !~ /dead|gone/ }
  end

  # fizzfuse walks around town; bigshot's rest loop shouldn't also decide to walk.
  def self.with_bigshot_paused
    paused = Script.running?("bigshot") && !Script.paused?("bigshot") && Script.pause("bigshot")
    yield
  ensure
    Script.unpause("bigshot") if paused
  end

  def self.wait_for_nod
    echo "Type 'nod' when you're ready to let fizzfuse fuse a new vakra runestone."
    loop do
      line = get
      break if line =~ /^You nod/i
    end
  end

  def self.attempt_refresh
    status = rummage_and_rub
    return :ok if status == :ok

    if AUTO_FUSE_RUNESTONE
      return :wait unless safe_to_fuse?
      echo "No vakra runestone in kit -- fusing a new one (resting in town)."
    else
      echo "No vakra runestone in kit -- fusing one via fizzfuse will pull you away from the hunt."
      wait_for_nod
    end

    with_bigshot_paused { Script.run("fizzfuse", "rune vakra") }
    rummage_and_rub
  end

  # === main ======================================================================
  def self.run
    # module state survives between runs (Lich re-opens the module)
    @away_since = nil
    @stuck_warned = false
    echo "MdemonRefresh started! Watching Minor Summoning (refresh buffer: #{REFRESH_THRESHOLD_MINUTES} min)."
    echo "Auto-fuse runestone: #{AUTO_FUSE_RUNESTONE}"
    echo "Stop with ;kill mdemon_refresh"

    loop do
      if Effects::Spells.active?(MINOR_SUMMONING_SPELL)
        remaining = Effects::Spells.time_left(MINOR_SUMMONING_SPELL)
        @waiting = false if remaining >= REFRESH_THRESHOLD_MINUTES

        # waiting for town: don't rummage the kit every 15s mid-hunt, just look again
        # once it's safe to fuse
        if remaining < REFRESH_THRESHOLD_MINUTES && (!@waiting || safe_to_fuse?)
          echo "Minor Summoning has #{remaining.round(1)} minutes left, refreshing demon."
          result = attempt_refresh
          was_waiting = @waiting
          @waiting = (result == :wait)

          if result == :ok
            echo "Demon refreshed."
          elsif result == :wait
            echo "No vakra runestone -- will fuse one when you're resting in town." unless was_waiting
          else
            echo "Could not refresh demon -- still no vakra runestone available."
          end
        end
      else
        @waiting = false
      end

      store_mana_while_resting
      call_demon_back
      sleep CHECK_INTERVAL_SECONDS
    end
  end
end

MdemonRefresh.run
