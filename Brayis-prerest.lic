#Brayis-prerest.lic
#Warrior version of Salvi-prerest.lic (Brayis) -- no wands, so this skips the
#fresh-wand sweep those casters need; the rest of the resting chores are
#profession-agnostic.

module BrayisPrerest

# First, get off any unmapped room (go2 "current room not found"): see unlost.lic.
# Stops here -- bigshot is stopped too -- if it can't walk out.
Script.run("unlost")
exit if $unlost_failed

Script.run("eherbs")
Script.run("eloot", "sell")
#Script.run("undead_bounty", "kill greater ghoul")
Script.run("buyitems")
#Script.run("timequit")

end #End of module
