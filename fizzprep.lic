#fizzprep.lic

module Fizzprep

# rub stuff
fput "put my #{GameObj.right_hand} in my cloak"
fput "stow all"

# rub stuff, but only if the spell isn't already active
Script.run("qverb", "rub gold coin") unless Spell[1701].active?
pause 3
Script.run("qverb", "rub small statue") unless Spell[1712].active?
pause 3
Script.run("qverb", "rub moonstone cube") unless Spell[1705].active?
pause 3
Script.run("qverb", "rub white crystal") unless Spell[509].active?
pause 3
Script.run("qverb", "rub black crystal") unless GameObj.loot.find { |i| i.name =~ /#{Char.name} disk/ }
pause 3

# cast protective spells from scrolls
Script.run("scrollbuff3", "202 211 215 219 303 307 310 313 314 319 503 507 509 508 601 606 613 618 905 913 1119 1215 1204 1605 1601 1701 1705 1208 207 1616 911")
fput "ready weapon"

# check if runestaff is ensorcelled, if not, prep and evoke
res = dothistimeout "l at my #{GameObj.right_hand}", 2, Regexp.union(
      /An ethereal necrotic film covers the/
    )
if res !~ /An ethereal necrotic film covers the/
    fput "prep 735"
    fput "evoke #{GameObj.right_hand}"
    end

end #End of module
