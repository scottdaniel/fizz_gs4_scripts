boosted_longterm = false
no_longterm_boosts = false

# Once you're out of Long-Term Experience Boosts, switch to instant "boost absorb"
# instead. Same "must rest" trigger, but only once there's at least 1000
# experience in your mind for it to absorb.
UserVars.tdusk[:boost_absorb] = false if UserVars.tdusk[:boost_absorb].nil?
BOOST_ABSORB_MIN_FXP = 1000 unless defined?(BOOST_ABSORB_MIN_FXP)

# Casts spell_num if affordable, otherwise prays to build resources back up.
# Returns true if it cast, false if it prayed instead.
def cast_or_pray(spell_num, npc)
  if Spell[spell_num].affordable?
    Spell[spell_num].force_incant if npc.status !~ /dead|gone/
    true
  else
    fput "pray"
    false
  end
end

while GameObj.targets.any? {|npc| npc.status !~ /dead|gone/ && npc.name !~ /animated/ }
  GameObj.targets
         .reject {|foe| foe.status =~ /dead|gone/ }
         .sample
         .tap { |npc|

    put "target ##{npc.id}"
    fput "release" if checkprep != "None"
    if ( checkmana <= 20 ) && ( UserVars.tdusk[:praycurrent] < 3 )
      fput "pray mana"
      UserVars.tdusk[:praycurrent] += 1
    elsif ( checkmana <= 20 ) && (Experience.deeds > 3)
      waitrt?
      waitcastrt?
      fput "symbol of mana"
    end

    if npc.name =~ /champion/ && Room.current.id == 24550
      waitrt?
      waitcastrt?
      unless cast_or_pray(715, npc)
        waitrt?
        waitcastrt?
        echo "Fizzleworth-duskattack: couldn't afford 715 on #{npc.name}" unless cast_or_pray(715, npc)
      end
    end

    #start main attack routine here
    loop do
      break if Room.current.id != 24550
      break if npc.status =~ /dead|gone/

      if checkmind("must rest") && !no_longterm_boosts
        if UserVars.tdusk[:boost_absorb]
          if !boosted_longterm && Experience.fxp_current >= BOOST_ABSORB_MIN_FXP
            # dothistimeout returns nil after 3s if nothing matches (i.e. the
            # boost succeeded with no error), so no separate success pattern
            # is needed here.
            result = dothistimeout "boost absorb", 3, /You do not have any .*? Boosts to redeem\./
            no_longterm_boosts = true unless result.nil?
            boosted_longterm = true
          end
        elsif !boosted_longterm
          result = dothistimeout "boost longterm", 3, /You do not have any .*? Boosts to redeem\./
          no_longterm_boosts = true unless result.nil?
          boosted_longterm = true
        end
      else
        boosted_longterm = false
      end

      waitrt? if npc.status !~ /dead|gone/
      waitcastrt? if npc.status !~ /dead|gone/
      if checkrt == 0 && checkcastrt == 0 && npc.status !~ /dead|gone/
        if npc.name =~ /automaton/
          cast_or_pray(711, npc)
        elsif npc.status !~ /dead|gone/
          cast_or_pray(702, npc)
          cast_or_pray(705, npc)
        end
      end
      sleep 0.1
    end
    #end main attack routine here
  }
end
Script.start("foreach", "in room; look item") if UserVars.tdusk[:wave_number] != 25
Script.start("foreach", "in room; get item; stow item") if UserVars.tdusk[:wave_number] == 25