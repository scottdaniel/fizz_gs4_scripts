# tackle-bot.lic
# Standalone "dumb" combat loop for Brayis when he's just along for the ride
# in someone else's group -- their bigshot runs the actual hunt (moving,
# looting, retargeting, finishing kills); this just watches the room for
# anything alive and tackles it, with the exact same stamina gate as
# Brayis-attack.lic so he never exhausts himself. It ONLY tackles -- it never
# falls back to a plain attack (that's the whole point: Brayis is a
# free-floating knockdown source here, not the one finishing kills). Not a
# bigshot hunting-command script -- start and stop it by hand around the
# group hunt:
#
#   ;tackle-bot
#   (kill it from the script list, or ;e Script.kill('tackle-bot'), when done)
#
# Loop, forever:
#   1. Pick any non-dead/gone, non-prone NPC in the room (GameObj.npcs --
#      whatever the group is fighting, not a target list Brayis himself has
#      any reason to have built; npc_prone? below is bigshot.lic's own
#      prone-detection logic). Deliberately excludes already-prone targets
#      up front -- see the 2026-09-12 fix note below for why.
#   2. Nothing tacklable there -> sleep and keep watching.
#   3. Otherwise target it if needed, then: stamina >= TACKLE_STAMINA_COST ->
#      stance offensive, cman tackle, stance defensive. Not enough stamina ->
#      just wait for it to regenerate.
#
# FIX 2026-09-12 (spam again): v1 picked ANY non-dead/gone NPC, including
# ones already knocked prone, and only found out via GS4's refusal ("A pale
# crab is lying down -- attempting to tackle it would be a rather awkward
# proposition."). That refusal costs no stamina and no roundtime, so with
# nothing else in this script to throttle it, it just re-issued stance
# offensive -> cman tackle -> stance defensive in a tight loop for as long as
# the crab stayed down -- confirmed live, visible as a wall of that refusal
# message. Checked ;bigshot itself (npc_prone?/npc_has_status?, further down
# in bigshot.lic) for how it avoids this: it reads the live <crtrStatus> feed
# via Creature[id].has_status? rather than guessing from GameObj#status text
# (a creature holding multiple statuses -- e.g. prone + stunned -- only ever
# advertises ONE of them there), falling back to a status-string regex only
# for a target with no CreatureInstance registered yet. Copied that same
# npc_prone? logic here so a prone target is never even attempted.
#
# The tackle helpers below are copy-pasted from Brayis-attack.lic rather than
# shared, matching how Picko-attack.lic / Salvi-attack.lic duplicate their own
# near-identical helpers instead of pulling in a shared library -- keep both
# files in sync by hand if the tackle logic changes.
#
# Auto-pauses (skips acting, keeps watching) while standing in the same town
# as Brayis's own bigshot resting_room_id (room 228, Wehnimer's Landing Town
# Square Central, per data/GSIV/Brayis/bigshot_profiles/*.yaml) -- see
# in_town? below. This is a soft pause, not a literal Lich Script#pause: it
# resumes acting on its own the moment you leave town, no manual unpause
# needed, which matters since this script isn't meant to be babysat.

# --- knobs -------------------------------------------------------------------

TACKLE_STAMINA_COST = 7 unless defined?(TACKLE_STAMINA_COST)

# --- patterns ----------------------------------------------------------------

# GS4's outright refusal when the target is already down -- no stamina spent,
# no roundtime, so it's cheap to just let this cut the read short instead of
# burning the whole 5-second window every time it happens. Kept only as a
# rare-case safety net now that npc_prone? filters prone targets out up
# front (see below) -- e.g. a target that goes prone in the gap between
# picking it and actually sending the tackle.
ALREADY_DOWN_MSG = /is lying down.*awkward proposition/i unless defined?(ALREADY_DOWN_MSG)

# bigshot.lic's own PRONE regex (its PRONE/PRONE_STATUSES constants) -- the
# GameObj#status fallback for a target with no live CreatureInstance yet.
PRONE_REGEX = /sleeping|webbed|stunned|kneeling|sitting|^lying|prone|frozen|held in place|entangled/ unless defined?(PRONE_REGEX)

# The native <crtrStatus> statuses covering everything PRONE_REGEX matches --
# same list bigshot.lic's PRONE_STATUSES uses.
PRONE_STATUSES = %w[sleeping webbed stunned kneeling sitting prone immobilized].freeze unless defined?(PRONE_STATUSES)

# --- helpers -----------------------------------------------------------------

# True while standing in the same town as this character's configured bigshot
# resting_room_id (UserVars.op, persisted once bigshot.lic has been set up for
# this character -- see the bigshot_profiles/*.yaml files). Read dynamically
# instead of hardcoding a town name so this keeps working if that ever
# changes. Falls back to "not in town" (never pauses) if no resting room is
# configured or its room id isn't in the local map data, rather than guessing.
def in_town?
  resting_room_id = (defined?(UserVars) && UserVars.op.is_a?(Hash)) ? UserVars.op["resting_room_id"].to_s.strip : ""
  return false if resting_room_id.empty?
  resting_room = Room.list[resting_room_id.to_i]
  return false unless resting_room
  Room.current.location == resting_room.location
end

# True if the creature is already down (prone/stunned/sleeping/etc) -- same
# logic as bigshot.lic's npc_prone?/npc_has_status?: prefer the live
# <crtrStatus> feed via Creature[id].has_status?, since a creature holding
# several statuses at once only ever advertises ONE of them through
# GameObj#status (e.g. prone + stunned prints just "stunned" -- bigshot.lic
# measured this against ~1000 real creature observations). Falls back to the
# status-string regex only when there's no CreatureInstance registered yet
# for this id.
def npc_prone?(foe)
  return false if foe.nil?
  creature = defined?(Creature) ? Creature[foe.id] : nil
  return PRONE_STATUSES.any? { |s| creature.has_status?(s) } if creature
  !!(foe.status.to_s =~ PRONE_REGEX)
end

# Dead/gone check off GameObj.npcs directly -- there's no bigshot-maintained
# target list to lean on here, since Brayis isn't the one driving the hunt.
def target_dead?(foe)
  return true if foe.nil?
  return true if foe.status.to_s =~ /dead|gone/
  !GameObj.npcs.any? { |t| t.id.to_i == foe.id.to_i && t.status.to_s !~ /dead|gone/ }
end

# Sends cmd and collects every line, giving the read a short quiet period
# after the roundtime line shows up rather than stopping the instant it does
# -- Brayis-attack.lic hit a real bug from breaking immediately on that line
# (it can land in a script's downstream queue before trailing descriptive
# text does, even though that text prints first in the visible client
# window), copied the fix here too to keep both files in sync even though
# this script doesn't currently inspect the returned text for anything.
# ALREADY_DOWN_MSG still breaks immediately since that refusal is confirmed
# to never have anything trailing it.
def action_and_collect(cmd)
  text_lines = []
  put cmd
  end_time = Time.now.to_f + 5
  rt_seen_at = nil
  loop do
    line = get?
    if line.nil?
      sleep 0.05
    else
      text_lines << line
      break if line =~ ALREADY_DOWN_MSG
      rt_seen_at ||= Time.now.to_f if line =~ /Roundtime: \d+ sec\.?/i
    end
    break if Time.now.to_f >= end_time
    break if rt_seen_at && (Time.now.to_f - rt_seen_at) >= 0.5
  end
  text_lines.join(' ')
end

# One tackle attempt, offensive -> tackle -> defensive. That's the entire job
# of this script -- no finishing attack, ever.
def do_tackle(foe)
  fput "stance offensive" if stance != "offensive"
  action_and_collect("cman tackle")
  waitrt?
  fput "stance defensive" if stance != "defensive"
end

# --- main ----------------------------------------------------------------

loop do
  if in_town?
    sleep 2
    next
  end

  foe = GameObj.npcs.find { |n| n.status.to_s !~ /dead|gone/ && !npc_prone?(n) }

  if foe.nil?
    sleep 1
    next
  end

  fput "target ##{foe.id}" unless XMLData.current_target_id.to_i == foe.id.to_i
  waitrt?

  if target_dead?(foe) || npc_prone?(foe)
    sleep 0.5
    next
  end

  if checkstamina >= TACKLE_STAMINA_COST
    do_tackle(foe)
    sleep 0.2
  else
    sleep 1
  end
end
