# tackle-bot.lic
# Standalone "dumb" combat loop for Brayis when he's just along for the ride
# in someone else's group -- their bigshot runs the actual hunt (moving,
# looting, retargeting, finishing kills); this just watches the room for
# anything alive and tackles it, with the exact same stamina gate as
# Brayis-attack.lic so he never exhausts himself. It ONLY tackles -- it never
# falls back to a plain attack (that's the whole point: Brayis is a
# free-floating knockdown source here, not the one finishing kills). Not a
# bigshot hunting-command script -- start and stop it by hand around the
# group hunt:
#
#   ;tackle-bot
#   (kill it from the script list, or ;e Script.kill('tackle-bot'), when done)
#
# Loop, forever:
#   1. Pick any non-dead/gone NPC in the room (GameObj.npcs -- whatever the
#      group is fighting, not a target list Brayis himself has any reason to
#      have built).
#   2. Nothing there -> sleep and keep watching.
#   3. Otherwise target it if needed, then: stamina >= TACKLE_STAMINA_COST ->
#      stance offensive, cman tackle, stance defensive. Not enough stamina ->
#      just wait for it to regenerate. Tackling an already-downed target is
#      a free no-op refusal from GS4 (no stamina spent, no roundtime -- see
#      ALREADY_DOWN_MSG below), so this doesn't bother checking whether the
#      target is already down before trying.
#
# The tackle helpers below are copy-pasted from Brayis-attack.lic rather than
# shared, matching how Picko-attack.lic / Salvi-attack.lic duplicate their own
# near-identical helpers instead of pulling in a shared library -- keep both
# files in sync by hand if the tackle logic changes.
#
# Auto-pauses (skips acting, keeps watching) while standing in the same town
# as Brayis's own bigshot resting_room_id (room 228, Wehnimer's Landing Town
# Square Central, per data/GSIV/Brayis/bigshot_profiles/*.yaml) -- see
# in_town? below. This is a soft pause, not a literal Lich Script#pause: it
# resumes acting on its own the moment you leave town, no manual unpause
# needed, which matters since this script isn't meant to be babysat.

# --- knobs -------------------------------------------------------------------

TACKLE_STAMINA_COST = 7 unless defined?(TACKLE_STAMINA_COST)

# --- patterns ----------------------------------------------------------------

# GS4's outright refusal when the target is already down -- no stamina spent,
# no roundtime, so it's cheap to just let this cut the read short instead of
# burning the whole 5-second window every time it happens.
ALREADY_DOWN_MSG = /is lying down.*awkward proposition/i unless defined?(ALREADY_DOWN_MSG)

# --- helpers -----------------------------------------------------------------

# True while standing in the same town as this character's configured bigshot
# resting_room_id (UserVars.op, persisted once bigshot.lic has been set up for
# this character -- see the bigshot_profiles/*.yaml files). Read dynamically
# instead of hardcoding a town name so this keeps working if that ever
# changes. Falls back to "not in town" (never pauses) if no resting room is
# configured or its room id isn't in the local map data, rather than guessing.
def in_town?
  resting_room_id = (defined?(UserVars) && UserVars.op.is_a?(Hash)) ? UserVars.op["resting_room_id"].to_s.strip : ""
  return false if resting_room_id.empty?
  resting_room = Room.list[resting_room_id.to_i]
  return false unless resting_room
  Room.current.location == resting_room.location
end

# Dead/gone check off GameObj.npcs directly -- there's no bigshot-maintained
# target list to lean on here, since Brayis isn't the one driving the hunt.
def target_dead?(foe)
  return true if foe.nil?
  return true if foe.status.to_s =~ /dead|gone/
  !GameObj.npcs.any? { |t| t.id.to_i == foe.id.to_i && t.status.to_s !~ /dead|gone/ }
end

# Sends cmd and collects every line through the roundtime message (a single
# dothistimeout match only sees the first matching line, not the whole result
# block). Also breaks early on ALREADY_DOWN_MSG, which never gets a roundtime
# line at all.
def action_and_collect(cmd)
  text_lines = []
  put cmd
  end_time = Time.now.to_f + 5
  loop do
    line = get?
    if line.nil?
      sleep 0.1
    else
      text_lines << line
      break if line =~ /Roundtime: \d+ sec\.?/i || line =~ ALREADY_DOWN_MSG
    end
    break if Time.now.to_f >= end_time
  end
  text_lines.join(' ')
end

# One tackle attempt, offensive -> tackle -> defensive. That's the entire job
# of this script -- no finishing attack, ever.
def do_tackle(foe)
  fput "stance offensive" if stance != "offensive"
  action_and_collect("cman tackle")
  waitrt?
  fput "stance defensive" if stance != "defensive"
end

# --- main ----------------------------------------------------------------

loop do
  if in_town?
    sleep 2
    next
  end

  foe = GameObj.npcs.find { |n| n.status.to_s !~ /dead|gone/ }

  if foe.nil?
    sleep 1
    next
  end

  fput "target ##{foe.id}" unless XMLData.current_target_id.to_i == foe.id.to_i
  waitrt?

  if target_dead?(foe)
    sleep 0.2
    next
  end

  if checkstamina >= TACKLE_STAMINA_COST
    do_tackle(foe)
    sleep 0.2
  else
    sleep 1
  end
end
