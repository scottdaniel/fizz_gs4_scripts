=begin
  Fizzleworth-buyweapon.lic

  Makes sure the minor demon (any type, under any illusion) is carrying a spare
  weapon for ;reanim to hand the animate. If it isn't, buys one at the weapon shop
  (Wineberry's in Icemule, Tykel's Arms in the Landing), steps OUT of the shop to hand it
  over (minor demons can't enter shops, Scott 11/07), then returns to where it started.

  Run from Fizzleworth-prep.lic. No-op (a silent TELL MDEMON RETURN and one `look`)
  when the demon already has the weapon.

  A demon that is off somewhere is called with TELL MDEMON RETURN, re-sent every 15s, for up to
  reanim_demon_wait secs (default 90 here; a raven has taken up to 49s, an imp 20-26s). If it never arrives the script
  buys NOTHING: it can't tell whether the demon has the weapon. Only "no minor demon at all"
  buys one and keeps it, for reanim to hand over itself.

  Knobs (UserVars, so per-character):
    reanim_weapon         noun of the weapon (default "claidhmore")
    reanim_weapon_order   catalog number to force in EVERY town (default: by town, see ORDER_BY_TOWN:
                          Icemule 82, Wehnimer's Landing 55). Wineberry catalog number (82 =
                          "a massive bone-hilted claidhmore", backroom, ~1200)
=end

module FizzBuyWeapon
  module_function

  NOUN      = (UserVars.reanim_weapon.to_s.strip.empty? ? "claidhmore" : UserVars.reanim_weapon.to_s.strip)
  ORDER_NUM = (UserVars.reanim_weapon_order.to_s =~ /\A\d+\z/ ? UserVars.reanim_weapon_order.to_s : "82")
  WITHDRAW  = 2000          # a buffer over the ~1200 the claidhmore haggles to
  SHOP      = "weaponshop"  # go2 alias -> the nearest weapon shop: Wineberry's in Icemule, Tykel's Arms in the Landing

  # The claidhmore's catalog number differs per shop (11/04 log, Tykel's Arms: "55. a claidhmore" in the
  # backroom; order 82 there answers "I have no such item"). Keyed by the shop room's map location.
  # A METHOD so edits apply on the next run.
  def order_by_town
    { "Icemule Trace" => "82", "Wehnimer's Landing" => "55" }
  end

  # The number to order in the shop we're standing in: UserVars.reanim_weapon_order wins when set, then
  # the table, then 82.
  def order_number
    return UserVars.reanim_weapon_order.to_s.strip if UserVars.reanim_weapon_order.to_s =~ /\A\s*\d+\s*\z/
    town = (Room.current.location rescue nil).to_s
    order_by_town.find { |name, _| town.casecmp?(name) }&.last || ORDER_NUM
  end

  # Your minor demon's room noun, whatever type it is and whatever illusion it wears (an
  # imp showed as a "gnoll" on 10.23). A silent TELL MDEMON RETURN answers with its id and
  # noun, and calls it back to the room if it had wandered off. Replies:
  #   But your <a>X</a> is already here!  ...
  #   Your <a>X</a> acknowledges your order and begins to travel to your location.
  #   The magic in your location is interfering with your <a>X</a> returning to you.
  #   You have no minor demon at this time.
  RETURN_REPLY = /already here!|acknowledges your order|interfering with your|You have no minor demon at this time/i
  DEMON_LINK   = %r{(?:[Bb]ut your|Your|your) <pushBold/><a exist="(\d+)" noun="([\w,'-]+)">([\w\-' ]+)</a><popBold/>}

  # How long to give a straggling demon, and how often to call it again while we wait. An imp
  # takes 20-26s to catch up after a return order (10.30 / 11.01 logs: the old 6s wait gave up on
  # a demon that arrived at 21s and bought a second claidhmore). Since 11/08 the raven has come in
  # at 14-15 s, 31 s, or 47-49 s after leaving the shop (it travels in ~15 s legs), and the 45 s
  # wait gave up on the 47-49 s ones four times, leaving the claidhmore in the cloak (Scott 11/09:
  # that weight goes up the mountain with him), so the default is 90. Same UserVar reanim.lic and
  # Fizzleworth-anim-cleanup read, but they keep their own 45 s default.
  # Methods, not constants, so edits apply to the next hunt.
  def demon_wait
    v = UserVars['reanim_demon_wait'].to_s.strip
    v =~ /\A\d+\z/ ? v.to_i : 90
  end

  def recall_every
    15
  end

  def demon_here?(id)
    (GameObj.npcs.to_a + GameObj.loot.to_a + GameObj.room_desc.to_a).any? { |o| o && o.id.to_s == id.to_s }
  end

  # Find your minor demon and make sure it is with you, calling it with TELL MDEMON RETURN and
  # re-sending that order every recall_every secs until it arrives or `wait` secs are up.
  # @return [status, noun]: :here (in the room), :absent (it exists but didn't arrive in time --
  #   its weapon is unknown), or :none (no minor demon, or no answer to the order)
  def locate_demon(wait = demon_wait)
    deadline = Time.now.to_f + wait
    noun = nil
    loop do
      text = Lich::Util.quiet_command_xml("tell mdemon return", RETURN_REPLY).to_a.join("\n")
      return [noun ? :absent : :none, noun] unless text =~ DEMON_LINK
      id, noun = $1, $2
      return [:here, noun] if text.include?("already here!") || demon_here?(id)
      call_again = [Time.now.to_f + recall_every, deadline].min
      while Time.now.to_f < call_again
        return [:here, noun] if demon_here?(id)
        sleep 0.5
      end
      return [:here, noun] if demon_here?(id)
      return [:absent, noun] if Time.now.to_f >= deadline
    end
  rescue StandardError => e
    echo "[buyweapon] demon lookup error: #{e.class} #{e.message}"
    [:absent, nil]       # fail safe: an unknown demon never triggers a purchase
  end

  # @return the demon's noun once it is in the room, else nil
  def demon_noun(wait = demon_wait)
    status, noun = locate_demon(wait)
    status == :here ? noun : nil
  end

  # `look at <demon>` prints its fixed description, then -- only when it's carrying
  # something -- a trailing line naming it. A bare demon: "The iron verlok'asha is holding X."
  # One wearing the illusion you cast on it (10.30, gnoll): "Peering past the surface of the
  # illusion you have created, you can make out the faint form of a claidhmore suspended within
  # the gnoll." Read lines for a few seconds, stopping early once that line shows.
  # @return true / false, or nil when the demon is out there but never reached us (we can't tell
  #   whether it has the weapon, so the caller must NOT buy another). No demon at all is false.
  def demon_has_weapon?
    status, noun = locate_demon
    return nil if status == :absent
    return false unless status == :here
    put "look at #{noun}"
    deadline = Time.now + 4
    txt = +""
    until Time.now > deadline
      line = get?
      if line.nil?
        sleep 0.05
        next
      end
      txt << line << "\n"
      break if line =~ /is holding|suspended within|could not find|don't see/i
    end
    !!(txt =~ /is holding\b[^.\n]*\b#{Regexp.escape(NOUN)}/i ||
       txt =~ /faint form of\b[^.\n]*\b#{Regexp.escape(NOUN)}\b[^.\n]*suspended within/i)   # false, never nil: nil means "demon unknown"
  end

  # Symbol of Blessing (Voln step 2+): blesses a weapon HELD IN THE RIGHT HAND so
  # it can hurt undead; permanent but each swing uses up one of its
  # (level + 2*rank) blesses; costs favor. gswiki Symbol_of_Blessing. Done to a
  # freshly bought claidhmore before it goes to the demon, so the animate swings a
  # blessed weapon. OFF unless `;vars set reanim_bless=on` (off since 11/07 while hunting
  # minotaurs, which aren't undead; `=off` turns it off again).
  BLESS_OK   = /wave of power flows outward from you|white light wraps around/i
  BLESS_FAIL = /already (?:blessed|has a bless)|not blessable|cannot be blessed|can't be blessed|must be (?:holding|wielding)|right hand|do not have enough favor|don't have enough favor|not a member|You are not|could not find|What were you referring/i

  def bless_enabled?
    v = UserVars.reanim_bless
    return false if v.nil?
    return v if v == true || v == false
    v.to_s =~ /\A\s*(?:1|true|on|yes)\s*\z/i ? true : false
  end

  def holds_weapon?(hand)
    o = GameObj.send(hand)
    !!(o && !o.id.nil? && o.name.to_s.downcase.include?(NOUN.downcase))
  end

  # `symbol of blessing` takes no target: it blesses whatever is in the right
  # hand. A bought weapon often lands in the LEFT hand, so swap it over first
  # (and swap back afterwards so the readied weapon ends up where it was).
  def bless_weapon
    return unless bless_enabled?
    swapped = false
    if !holds_weapon?(:right_hand) && holds_weapon?(:left_hand)
      fput "swap"
      sleep 0.6
      swapped = true
    end
    unless holds_weapon?(:right_hand)
      echo "[buyweapon] can't bless: the #{NOUN} isn't in my right hand."
      fput "swap" if swapped
      return
    end
    r = dothistimeout("symbol of blessing", 5, Regexp.union(BLESS_OK, BLESS_FAIL)).to_s
    waitrt?
    fput "swap" if swapped
    if r =~ BLESS_OK
      echo "[buyweapon] blessed the #{NOUN} (Symbol of Blessing)."
    else
      echo "[buyweapon] couldn't bless the #{NOUN}: #{r.strip[0, 120].empty? ? 'no response' : r.strip[0, 120]}"
    end
  end

  # Still in my hands? GLANCE says, whatever the demon answered (an igaesha can't
  # hold a claidhmore). No answer counts as "still there".
  def in_hand?
    r = dothistimeout("glance", 3, /You glance down/i)
    r.nil? || r =~ /#{Regexp.escape(NOUN)}/i
  end

  # Give the weapon to the demon and say whether it actually took it (it's out of my
  # hands afterwards). No demon, or one that can't hold it -> it's still in hand,
  # so stow it (the cloak) instead of carrying it into the hunt (10.04: the demon
  # had timed out, we logged "gave it to verlok" anyway and five hunts ran with an
  # unarmed animate).
  def give_to_demon
    noun = demon_noun
    if noun
      dothistimeout("give #{NOUN} to #{noun}", 4,
        /grudgingly accepts|hand(?:s)? .* to (?:a|an|the)|refuses|isn't interested|maximum capacity|To whom|could not find/i)
    end
    return true unless in_hand?
    fput "stow #{NOUN}"
    echo "[buyweapon] the demon didn't take the #{NOUN} -- it's in the cloak; reanim will drop it itself. (A demon that can't hold one, like an igaesha, lands here every hunt.)"
    false
  end

  # A minor demon can't enter a shop (Scott 11/07: 17:08 log, Tykel's Arms -- the raven was left
  # in the street, the hand-over waited 45 s for it and the claidhmore went into the cloak), so
  # the hand-over happens outside. Both weapon shops have the one exit, "out". Waits for the
  # room to change; returns whether it did. If it didn't, the hand-over is tried where we are.
  def leave_shop
    before = XMLData.room_id
    fput "out"
    20.times do
      break if XMLData.room_id != before
      sleep 0.25
    end
    moved = XMLData.room_id != before
    echo "[buyweapon] couldn't step out of the shop -- trying the hand-over from here." unless moved
    moved
  end

  def run
    has = demon_has_weapon?
    if has.nil?
      echo "[buyweapon] your demon didn't reach me in #{demon_wait}s, so I can't tell whether it has a #{NOUN} -- NOT buying another. Run ;Fizzleworth-buyweapon once it's with you."
      return
    end
    if has
      echo "[buyweapon] the demon already has a #{NOUN} -- nothing to do."
      return
    end
    # Before spending ~1200: is it already on us (stowed in the cloak, or in a
    # hand)? 10.04: a recovered claidhmore sat in the cloak while this bought a
    # replacement. `get` also pulls it out of worn containers.
    g = dothistimeout("get #{NOUN}", 4,
          /You (?:retrieve|get|remove|pick up|take)|You already have|could not find|What were you referring|can't find/i).to_s
    if g =~ /You (?:retrieve|get|remove|pick up|take)|already have/i
      ok = give_to_demon
      echo "[buyweapon] found the #{NOUN} on me -- #{ok ? 'gave it to the demon' : 'kept it (no demon)'} instead of buying."
      return
    end
    echo "[buyweapon] the demon has no #{NOUN} -- buying one at the weapon shop."

    start = (Room.current.id rescue nil)

    Script.run("go2", "bank")
    dothistimeout("withdraw #{WITHDRAW} silver", 6,
      /withdraw [\d,]+ silvers|hand you [\d,]+ silvers|don't have (?:that much|enough)|insufficient/i)

    Script.run("go2", SHOP)
    number = order_number
    fput "order"                                   # open the catalog
    sleep 1
    o = dothistimeout("order #{number}", 5,         # get its price / arm BUY
          /I have no such item|price|cost|silvers?|Sold for/i).to_s
    # Only buy what the shop says is the weapon: "You ask about the price of a massive bone-hilted claidhmore."
    if o =~ /no such item/i || o !~ /#{Regexp.escape(NOUN)}/i
      echo "[buyweapon] !! item ##{number} here isn't a #{NOUN} (#{(Room.current.location rescue '?')}; the shop said: #{o.strip[0, 80].inspect}) -- not buying. Fix order_by_town."
      Script.run("go2", "bank")
      fput "deposit all"
      Script.run("go2", "#{start} --disable-confirm") if start
      return
    end
    sleep 1
    r = dothistimeout("buy", 8,
      /Sold for|hands you (?:a|an|the)|don't have enough|can't afford|hands are full|not for sale/i).to_s
    if r =~ /hands are full/i
      fput "stow left"
      sleep 0.5
      r = dothistimeout("buy", 8, /Sold for|hands you (?:a|an|the)|don't have enough|can't afford/i).to_s
    end

    if r =~ /Sold for|hands you (?:a|an|the)/i
      bless_weapon
      leave_shop
      ok = give_to_demon
      echo "[buyweapon] bought a #{NOUN}#{ok ? ' and gave it to the demon' : ' (kept -- no demon)'}."
    else
      echo "[buyweapon] !! couldn't buy a #{NOUN} (order ##{number}): #{r.strip[0, 120]}"
    end

    Script.run("go2", "bank")
    fput "deposit all"
    Script.run("go2", "#{start} --disable-confirm") if start
  end
end

FizzBuyWeapon.run
