# Salvi-duskattack.lic
# Cleric stance-dance routine: alternates incant 302 (Smite) and incant 306 (Holy
# Bolt) in stance offensive for maximum damage while either's affordable, then
# falls back through the same out-of-mana chain the other *-duskattack.lic scripts
# use: pray up to 3 times (UserVars.fizzdusk[:praycurrent], shared/reset once per
# arena run by fizzdusk.lic itself), then try symbol of mana if it's off cooldown
# (never used while on cooldown, so it never costs deeds). No wand fallback here --
# once both of those are exhausted, instead of standing idle it spams incant 1700
# (fizz-level.lic's own fallback spell for "nothing else affordable" -- costs no
# mana at all) while waiting for 302/306 to become affordable again, stance-dancing
# around each cast the same way, stepping into offensive for the moment it takes to
# act, then waiting (wait_for_attack) for the monster to actually swing back -- or
# up to ATTACK_WAIT_TIMEOUT seconds, whichever comes first -- before acting again.
#
# If a wound (nerve/head wound, concussion, etc.) blocks spellcasting outright --
# "You can't think clearly enough to prepare a spell!", no roundtime at all --
# fires ;eherbs --spellcast (only touches wounds that would prevent spellcasting,
# leaving cosmetic ones alone) instead of retrying the same failed cast forever.
#
# Boost redemption at "must rest" mirrors Picko-duskattack.lic: gated on fizzdusk's
# own UserVars.fizzdusk[:boost_lte]/[:boost_absorb] toggles (both off by default --
# see ;fizzdusk help), boost longterm tried first when both are on, falling through
# to boost absorb once longterm boosts run out. The no_lte_boosts/no_absorb_boosts
# "already tried and it's empty" flags persist in UserVars.fizzdusk (this script
# gets killed and restarted every wave) instead of a local variable, and only reset
# at wave_number == 1 (a fresh run) -- otherwise a wave-transition restart mid-fight
# would forget it already emptied the pool and hammer "boost longterm"/"boost
# absorb" again every wave for nothing.

# This script gets killed and restarted every wave, so a local "already tried and it
# was empty" flag wouldn't survive between waves -- UserVars.fizzdusk persists across
# restarts within the same run, which is what lets these actually remember instead of
# re-spamming "boost longterm"/"boost absorb" (and getting the same failure message)
# on every single wave. wave_number == 1 marks the first wave of a fresh run (reset
# to 0 by fizzdusk.lic when the winnings package arrives, then incremented after each
# wave's kill), so that's the one point these get cleared back to "try again".
if UserVars.fizzdusk[:wave_number] == 1
  UserVars.fizzdusk[:no_lte_boosts] = false
  UserVars.fizzdusk[:no_absorb_boosts] = false
end
UserVars.fizzdusk[:no_lte_boosts]    = false if UserVars.fizzdusk[:no_lte_boosts].nil?
UserVars.fizzdusk[:no_absorb_boosts] = false if UserVars.fizzdusk[:no_absorb_boosts].nil?

boosted_exp = false

# Alternated in offensive stance, whichever's affordable this tick (falls through
# to the other one if the one up next isn't affordable, rather than stalling the
# alternation on a spell that just can't be cast right now).
ATTACK_SPELLS = [302, 306].freeze unless defined?(ATTACK_SPELLS)

# Spell[302].affordable? only reflects the spell's base registered cost -- against
# a living target it actually costs 4 mana, so this is checked as a backstop
# alongside affordable? below (same pattern as Picko-duskattack.lic's
# EVOKE_903_MANA_COST, for the same reason: incant flavor/target-specific costs
# affordable? doesn't know about).
SPELL_302_MANA_COST = 4 unless defined?(SPELL_302_MANA_COST)

# True if spell_num is both known-affordable and, for 302 specifically, actually
# castable against a living target at the current mana.
def spell_affordable?(spell_num)
  return false unless Spell[spell_num].affordable?
  return checkmana >= SPELL_302_MANA_COST if spell_num == 302
  true
end

# How long to wait in stance defensive for the monster to actually attack before
# giving up and acting anyway. checkrt hitting 0 again isn't a real signal the
# monster did anything -- it just means your own cast roundtime cleared -- so
# without this, defensive stance barely gets held at all.
ATTACK_WAIT_TIMEOUT = 5 unless defined?(ATTACK_WAIT_TIMEOUT)

# Waits for a line that looks like a monster attacking you -- GS4 attack messages
# aimed at the player consistently end in "...you!" regardless of the specific verb
# ("bites you!", "claws at you!", etc) -- or ATTACK_WAIT_TIMEOUT seconds, whichever
# comes first. Passive: doesn't send anything, just watches incoming lines.
def wait_for_attack
  dothistimeout nil, ATTACK_WAIT_TIMEOUT, /you!\s*$/i
end

# GS4 shows this when a wound (nerve/head wound, concussion, etc.) blocks
# spellcasting outright -- no roundtime at all, confirmed live: the normal
# stance-dance loop just kept re-attempting the same cast forever with nothing
# to show for it, burning the full 5s cast_and_collect timeout every single tick.
CANT_CAST_WOUNDED = /can't think clearly enough to prepare a spell/i unless defined?(CANT_CAST_WOUNDED)

# Sends cast_cmd and collects every line through the roundtime message, since a
# single dothistimeout match only sees the first matching line, not the whole
# result block. Also stops early on CANT_CAST_WOUNDED, which never gets a
# roundtime line at all.
def cast_and_collect(cast_cmd)
  text_lines = []
  put cast_cmd
  end_time = Time.now.to_f + 5
  loop do
    line = get?
    if line.nil?
      sleep 0.1
    else
      text_lines << line
      break if line =~ /Roundtime: \d+ sec|Cast Roundtime \d+ Seconds?\.?/i || line =~ CANT_CAST_WOUNDED
    end
    break if Time.now.to_f >= end_time
  end
  text_lines.join(' ')
end

# Casts spell_num in offensive stance, then either heals (if a wound just
# blocked casting entirely) or waits out the cast's own roundtime, then returns
# to defensive and waits for the monster's swing. Shared by the main 302/306
# attack and the 1700 no-mana fallback -- either can hit the same wall.
def cast_and_stance_dance(spell_num)
  put "stance offensive" if stance != "offensive"
  text = cast_and_collect("incant #{spell_num}")

  if text =~ CANT_CAST_WOUNDED
    # --spellcast only touches wounds that would prevent spellcasting (see
    # ;eherbs help), so it heals exactly what's blocking casting instead of
    # burning herbs on cosmetic wounds that don't matter here.
    Script.run("eherbs", "--spellcast")
  else
    # The cast's own roundtime (both "Cast Roundtime" and the follow-on
    # "Roundtime:") hasn't cleared yet the instant cast_and_collect returns --
    # a stance change sent right into that RT just gets queued ("...wait N
    # seconds.") and, confirmed live, never actually lands: the very next loop
    # tick sees stance still offensive and re-enters this branch before the
    # queued change ever fires. Waiting it out first makes the change land
    # immediately and reliably instead of being silently lost.
    waitrt?
    waitcastrt?
  end

  put "stance defensive"
  wait_for_attack
end

while GameObj.targets.any? {|npc| npc.status !~ /dead|gone/ && npc.name !~ /animated/ }
  GameObj.targets
         .reject {|foe| foe.status =~ /dead|gone/ }
         .sample
         .tap { |npc|

    put "target ##{npc.id}"
    fput "release" if checkprep != "None"
    spell_index = 0

    #start main attack routine here
    loop do
      break if Room.current.id != 24550
      break if npc.status =~ /dead|gone/
      waitrt? if npc.status !~ /dead|gone/
      waitcastrt? if npc.status !~ /dead|gone/
      if checkmind("must rest")
        unless boosted_exp
          if UserVars.fizzdusk[:boost_lte] && !UserVars.fizzdusk[:no_lte_boosts]
            # dothistimeout returns nil after 3s if nothing matches (i.e. the
            # boost succeeded with no error), so no separate success pattern
            # is needed here.
            result = dothistimeout "boost longterm", 3, /You do not have any .*? Boosts to redeem\./
            if result.nil?
              boosted_exp = true
            else
              UserVars.fizzdusk[:no_lte_boosts] = true
            end
          elsif UserVars.fizzdusk[:boost_absorb] && !UserVars.fizzdusk[:no_absorb_boosts]
            result = dothistimeout "boost absorb", 3, /You do not have any .*? Boosts to redeem\./
            if result.nil?
              boosted_exp = true
            else
              UserVars.fizzdusk[:no_absorb_boosts] = true
            end
          end
        end
      else
        boosted_exp = false
      end

      if checkrt == 0 && checkcastrt == 0 && npc.status !~ /dead|gone/
        spell_num = ATTACK_SPELLS[spell_index % ATTACK_SPELLS.length]
        spell_num = ATTACK_SPELLS[(spell_index + 1) % ATTACK_SPELLS.length] unless spell_affordable?(spell_num)

        if spell_affordable?(spell_num)
          cast_and_stance_dance(spell_num)
          spell_index += 1
        elsif UserVars.fizzdusk[:praycurrent] < 3
          # Bump the counter before sending the command, not after -- fizzdusk's
          # wave-transition trigger can force this whole script to be killed and
          # restarted mid-fight, and if that lands between fput returning and the
          # counter increment running, the increment would be lost, letting a
          # restarted instance pray a 4th time.
          UserVars.fizzdusk[:praycurrent] += 1
          fput "pray"
        elsif Spell[9813].known? && !Effects::Cooldowns.active?("Symbol of Mana")
          # Off cooldown only -- Effects::Cooldowns tracks this directly, so this
          # never touches deeds (same check bigshot.lic/BlackArts.lic use).
          fput "symbol of mana"
        else
          # Prays exhausted, symbol of mana unavailable (known but on cooldown, or
          # not known at all), and out of mana for 302/306 -- 1700 costs no mana at
          # all (it's fizz-level.lic's own fallback for when nothing else is
          # affordable), so keep chipping away with it while mana recovers instead
          # of just standing there.
          cast_and_stance_dance(1700)
        end
      end
      sleep 0.1
    end
    #end main attack routine here
  }
end
Script.start("foreach", "in room; look item") if UserVars.fizzdusk[:wave_number] != 25
Script.start("foreach", "in room; get item; stow item") if UserVars.fizzdusk[:wave_number] == 25
