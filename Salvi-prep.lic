#Salvi-prep.lic
#Cleric version of Fizzleworth-prep.lic (Salvi).

module SalviPrep

# Stop playing before gearing up for combat -- kills the instrument along
# with the script (playsongs.lic's before_dying stows it). Kill is async,
# so wait for it to actually finish before "clear hands" below sends its
# own fput commands, to avoid the two scripts racing on the same hands.
if Script.running?("playsongs")
  Script.kill("playsongs")
  wait_while { Script.running?("playsongs") }
end

# clear hands
fput "put my #{GameObj.right_hand} in my cloak"
fput "stow all"

# rub stuff, but only if the spell isn't already active
Script.run("qverb", "rub gold coin") unless Spell[1701].active?
pause 3
Script.run("qverb", "rub small statue") unless Spell[1712].active?
pause 3
Script.run("qverb", "rub moonstone cube") unless Spell[1705].active?
pause 3
Script.run("qverb", "rub quartz orb") unless Spell[1711].active?
pause 3
Script.run("qverb", "rub white crystal") unless Spell[509].active?
pause 3
Script.run("qverb", "rub black crystal") unless GameObj.loot.find { |i| i.name =~ /#{Char.name} disk/ }
pause 3

fput "ready weapon"

end #End of module
