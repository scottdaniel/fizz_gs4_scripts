#Salvi-prep.lic
#Cleric version of Fizzleworth-prep.lic (Salvi).

module SalviPrep

# Temporary Sanctify on the runestaff: PREP 330, then EVOKE the runestaff, unless
# LOOK already shows it. Same idea as Fizzleworth's old per-hunt ensorcell check.
#
# 10/28 log: the evoke at 13:10 gave "A diffuse multihued glow coalesces around
# your fireleaf runestaff ..." (RECALL: "temporarily blessed against the undead
# with holy water flares"), and LOOK at 18:50 still showed
#   A faint aura of holy light radiates from the runestaff.       <- a normal bless
#   A flickering aura of holy light radiates from the runestaff.  <- this Sanctify
# That's 5h40m on, past gswiki's 4 hours, so LOOK decides, not a timer.
#
# The evoke only goes out if the prep line names Sanctify: 10/28 19:05 a typed
# "prep 335" (Divine Wrath) evoked in Town Square killed three people and put
# Salvi in the stocks. In a no-magic room (the jail cell) the evoke gets "Your
# magic fizzles ineffectually."
def self.runestaff_look
  dothistimeout "look at my runestaff", 3,
                /radiates from the runestaff|burn across the runestaff|nothing unusual|I could not find|What were you referring/
end

def self.sanctify_runestaff
  return unless Spell[330].known?

  staff = [GameObj.right_hand, GameObj.left_hand].find { |o| o && o.noun == "runestaff" }
  unless staff
    echo "Salvi-prep: no runestaff in hand, skipping Sanctify."
    return
  end
  return if runestaff_look =~ /flickering aura of holy light/

  cost = Spell[330].mana_cost.to_i
  cost = 30 unless cost.positive?
  if checkmana < cost
    echo "Salvi-prep: #{checkmana} mana, Sanctify needs #{cost}. Skipping it this hunt."
    return
  end

  waitcastrt?
  fput "release" unless checkprep.to_s =~ /^(None)?$/
  # 330 reads "focusing on the Sanctify spell", 335 "focusing upon the Divine Wrath spell"
  prep = dothistimeout "prep 330", 5, /focusing (?:on|upon) the .+? spell|You can't|You don't/
  unless prep =~ /focusing on the Sanctify spell/
    echo "Salvi-prep: prep 330 didn't ready Sanctify (#{prep.inspect}), releasing."
    fput "release" unless checkprep.to_s =~ /^(None)?$/
    return
  end

  # The glow or the fizzle comes before "Cast Roundtime", so whichever matches
  # first is the outcome.
  result = dothistimeout "evoke runestaff", 5, /A diffuse multihued glow coalesces around your|fizzles ineffectually|Cast Roundtime/
  waitcastrt?
  case result
  when /multihued glow/
    # Check once that LOOK shows it now, or every prep would recast it.
    unless runestaff_look =~ /flickering aura of holy light/
      echo "Salvi-prep: Sanctify cast, but LOOK doesn't show the flickering aura. The next prep will cast it again."
    end
  when /fizzles/
    echo "Salvi-prep: Sanctify fizzled (no-magic room?). It'll try again next prep."
  else
    echo "Salvi-prep: evoke runestaff got #{result.inspect}, not the Sanctify glow."
  end
end

# Stop playing before gearing up for combat -- kills the instrument along
# with the script (playsongs.lic's before_dying stows it). Kill is async,
# so wait for it to actually finish before "clear hands" below sends its
# own fput commands, to avoid the two scripts racing on the same hands.
if Script.running?("playsongs")
  Script.kill("playsongs")
  wait_while { Script.running?("playsongs") }
end

# clear hands -- "store weapon" routes the runestaff to the readied sheath per
# the in-game STORE config (STORE SET WEAPON SHEATH); "stow all" mops up anything
# left in the off-hand. Replaces the old hardcoded "put ... in my cloak" that
# ignored the sheath and let stray items fall through to the backpack.
fput "store weapon"
fput "stow all"

# rub stuff, but only if the spell isn't already active -- and only pause
# after ones that actually ran, instead of always eating 3s per item
unless Spell[1701].active?
  Script.run("qverb", "rub gold coin")
  pause 3
end
unless Spell[1712].active?
  Script.run("qverb", "rub small statue")
  pause 3
end
unless Spell[1705].active?
  Script.run("qverb", "rub moonstone cube")
  pause 3
end
unless Spell[1711].active?
  Script.run("qverb", "rub quartz orb")
  pause 3
end
unless Spell[509].active?
  Script.run("qverb", "rub white crystal")
  pause 3
end
unless GameObj.loot.find { |i| i.name =~ /#{Char.name} disk/ }
  Script.run("qverb", "rub black crystal")
  pause 3
end

fput "ready weapon"

sanctify_runestaff

# Puts away loot eloot has no room for and unpauses it, so a full cloak can't
# leave you fighting with your hands full (see eloot_guard.lic).
Script.start("eloot_guard") unless Script.running?("eloot_guard")

end #End of module
