#Salvi-prep.lic
#Cleric version of Fizzleworth-prep.lic (Salvi).

module SalviPrep

# (The temporary Sanctify on the runestaff is cast during the rest now, so the mana isn't
# spent at the start of a hunt: see sanctify_runestaff.lic, run from Salvi-prerest.)

# Stop playing before gearing up for combat -- kills the instrument along
# with the script (playsongs.lic's before_dying stows it). Kill is async,
# so wait for it to actually finish before "clear hands" below sends its
# own fput commands, to avoid the two scripts racing on the same hands.
if Script.running?("playsongs")
  Script.kill("playsongs")
  wait_while { Script.running?("playsongs") }
end

# clear hands -- "store weapon" routes the runestaff to the readied sheath per
# the in-game STORE config (STORE SET WEAPON SHEATH); "stow all" mops up anything
# left in the off-hand. Replaces the old hardcoded "put ... in my cloak" that
# ignored the sheath and let stray items fall through to the backpack.
fput "store weapon"
fput "stow all"

# Scroll spell-up first, the rubs after (same order as Picko-prep). The list lives in
# UserVars.scroll_buff_spells (shared with scrollinv.lic and eloot's keep-scrolls list);
# set it with ;vars set scroll_buff_spells=<spell numbers>.
# Spells the rubs below give are left out of this pass: a scroll would take the spell and the
# rub would then be skipped as already active. scrollbuff3 also skips anything already running.
# Empty list -> don't call scrollbuff3: with no args it would read the whole UserVar.
rub_spells    = %w[1701 1712 1705 1711 509]
scroll_wanted = UserVars.scroll_buff_spells.to_s.split(/[\s,]+/)
scroll_first  = scroll_wanted - rub_spells
Script.run("scrollbuff3", scroll_first.join(" ")) unless scroll_first.empty?

# rub stuff, but only if the spell isn't already active -- and only pause
# after ones that actually ran, instead of always eating 3s per item
unless Spell[1701].active?
  Script.run("qverb", "rub gold coin")
  pause 3
end
unless Spell[1712].active?
  Script.run("qverb", "rub small statue")
  pause 3
end
unless Spell[1705].active?
  Script.run("qverb", "rub moonstone cube")
  pause 3
end
unless Spell[1711].active?
  Script.run("qverb", "rub quartz orb")
  pause 3
end
unless Spell[509].active?
  Script.run("qverb", "rub white crystal")
  pause 3
end
unless GameObj.loot.find { |i| i.name =~ /#{Char.name} disk/ }
  Script.run("qverb", "rub black crystal")
  pause 3
end

fput "ready weapon"

# Read the banked Condemn charges once per hunt; the attack scripts keep count
# from there (see condemn_charges.lic).
Script.run("condemn_charges")

# Rescue-child bounty: when the child finds you mid-hunt, stop and run echild right there
# instead of hunting on with her in tow (two children died that way 11/07; see child_watch.lic;
# ;vars set child_rescue=off to disable).
Script.start("child_watch") unless Script.running?("child_watch")

# Puts away loot eloot has no room for and unpauses it, so a full cloak can't
# leave you fighting with your hands full (see eloot_guard.lic).
Script.start("eloot_guard") unless Script.running?("eloot_guard")

end #End of module
