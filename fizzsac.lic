=begin
      author: Fizzleworth, Ashraam
        name: fizzsac
        game: gemstone
        tags: sorcerer, sacrifice, shadow essence, combat
    requires: Lich > 5.14.2
     version: 1.0
        note: Written with assistance from Claude (Anthropic).

  Harvest shadow essence off the creatures in the room. Run it during a hunt
  with mana to spare:

      ;fizzsac

  No target id needed. It pauses bigshot/go2, scans the room, works whichever
  creature is closest to sacrificeable, Pains it the rest of the way down,
  roots it (Tenebrous Tether), and sacrifices it -- then the next one. When
  the room runs dry and the pool still isn't full it WANDERS to the next
  room and keeps going (up to MAX_ROOMS), so one `;fizzsac` call grinds you
  back to 5/5. Stops on: pool full, out of mana, MAX_ROOMS, or you ;kill it.
  If you have a ;reanim animate up it tells it to STOP first (so the buddy
  doesn't finish creatures before the sacrifice lands) and back to ATTACK
  when done. Bigshot is unpaused at the end.

  Best run at the START of a hunt, rested, with the animate already up.

  Sacrifice mechanics since the 12/07/2025 rework: health lost is the main
  factor, a rooted/stunned/webbed target adds a bonus, your own Tenebrous Tether
  adds +15 on top, Necromancy/Demonology ranks add more, the roundtime is 3s,
  and at 30+ Necromancy ranks an attempt costs no spirit. Pain (711) takes
  roughly a third of a creature's health per cast (~140 here), so the old
  "Pain until it reads frail" skipped straight past the window and killed things
  (10.18 21:57: a vereri died to its third Pain with no sacrifice tried). Now,
  per creature: Pain up to PAINS times, stopping as soon as the bond reads
  softer than "stalwart and formidable" (ASSESS shows it; "firmly bound" is the
  first step down, 10.19: after one 84-point Pain, and a second Pain plus a holy
  flare killed that vision), then Tenebrous Tether, then up to TRIES sacrifice
  attempts, and only if it's still standing a last Pain before the next round.

    ;fizzsac           harvest essence from the room (the normal use)
    ;fizzsac 719       if essence is already 5/5, incant 719 at the target
                       instead (kept for a bigshot "script fizzsac target 719"
                       line -- pointless otherwise)
    ;fizzsac #<id> ..  work only that creature

  Mana upkeep via "sacrifice mana" is a separate background script (sac4mana).
  DEBUG = true/false at the top toggles the per-step status echoes.
=end

DEBUG = true

IGNORE_NPCS = /verlok|animated/i   # minor demon / Animate Dead buddy -- never a sacrifice target
ESSENCE_MAX = 5
MAX_ROUNDS  = 8                    # creatures worked per room before moving on
PAINS       = 2                    # Pains before the sacrifice attempts (the 3rd would likely kill it)
TRIES       = 3                    # sacrifice attempts per creature (3s RT, no spirit loss at 30+ necro)
MAX_ROOMS   = 8                    # rooms to wander through before giving up
PAUSE_WHILE = %w[bigshot go2 sac4mana]

# Bond ladder from the logs, full health down: "stalwart and formidable" (10.19: a
# vision at full health) > "firmly bound" (same vision after one 84-point Pain) >
# "susceptible to manipulation" > "enticingly frail". Anything softer than
# stalwart is worth a (cheap) sacrifice attempt now.
FRAIL_RE = /enticingly frail|ready to be severed|hovering (?:on|at) the brink|near death/i
MID_RE   = /susceptible to manipulation|firmly bound/i
SAC_OK   = /You violently shatter the bond on the soul|forming shadow essence/i
SAC_FAIL = /struggle to overpower|effort has no effect|impossible to forge a bond|unable to complete the link|thrown back in a small blast/i
SAC_FULL = /overwhelm you with shadow essence/i

def fizzsac_step(msg)
  echo "[fizzsac] #{msg}" if DEBUG
end

def essence
  Resources.shadow_essence.to_i
rescue StandardError
  ESSENCE_MAX
end

def animate_here?
  GameObj.npcs.any? { |n| n && n.name.to_s =~ /\banimate/i }
rescue StandardError
  false
end

# The text with the bond line in it. ASSESS prints it (checked 10.19); APPRAISE did
# too on 9/14, so it's the backup if ASSESS ever comes back without one.
def bond_text(id)
  %w[assess appraise].each do |cmd|
    s = (Lich::Util.issue_command("#{cmd} #{id}", /^The .+? is \w+ in size/,
          include_end: false, quiet: true, silent: true) rescue []).join(" ")
    return s if s =~ /bond between/i
  end
  ""
end

def readiness(id)
  s = bond_text(id)
  return :frail if s =~ FRAIL_RE
  return :mid   if s =~ MID_RE
  :tough
end

def pain(id)
  return :oom unless Spell[711].affordable?
  waitrt?
  waitcastrt?
  Spell[711].cast(id)
  waitrt?
  waitcastrt?
  :cast
end

def tether(id)
  return unless Spell[706].affordable?
  waitrt?
  waitcastrt?
  Spell[706].cast(id)
  waitrt?
end

def sacrifice(id)
  waitrt?
  waitcastrt?
  r = dothistimeout("sacrifice #{id}", 5, Regexp.union(SAC_OK, SAC_FAIL, SAC_FULL, /Roundtime: \d+/i)).to_s
  waitrt?
  return :ok   if r =~ SAC_OK
  return :full if r =~ SAC_FULL
  return :fail if r =~ SAC_FAIL
  :unknown
end

def alive?(id)
  gid = id.to_s.delete_prefix("#")
  GameObj.npcs.any? { |n| n.id.to_s == gid && n.status.to_s !~ /dead|gone/ }
end

def incant(spell_id, id)
  spell = Spell[spell_id]
  return unless spell && spell.affordable?
  waitrt?
  waitcastrt?
  spell.force_incant
end

# Creatures far below our level yield little shadow essence (10.13: inciters L66
# and incubi L68 at L74), so only sacrifice things within LEVEL_GAP levels of us.
# `;vars set fizzsac_level_gap=5` (0 = no limit). A creature whose level we can't
# look up is allowed (don't block on missing data).
def level_gap
  v = UserVars.fizzsac_level_gap
  v.to_s =~ /\A\s*\d+\s*\z/ ? v.to_i : 5
end

# Lich's bestiary templates are keyed by plain creature name ("magna vereri");
# GameObj names carry extra adjectives ("horrific magna vereri"), so retry with
# leading words dropped.
def creature_level(name)
  words = name.to_s.downcase.split
  (0...words.size).each do |i|
    t = Lich::Gemstone::CreatureTemplate[words[i..].join(" ")]
    return t.level if t && t.level
  end
  nil
rescue StandardError
  nil
end

def worth_sacrificing?(t)
  gap = level_gap
  return true if gap <= 0
  lvl = creature_level(t.name)
  return true if lvl.nil?
  lvl >= Char.level.to_i - gap
rescue StandardError
  true
end

# living, non-ignored creatures in the room that are worth the essence
def sac_targets
  GameObj.targets.to_a.select { |t| t && t.status.to_s !~ /dead|gone/ && t.name.to_s !~ IGNORE_NPCS && worth_sacrificing?(t) }
rescue StandardError
  []
end

# Pick the creature nearest to sacrificeable: a frail one, else a mid one,
# else (only if we can afford to weaken it) the first tough one.
def next_target(can_pain)
  frail = nil
  mid   = nil
  sac_targets.each do |t|
    case readiness("##{t.id}")
    when :frail then frail ||= t
    when :mid   then mid   ||= t
    end
    break if frail
  end
  return ["##{frail.id}", :frail] if frail
  return ["##{mid.id}",   :mid]   if mid
  return ["##{sac_targets.first.id}", :tough] if can_pain && sac_targets.any?
  [nil, nil]
end

# Work one creature (see the header): Pain only while the bond still reads "stalwart"
# (at most PAINS), then Tether and try. @return :ok (essence gained) / :full /
# :oom / :gone (it died or left before we got it) / :tried (still standing,
# softened by one more Pain for the next round).
def work_target(id, state)
  pains = 0
  while state == :tough && pains < PAINS
    return :oom if pain(id) == :oom
    pains += 1
    return :gone unless alive?(id)
    state = readiness(id)
  end
  tether(id)
  TRIES.times do
    return :gone unless alive?(id)
    case sacrifice(id)
    when :ok   then return :ok
    when :full then return :full
    end
  end
  return :gone unless alive?(id)
  return :oom if pain(id) == :oom
  :tried
end

# Work one room: take each creature through work_target. @return :full / :oom /
# :dry (room's out of sacrificeable creatures).
def harvest_room(explicit = nil)
  rounds = 0
  while rounds < MAX_ROUNDS
    return :full if essence >= ESSENCE_MAX
    rounds += 1
    can_pain = Spell[711].affordable?
    id, state = explicit ? [explicit, readiness(explicit)] : next_target(can_pain)

    if id.nil?
      return can_pain ? :dry : :oom
    end

    next unless alive?(id)

    fizzsac_step("#{id} #{state} -- working it.")
    case work_target(id, state)
    when :ok   then echo "[fizzsac] harvested shadow essence (#{essence}/#{ESSENCE_MAX})."
    when :full then return :full
    when :oom  then return :oom
    end
  end
  :dry
end

############################################
# Main
############################################

args = script.vars[1..-1].to_a.compact.map(&:to_s).reject(&:empty?)
explicit = args.find { |a| a.start_with?("#") }
spell_id = args.find { |a| a =~ /^\d+$/ }

if explicit
  et = GameObj.npcs.find { |n| n.id.to_s == explicit.delete_prefix("#") }
  if et && et.name.to_s =~ IGNORE_NPCS
    fizzsac_step("refusing #{explicit} -- that's your own #{et.name}.")
    exit
  end
end

# essence already full -> the legacy "incant a spell at the target" mode
if essence >= ESSENCE_MAX && spell_id
  id = explicit || (GameObj.target && "##{GameObj.target.id}") ||
       (sac_targets.first && "##{sac_targets.first.id}")
  fizzsac_step("essence #{essence}/#{ESSENCE_MAX} -- incanting #{spell_id} at #{id || 'nothing'}.")
  incant(spell_id, id) if id
  exit
end

# explicit id from bigshot -> just that creature, no wander / no pausing
if explicit
  harvest_room(explicit)
  echo "[fizzsac] done -- shadow essence #{essence}/#{ESSENCE_MAX}."
  exit
end

# --- grind mode: top the pool back up, wandering rooms as needed -----------

paused  = PAUSE_WHILE.select { |s| Script.running?(s) && !Script.paused?(s) }
paused.each { |s| Script.pause(s) }
sleep 0.3

# the animate is on "follow" -- it can catch up a room or two into the grind
# and start finishing creatures before the sacrifice lands, so re-issue STOP
# at the top of every room, not just once.
saw_animate = false
quiet_animate = lambda do
  if animate_here?
    fput "tell anim stop"
    saw_animate = true
    sleep 0.2
  end
end

begin
  MAX_ROOMS.times do |room|
    Script.current.kill if checkdead
    quiet_animate.call
    result = harvest_room
    break if result == :full
    if result == :oom
      echo "[fizzsac] out of mana -- stopping at #{essence}/#{ESSENCE_MAX}."
      break
    end
    # room's dry -- move on
    break if room == MAX_ROOMS - 1
    fizzsac_step("room #{room + 1} dry (#{essence}/#{ESSENCE_MAX}) -- wandering.")
    Script.run("wander")
  end
  echo "[fizzsac] done -- shadow essence #{essence}/#{ESSENCE_MAX}."
ensure
  fput "tell anim attack" if saw_animate
  paused.each { |s| Script.unpause(s) if Script.paused?(s) }
end
