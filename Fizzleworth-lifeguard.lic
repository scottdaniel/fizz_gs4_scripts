# Fizzleworth-lifeguard.lic
# Always-on safety net for unattended hunting. Watches health and, while hostiles
# are around, escalates:
#
#   1. health <= RESTORE pct (default 50)  -> Symbol of Restoration (Voln rank 17,
#      "returns up to half of a member's health point loss"). Retried every
#      RESTORE_GAP seconds while it stays low; the game makes the cast wait out
#      any roundtime, so this keeps trying while you're stunned / in RT.
#   2. health <= RETURN pct (default 25)   -> Symbol of Return (rank 25, immediate
#      teleport out). Return is INTERRUPTED if you move ("The power from your
#      symbol dissipates"), so bigshot, go2 and the attack scripts are paused
#      first, and bigshot is told to rest afterward.
#   0. (checked first) STUNNED or WEBBED and health <= SHIFT pct (default 50) and
#      a shadow essence in hand -> SACRIFICE SHIFT, the chalkless Planar Shift (740;
#      news 12/07/2025: usable while stunned/webbed/immobile/rooted, needs 40
#      Demonology ranks, 2 uses a day at 50). NEVER TRIED as of 2026-10-19 -- the
#      Planar Shift page says the chalkless form goes to the last place you shifted
#      from or SENSE PATTERNed (without a rune book in hand), so do a SENSE PATTERN in
#      town centre first. Every reply is echoed so the first real use shows in the log.
#      SHIFT_GAP keeps a miss (no essence / on cooldown / out of uses) from being
#      hammered; Return and Restoration still back it up. Rooted/immobile aren't
#      detected (Lich only exposes stunned and webbed).
#      11.08: the one real try outside Sonreeva (04:00:25, stunned at 45% on the Krag slopes) hit a
#      climb fall's 10 s roundtime: "...wait 9 seconds." Now it waits the roundtime out and retries.
#      11.03: in the Hollowlair Dreadgrounds (Sonreeva) the game refused it three times ("the
#      demonic gates recede away from you ... You recoil back"), so after that reply SHIFT is
#      skipped for the rest of that area (the title's first word); leaving it clears the block.
#
#   +. CLIMB FALL CAP (11.08): a climb that fails badly drops you with damage, a stun and 10 s of
#      roundtime, and a fall can crit-kill at any HP (11.08 04:02:41, a throat crit at 66%, the
#      9th straight fall at the Krag Slopes landslide while go2 kept retrying). So: once
#      CLIMB_CAP damaging falls land inside CLIMB_WINDOW seconds, go2 is paused (no more climbs)
#      and deadexit is asked to send the Discord message and quit the game (only when afk_now is
#      on; otherwise go2 just stays paused -- ;unpause go2 to carry on). Every climb outcome on
#      the landslide is also logged with health / encumbrance / wounds before and after, so the
#      next streak can be explained from the log.
#      ;vars set lifeguard_climb_cap=4     damaging falls that stop the climbing (0 = off)
#
# Written after 10.05: stunned for 6 rounds, then 20s + 10s roundtime in a crowd
# of incubi/inciters; the animate (and luck) kept Fizzleworth alive. There is NO
# "Symbol of Escape" ("Unknown symbol.").
#
# Both symbols cost Voln favor, so they only fire when it's genuinely bad.
# Knobs are UserVars (read live, so changes apply without restarting Lich):
#   ;vars set lifeguard=off              turn the whole thing off (default on)
#   ;vars set lifeguard_restore_pct=50
#   ;vars set lifeguard_return_pct=25
#   ;vars set lifeguard_shift=off        SHIFT only (default on)
#   ;vars set lifeguard_shift_pct=50
#
# Started from Fizzleworth-prep.lic. Stop with ;kill Fizzleworth-lifeguard.

module Lifeguard
  module_function

  POLL         = 0.5
  RESTORE_GAP  = 6     # secs between Restoration attempts while health stays low
  RETURN_GAP   = 30    # secs between Return attempts
  RETURN_WAIT  = 12    # secs to wait for the teleport to take (room id changes)
  SHIFT_GAP    = 120   # secs between SHIFT attempts (own cooldown, few uses a day)
  SHIFT_WAIT   = 8     # secs to wait for SHIFT to move us (room id changes)
  # Chat lines ("[Help] Name: ...") start with a bracket: 11.03 one with "don't" in it was taken for
  # the reply, so the real one (below) was never read.
  SHIFT_REPLY  = /\A(?!\s*\[).*(?:bleed through the veil|gates recede|gateways? reveal|cannot|can't|don't|do not|not enough|no shadow|cooldown|must wait|wait \d+|unable|already|Roundtime)/i
  # 11.03 18:47:58, three tries in a row in the Hollowlair Dreadgrounds; not a rank, essence or
  # cooldown message, so SHIFT is skipped for the rest of that area.
  SHIFT_REFUSED = /gates recede away from you/i
  PAUSE_SCRIPTS = %w[bigshot go2 Fizzleworth-attack-ultima Fizzleworth-attack-cat
                     Fizzleworth-attack-base sac4mana wander fizzsac] unless defined?(PAUSE_SCRIPTS)

  VOLN = (defined?(Lich::Gemstone::Societies::OrderOfVoln) ? Lich::Gemstone::Societies::OrderOfVoln : nil) unless defined?(VOLN)
  CLIMB_HOOK = "lifeguard-climb" unless defined?(CLIMB_HOOK)

  def flag(name)
    v = UserVars.send(name)
    return true if v.nil?
    return v if v == true || v == false
    v.to_s !~ /\A\s*(?:0|false|off|no)\s*\z/i
  end

  def on?
    flag(:lifeguard)
  end

  def pct(name, default)
    v = UserVars.send(name)
    v.to_s =~ /\A\s*\d+\s*\z/ ? v.to_i : default
  end

  def hp_pct
    Char.percent_health.to_i
  rescue StandardError
    100
  end

  # Only act when something's actually hostile in the room.
  def hostiles?
    GameObj.targets.any? { |t| t && t.status.to_s !~ /dead|gone/ && t.name.to_s !~ /verlok|animated/i }
  rescue StandardError
    false
  end

  def symbol_ok?(short)
    return false if VOLN.nil?
    VOLN.available?(short)
  rescue StandardError
    true   # can't tell -- let the game answer
  end

  def restore
    return unless symbol_ok?("restoration")
    echo "[lifeguard] health #{hp_pct}% -- Symbol of Restoration."
    dothistimeout("symbol of restoration", 6,
      /restor|heal|surge|wave|power|favor|Unknown symbol|wait \d+|already|cannot|can't/i)
    waitrt?
  end

  def freeze
    mine = PAUSE_SCRIPTS.select { |s| Script.running?(s) && !Script.paused?(s) }
    mine.each { |s| Script.pause(s) }
    sleep 0.3
    mine
  end

  def thaw(mine)
    mine.each { |s| Script.unpause(s) if Script.paused?(s) }
  end

  # Teleport out. Frozen so nothing walks us out of the cast.
  def emergency_return
    return unless symbol_ok?("return")
    echo "[lifeguard] !! health #{hp_pct}% -- Symbol of Return (freezing bigshot/attack so it isn't interrupted)."
    $bigshot_should_rest = true
    $rest_reason = "lifeguard (low health)"
    mine = freeze
    start = (Room.current.id rescue nil)
    begin
      3.times do
        fput "symbol of return"
        deadline = Time.now + RETURN_WAIT
        until Time.now > deadline
          return echo("[lifeguard] teleported out (now room #{Room.current.id}).") if (Room.current.id rescue nil) != start
          return if checkdead
          sleep 0.3
        end
        break if hp_pct > 40       # recovered enough; stop spending favor
      end
      echo "[lifeguard] Return didn't take."
    ensure
      thaw(mine)
    end
  end

  # Stunned or webbed: the cases Return can't be counted on for and SHIFT is meant for.
  def stuck?
    checkstunned || checkwebbed
  rescue StandardError
    false
  end

  def essence
    Lich::Resources.shadow_essence.to_i
  rescue StandardError
    0
  end

  # The area a room belongs to, from its title: "[Hollowlair, Dreadgrounds - ]" => "Hollowlair".
  def region
    XMLData.room_title.to_s[/\[([^,\]]+)/, 1].to_s.strip
  rescue StandardError
    ""
  end

  # SACRIFICE SHIFT (see the header). Frozen like Return so nothing walks us out of it.
  # @return :refused when the game won't open a gate here, else nil
  def emergency_shift
    echo "[lifeguard] !! health #{hp_pct}%, #{checkwebbed ? 'webbed' : 'stunned'} -- SACRIFICE SHIFT (essence #{essence})."
    $bigshot_should_rest = true
    $rest_reason = "lifeguard (shift)"
    mine = freeze
    start = (Room.current.id rescue nil)
    begin
      # 11.08 04:00:25: a climb fall left 10 s of roundtime, the game answered "...wait 9 seconds."
      # (it does not queue the command), and that reply was taken for a miss -- no SHIFT, then
      # SHIFT_GAP locked it out for two minutes and the next fall killed him. Wait the roundtime
      # out first, and if the game still says wait, do it again.
      reply = ""
      3.times do
        waitrt?
        reply = dothistimeout("sacrifice shift", 6, SHIFT_REPLY).to_s
        break unless reply =~ /\A\s*\.\.\.\s*wait \d+/i
      end
      echo "[lifeguard] shift reply: #{reply.strip[0, 180]}"
      if reply =~ SHIFT_REFUSED
        echo "[lifeguard] SHIFT refused in #{region.empty? ? 'this room' : region} -- no more tries until you leave it; Return/Restoration still back it up."
        return :refused
      end
      deadline = Time.now + SHIFT_WAIT
      until Time.now > deadline
        return echo("[lifeguard] shifted out (now room #{Room.current.id}).") if (Room.current.id rescue nil) != start
        return if checkdead
        sleep 0.3
      end
      echo "[lifeguard] SHIFT didn't move us -- check the log for what the game said."
      nil
    ensure
      thaw(mine)
    end
  end

  # --- climb falls (see the header) ---------------------------------------------------------
  # Tunables are methods, not constants: a guarded constant would keep its first value until
  # Lich restarts.
  def climb_cap
    pct(:lifeguard_climb_cap, 4)
  end

  def climb_window
    600   # secs
  end

  # "health 85%, encumbrance 20%, wounds: head 2, leftHand 1/scar 1" (rank after the part name)
  def climb_state
    parts = %w[head neck nsys back chest abdomen leftEye rightEye leftArm rightArm leftHand
               rightHand leftLeg rightLeg leftFoot rightFoot].map do |p|
      w = (Wounds.send(p).to_i rescue 0)
      s = (Scars.send(p).to_i rescue 0)
      next if w.zero? && s.zero?
      "#{p} #{w}#{s > 0 ? "/scar #{s}" : ''}"
    end.compact
    enc = (Char.percent_encumbrance rescue nil)
    "health #{hp_pct}%, encumbrance #{enc.nil? ? '?' : "#{enc}%"}, wounds: #{parts.empty? ? 'none' : parts.join(', ')}"
  rescue StandardError
    "state unavailable"
  end

  # Outcome lines are verified against the 11.07 Saga log. Falls: "...fall to the ground below",
  # "...lose your grip and fall...", "...let go and fall." Slip: harmless, you catch yourself.
  # The hook only queues; echoing and counting happen on the script's own thread.
  def install_climb_hook
    DownstreamHook.remove(CLIMB_HOOK) rescue nil
    fall = /fall to the ground below|lose your grip and fall|will not finish the climb|let go and fall/i
    slip = /attempt to climb the landslide\.\s+After only a few feet, you slip/i
    good = /(?:Confidently, you climb up|Gracefully, you scamper up|You skillfully climb up) the landslide/i
    DownstreamHook.add(CLIMB_HOOK, proc { |line|
      begin
        kind = if line =~ fall then :fall elsif line =~ slip then :slip elsif line =~ good then :ok end
        $lifeguard_climb_q << [Time.now.to_f, kind] if kind
      rescue StandardError
        nil
      end
      line
    })
  end

  def remove_climb_hook
    DownstreamHook.remove(CLIMB_HOOK) rescue nil
  end

  # Called every poll: keep a few seconds of state history, log queued climb outcomes, enforce the cap.
  def climb_tick
    now = Time.now.to_f
    if $lifeguard_hist.empty? || now - $lifeguard_hist.last[0] >= 1.0
      $lifeguard_hist << [now, climb_state]
      $lifeguard_hist.shift while $lifeguard_hist.size > 8
    end
    while (ev = $lifeguard_climb_q.shift)
      t, kind = ev
      before = $lifeguard_hist.reverse.find { |ts, _| t - ts >= 1.5 }
      echo "[lifeguard] climb #{kind} -- before: #{before ? before[1] : 'n/a'} | now: #{climb_state}"
      $lifeguard_falls << t if kind == :fall
    end
    $lifeguard_falls.reject! { |t| t < now - climb_window }
    cap = climb_cap
    return unless cap > 0 && $lifeguard_falls.size >= cap && !$lifeguard_climb_stopped
    $lifeguard_climb_stopped = true
    Script.pause("go2") if Script.running?("go2") && !Script.paused?("go2")
    $deadexit_request = "#{$lifeguard_falls.size} damaging climb falls in #{(climb_window / 60.0).round} minutes" \
                        " at #{XMLData.room_title.to_s[/\[([^\]]+)/, 1] || 'an unknown room'} (health #{hp_pct}%)"
    echo "[lifeguard] !! #{$lifeguard_falls.size} damaging climb falls inside #{(climb_window / 60.0).round} minutes -- " \
         "go2 paused so it stops climbing; asking deadexit to alert Discord and quit (only if afk_now is on). " \
         "Carry on by hand with ;unpause go2."
    Script.start("deadexit") unless Script.running?("deadexit")
  rescue StandardError => e
    echo "[lifeguard] climb guard error: #{e.class} #{e.message}"
  end

  def run
    $lifeguard_climb_q       = []
    $lifeguard_falls         = []
    $lifeguard_hist          = []
    $lifeguard_climb_stopped = false
    install_climb_hook
    echo "[lifeguard] watching health (shift <= #{pct(:lifeguard_shift_pct, 50)}% when stunned/webbed, restore <= #{pct(:lifeguard_restore_pct, 50)}%, return <= #{pct(:lifeguard_return_pct, 25)}%; " \
         "climb cap #{climb_cap > 0 ? "#{climb_cap} falls" : 'off'})."
    last_restore = 0.0
    last_return  = 0.0
    last_shift   = 0.0
    shift_blocked = nil   # area where the game refused a SHIFT; cleared by leaving it
    loop do
      Script.current.kill if checkdead
      climb_tick if on?
      if on? && hostiles?
        hp = hp_pct
        now = Time.now.to_f
        shift_blocked = nil if shift_blocked && shift_blocked != region
        if flag(:lifeguard_shift) && !shift_blocked && stuck? && hp <= pct(:lifeguard_shift_pct, 50) && essence >= 1 && now - last_shift > SHIFT_GAP
          last_shift = now
          shift_blocked = region if emergency_shift == :refused
        elsif hp <= pct(:lifeguard_return_pct, 25) && now - last_return > RETURN_GAP
          last_return = now
          emergency_return
        elsif hp <= pct(:lifeguard_restore_pct, 50) && now - last_restore > RESTORE_GAP
          last_restore = now
          restore
        end
      end
      sleep POLL
    end
  rescue StandardError => e
    echo "[lifeguard] error: #{e.class} #{e.message}"
  end
end

before_dying { Lifeguard.remove_climb_hook }

Lifeguard.run
