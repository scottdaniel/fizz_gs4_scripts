#Felix-prerest.lic
#Empath version of Salvi-prerest.lic (Felixopedes) -- the zombies_landing
#profile's resting scripts (ecure, eloot sell, ewaggle) plus the shared chores
#the other characters run. ecure instead of eherbs: an empath heals himself.
#No wands, so no fresh-wand sweep; no instrument, so no playsongs.

module FelixPrerest

# First, get off any unmapped room (go2 "current room not found"): see unlost.lic.
# Stops here -- bigshot is stopped too -- if it can't walk out.
Script.run("unlost")
exit if $unlost_failed

Script.run("ecure")
Script.start("eloot_guard") unless Script.running?("eloot_guard")  # unpauses eloot when its containers are full
Script.run("diskwait")  # eloot only finds the disk's boxes if the disk is here when the sell starts (10/28)
Script.run("eloot", "sell")
Script.run("unburden")  # a box eloot left in hand -> sell again
Script.run("undead_bounty", "kill zombie")
# Restocks the rub items Felix-prep uses. A no-op until his list is set:
#   ;vars set items_to_buy=gold coin, small statue, moonstone cube, white crystal, black crystal
Script.run("buyitems")
Script.run("ewaggle")

# Rest with the lance put away. eloot sell does STORE WEAPON when it starts but
# READY WEAPON again when it's done (11/13 log), so the lance sat in his hand
# for the whole rest. Felix-prep readies it again before the next hunt. The
# type check keeps STORE WEAPON from shoving anything else into the harness.
fput "swap" if checkright.nil? && GameObj.left_hand.type.to_s =~ /weapon/
fput "store weapon" if GameObj.right_hand.type.to_s =~ /weapon/

end #End of module
