#Fizzleworth-prep.lic

module FizzleworthPrep

# rub stuff
fput "put my #{GameObj.right_hand} in my cloak"
fput "stow all"

# rub stuff, but only if the spell isn't already active -- and only pause
# after ones that actually ran, instead of always eating 3s per item
unless Spell[1701].active?
  Script.run("qverb", "rub gold coin")
  pause 3
end
unless Spell[1712].active?
  Script.run("qverb", "rub small statue")
  pause 3
end
unless Spell[1705].active?
  Script.run("qverb", "rub moonstone cube")
  pause 3
end
unless Spell[509].active?
  Script.run("qverb", "rub white crystal")
  pause 3
end
unless GameObj.loot.find { |i| i.name =~ /#{Char.name} disk/ }
  Script.run("qverb", "rub black crystal")
  pause 3
end

# cast protective spells from scrolls -- spell list lives in UserVars.scroll_buff_spells
# (shared with scrollinv.lic's "Buff Scrolls" categorization); seeded once below
# with the list this line used to hardcode, so behavior doesn't change until you
# edit it with ;vars set scroll_buff_spells=<spell numbers>
# (606 is currently left out while doing arena runs, so as not to waste)
UserVars.scroll_buff_spells ||= "202 211 215 219 303 307 310 313 314 319 503 507 509 508 601 613 618 905 913 1119 1215 1204 1601 1701 1705 1208 207 1616 911"
Script.run("scrollbuff3", UserVars.scroll_buff_spells)
fput "ready weapon"

# check if runestaff is ensorcelled, if not, prep and evoke
res = dothistimeout "l at my #{GameObj.right_hand}", 2, Regexp.union(
      /An ethereal necrotic film covers the/
    )
if res !~ /An ethereal necrotic film covers the/
    fput "prep 735"
    fput "evoke #{GameObj.right_hand}"
    end

end #End of module
