#Fizzleworth-prep.lic

module FizzleworthPrep

# `;Fizzleworth-prep here` (`arena` is the same thing; ;fizzabyss runs it before each arena
# entry): everything below except what walks to another room -- the rubs, the scroll
# spell-up, weapon, lifeguard, but not the buyweapon trip to Icemule. Anything added to this
# script that moves you must be skipped when `here` is set.
# `;Fizzleworth-prep sever` (what Fizzleworth-prep-sever.lic runs) is `here` for a spell-sever
# area like the Rift: the same prep, no walking, and the scroll spell-up is limited to the 1700s.
mode   = Script.current.vars[1].to_s.downcase
sever  = (mode == "sever")
here   = %w[here arena sever].include?(mode)

# Arrangement: scepter (weapon) lives in the sling, runestaff (secondary
# weapon) is stowed in the cloak. IMPORTANT (10.12): `store weapon` and
# `store 2weap` don't pick an item -- they store WHATEVER is in hand using that
# category's container (weapon -> sling, 2weap -> cloak). So `store 2weap` with
# the scepter in hand sent the scepter to the cloak, and `store weapon` with the
# runestaff in hand sent the runestaff to the sling (which then blocks the
# scepter: "won't fit"). Route each item by NAME instead: runestaff -> `stow
# #id` (cloak, its home); scepter -> `store weapon` (sling).
def self.hand_item(re)
  %i[right_hand left_hand].map { |h| GameObj.send(h) }.find { |o| o && o.id && o.name.to_s =~ re }
end

def self.tidy_staffs
  rs = hand_item(/runestaff/i)
  if rs
    fput "stow ##{rs.id}"
    sleep 0.4
  end
  sc = hand_item(/scepter/i)
  return unless sc
  fput "swap" if GameObj.left_hand.id == sc.id     # `store weapon` takes the right hand
  sleep 0.3
  r = dothistimeout("store weapon", 3, /You put|won't fit|have no|nothing|You are not/i).to_s
  if r =~ /won't fit/i
    # the runestaff is sitting in the sling: pull it out, send it to the cloak,
    # then the scepter fits
    fput "ready 2weap"
    sleep 0.5
    rs = hand_item(/runestaff/i)
    fput "stow ##{rs.id}" if rs
    sleep 0.4
    fput "store weapon"
  end
end

# Crooked Intent: TURN on the urglaes thumb-ring (the Sonreeva CS reward) gives 15 minutes of +1
# casting strength, listed under Buffs in SPELL ACTIVE. Verified 10.30 19:13:57: "You spin your
# urglaes thumb-ring, and grim intent courses through you." The ring is worn; if TURN says it
# isn't, get it out of the cloak and put it on, then TURN again. Any other reply (a cooldown, say)
# is only echoed -- 25% of turns double the boost and cost one spirit, per its ANALYZE text.
def self.crooked_intent
  return if Effects::Buffs.active?("Crooked Intent")
  ok     = /grim intent courses through you/i
  not_on = /could not find|What were you referring|not (?:wearing|worn)|aren't wearing|must be (?:worn|wearing)/i
  r = dothistimeout("turn my thumb-ring", 3, Regexp.union(ok, not_on)).to_s
  if r =~ not_on
    fput "get my thumb-ring"
    sleep 0.5
    fput "wear my thumb-ring"
    sleep 0.5
    r = dothistimeout("turn my thumb-ring", 3, ok).to_s
  end
  echo "[prep] thumb-ring TURN: #{r.strip.empty? ? 'no answer' : r.strip[0, 100]}" unless r =~ ok
end

# ewander (what fizzsac and sac4mana wander with) keeps its own boundary list, separate from
# bigshot's hunting_boundaries, so make it match the loaded profile at the start of every hunt.
# 11.02: with no Den boundary it left the Den by the portal, crossed the Abbey and hung at the
# caravan master for 8 hours. `uNNNN` entries become room ids the way bigshot does it. No bigshot
# settings loaded -> leave the list alone.
def self.sync_ewander_boundaries
  op = (UserVars.op rescue nil)
  return unless op.is_a?(Hash)
  ids = op['hunting_boundaries'].to_s.split(/[,\s]+/).reject(&:empty?).flat_map do |entry|
    next [entry] if entry =~ /\A\d+\z/
    found = entry =~ /\Au(-?\d+)\z/i ? Array(Map.ids_from_uid($1.to_i)).first : nil
    echo "[prep] ewander boundary #{entry} isn't a room id or a mapped uid -- skipping it." unless found
    found ? [found.to_s] : []
  end.uniq
  Script.run("ewander", "clear")
  Script.run("ewander", "add #{ids.join(' ')}") unless ids.empty?
end

# Stop playing before gearing up for combat -- kills the instrument along
# with the script (playsongs.lic's before_dying stows it). Kill is async,
# so wait for it to actually finish before "clear hands" below sends its
# own fput commands, to avoid the two scripts racing on the same hands.
if Script.running?("playsongs")
  Script.kill("playsongs")
  wait_while { Script.running?("playsongs") }
end

# clear hands -- "store weapon" routes the runestaff to the readied sheath per
# the in-game STORE config (STORE SET WEAPON SHEATH); "stow all" mops up anything
# left in the off-hand. Replaces the old hardcoded "put ... in my cloak" that
# ignored the sheath and let stray items fall through to the backpack.
tidy_staffs
fput "stow all"

# rub stuff, but only if the spell isn't already active -- and only pause
# after ones that actually ran, instead of always eating 3s per item
unless Spell[1701].active?
  Script.run("qverb", "rub gold coin")
  pause 3
end
unless Spell[1712].active?
  Script.run("qverb", "rub small statue")
  pause 3
end
unless Spell[1705].active?
  Script.run("qverb", "rub moonstone cube")
  pause 3
end
# Mystic Focus (1711), the heavy quartz orb -- the extra casting boost (same as Salvi-prep, added
# 11/04 for the Rift). A 1700, so it survives the Rift's spell sever.
unless Spell[1711].active?
  Script.run("qverb", "rub quartz orb")
  pause 3
end
unless Spell[509].active?
  Script.run("qverb", "rub white crystal")
  pause 3
end
unless GameObj.loot.find { |i| i.name =~ /#{Char.name} disk/ }
  Script.run("qverb", "rub black crystal")
  pause 3
end

crooked_intent       # hands are empty here

# cast protective spells from scrolls -- spell list lives in UserVars.scroll_buff_spells
# (shared with scrollinv.lic's "Buff Scrolls" categorization); seeded once below
# with the list this line used to hardcode, so behavior doesn't change until you
# edit it with ;vars set scroll_buff_spells=<spell numbers>
# (606 is currently left out while doing arena runs, so as not to waste)
UserVars.scroll_buff_spells ||= "202 207 211 215 219 303 307 310 313 314 319 503 507 508 509 601 605 613 618 905 911 913 1119 1204 1208 1215 1601 1616 1701 1705"
# Off since 10.30 to save scrolls; `;vars set prep_scrollbuff=on` brings the spell-up back.
# In `sever` mode a spell-sever area strips every spell outside the 100s, 400s, 700s and 1700s,
# so only the 1700s from the list are worth a scroll, and those are always cast. scrollbuff3
# skips whatever is already running, so a spell the rubs above just gave costs no scroll.
# Never from a scroll: 1711 Mystic Focus. Those scrolls are kept for imbuing the sigil staff; the
# quartz orb rub above is what gives the spell here (Scott 11/04). Dropped from the list in both
# branches in case it ever lands in scroll_buff_spells.
buff_spells = UserVars.scroll_buff_spells.to_s.split - %w[1711]
if sever
  sever_scrolls = buff_spells.select { |n| n.to_i.between?(1700, 1799) }
  Script.run("scrollbuff3", sever_scrolls.join(" ")) unless sever_scrolls.empty?
elsif UserVars.prep_scrollbuff.to_s =~ /\A\s*(?:1|true|on|yes)\s*\z/i
  Script.run("scrollbuff3", buff_spells.join(" ")) unless buff_spells.empty?   # no args = it reads the UserVar itself
end
# Safety net: if scrollbuff3 ever leaves a scroll in hand (a late "get" reply
# raced its check -- 10.03), put it back in the scroll sack BEFORE readying the
# weapon (10.03: the old per-hunt ensorcell landed on the paper instead of the
# runestaff).
sleep 1
%i[right_hand left_hand].each do |hand|
  item = GameObj.send(hand)
  next unless item && item.noun.to_s =~ /\A(?:paper|parchment|scroll|vellum|sheet)\z/i
  sack = (GameObj[Vars["scrollsack"].to_s] rescue nil)
  fput(sack ? "put ##{item.id} in ##{sack.id}" : "stow ##{item.id}")
  sleep 0.5
end
fput "ready weapon"

# (The runestaff is permanently ensorcelled now -- the old per-hunt `prep 735` /
# `evoke` check was removed 2026-10-05.)

# Dismisses the Fizzleworth-attack-cat / -ultima ;reanim animate in the field
# the moment bigshot decides to rest, before the walk home. Started here so
# it's up for the very first hunt (prerest also (re)starts it); no-op on
# base hunts.
Script.start("Fizzleworth-anim-cleanup") unless Script.running?("Fizzleworth-anim-cleanup")

# Debug: log mana every 10s so rest decisions can be checked against the log.
Script.start("Fizzleworth-manalog") unless Script.running?("Fizzleworth-manalog")

# Safety net: Symbol of Restoration at low health, Symbol of Return when it's
# critical (see Fizzleworth-lifeguard.lic; ;vars set lifeguard=off to disable).
# It's autostarted too; this only brings it back if it was killed after login.
Script.start("Fizzleworth-lifeguard") unless Script.running?("Fizzleworth-lifeguard")

# Puts away loot eloot has no room for and unpauses it, so a full cloak can't
# leave you fighting with your hands full (see eloot_guard.lic).
Script.start("eloot_guard") unless Script.running?("eloot_guard")

# Fizzleworth-attack-ultima reanims / grinds once per hunt -- re-arm both.
# Also clear reanim's "buddy exists" flag: any animate from last hunt is long
# gone by now (730 duration, plus the whole rest/travel/shop cycle in between).
$ult_reanim_done    = false
$ult_essence_run    = false
$demonmana_taken   = false   # the demon's mana store is refilled at rest; one ;demonmana get per hunt
$reanim_animate_live = false

sync_ewander_boundaries

# Make sure the minor demon is set to follow -- ;reanim has verlok drop the
# animate's spare weapon, which only works if it's in the room.
fput "tell mdem to follow"
sleep 0.3

# If verlok lost the spare weapon (a botched teardown last hunt), buy a new
# one now so ;reanim has something to arm the animate with. No-op otherwise.
Script.run("Fizzleworth-buyweapon") unless here   # it walks to Icemule's weapon shop

# The Rift (sever mode): make bigshot flee witches and worms through its own flee flag, whatever
# profile is loaded (see Fizzleworth-witchguard). Any other hunt stops a guard left over from one.
if sever
  Script.start("Fizzleworth-witchguard") unless Script.running?("Fizzleworth-witchguard")
elsif Script.running?("Fizzleworth-witchguard")
  Script.kill("Fizzleworth-witchguard")
end

# Log mind saturation ("Field Exp: N/1220") right before the hunt starts, so
# every hunt has a recorded starting mind for the wings-compare analysis
# (bigshot only reads exp while resting otherwise).
fput "exp"

end #End of module
