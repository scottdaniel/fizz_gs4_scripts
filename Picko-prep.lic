#Picko-prep.lic
# Wizard version of Fizzleworth-prep.lic (Picko).

module PickoPrep

# Stop playing before gearing up for combat -- kills the instrument along
# with the script (playsongs.lic's before_dying stows it). Kill is async,
# so wait for it to actually finish before "clear hands" below sends its
# own fput commands, to avoid the two scripts racing on the same hands.
if Script.running?("playsongs")
  Script.kill("playsongs")
  wait_while { Script.running?("playsongs") }
end

# clear hands
fput "put my #{GameObj.right_hand} in my cloak"
fput "stow all"

# rub stuff, but only if the spell isn't already active -- and only pause
# after ones that actually ran, instead of always eating 3s per item
unless Spell[1701].active?
  Script.run("qverb", "rub gold coin")
  pause 3
end
unless Spell[1712].active?
  Script.run("qverb", "rub small statue")
  pause 3
end
unless Spell[1705].active?
  Script.run("qverb", "rub moonstone cube")
  pause 3
end

# cast protective spells from scrolls -- spell list lives in UserVars.scroll_buff_spells
# (shared with scrollinv.lic's "Buff Scrolls" categorization). Must be set via:
# e.g. ;vars set scroll_buff_spells=101 103 107 112 120 202 207 211 215 219 303 307 310 313 314 319 601 606 613 618 1119 1215 1204 1601 1701 1705 1208 1616
Script.run("scrollbuff3", UserVars.scroll_buff_spells)

fput "ready weapon"

end #End of module
