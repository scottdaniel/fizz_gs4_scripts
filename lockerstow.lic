# lockerstow.lic
# Manual test/utility command for the appraise-and-locker logic fizzdusk.lic's
# check_valuable_loot runs automatically once you hit UserVars.fizzdusk
# [:encumbrance_limit] percent encumbered. Run this on demand -- no encumbrance
# check -- so you can verify the appraisal/locker logic actually works without
# waiting to get that loaded down first.
#
# 1. Whatever's in your lootsack (Vars.lootsack) -- minus anything on your eloot
#    sell_exclude list -- gets appraised: jewelry at the gemshop, everything else
#    at the pawnshop. Anything appraised above eloot's own per-character
#    sell_appraise_gemshop/sell_appraise_pawnshop limit (data/GSIV/<char>/eloot.yaml,
#    set via ;eloot setup -> Selling tab) gets moved into the locker at
#    UserVars.fizzdusk[:locker_location] (trunk first, falling back to the locker
#    itself if the trunk's full; walks into a booth via "go open" first unless
#    UserVars.fizzdusk[:locker_is_house] is set). Same logic fizzdusk.lic's own
#    check_valuable_loot uses, so this is a faithful dry run of what would happen
#    automatically mid-arena.
# 2. Only THEN runs ;eloot sell, to clear out whatever's left. This has to happen
#    last, not first -- otherwise eloot would be racing this script to sell the
#    very items it's trying to protect, using the exact same limits.

require 'yaml'

UserVars.fizzdusk[:locker_location] = 15948 if UserVars.fizzdusk[:locker_location].nil?
UserVars.fizzdusk[:locker_is_house] = false if UserVars.fizzdusk[:locker_is_house].nil?

# Loaded once and reused for both the sell_exclude filter and the appraise limits
# below, so the per-character eloot.yaml only gets read from disk a single time.
def eloot_settings
  path = File.join(DATA_DIR, XMLData.game, Char.name, "eloot.yaml")
  settings = YAML.load_file(path) rescue nil
  settings.is_a?(Hash) ? settings : {}
end

ELOOT_SETTINGS = eloot_settings

# Same word-boundary match eloot.lic's own build_word_boundary_regexes uses against
# ELoot.data.sell_exclude_regex -- entries are used as raw regex source, not
# literal-escaped, matching eloot's own behavior exactly (an entry that's itself
# regex-flavored works the same way here as it does for eloot). Items you've told
# eloot to never sell (kept wands, crafting components, etc) shouldn't get blindly
# appraised/possibly locker-stowed here either. nil (match everything) if there's
# no sell_exclude list.
def eloot_sell_exclude_regex(settings)
  list = Array(settings[:sell_exclude])
  return nil if list.empty?
  Regexp.union(list.map { |entry| /\b#{entry}\b/i })
end

SELL_EXCLUDE_REGEX = eloot_sell_exclude_regex(ELOOT_SETTINGS)

# eloot's own "too valuable to auto-sell, flag as a locker/review candidate" cutoff
# (ELoot::Sell.appraise: `amount > limit`) -- reusing it here instead of a separate
# fizzdusk locker_limit means the two can't drift out of sync with each other. Falls
# back to eloot's own defaults (14999/34999) if the per-character eloot.yaml doesn't
# exist yet.
GEMSHOP_LIMIT  = (ELOOT_SETTINGS[:sell_appraise_gemshop]  || 14_999).to_i
PAWNSHOP_LIMIT = (ELOOT_SETTINGS[:sell_appraise_pawnshop] || 34_999).to_i

# Pulls the item to hand, asks the current shop to appraise it, and returns it to
# the lootsack. Returns the appraised silver value, or 0 if nothing was quoted.
def appraise_value(item)
  fput "get ##{item.id}"
  waitrt?
  line = dothistimeout("appraise ##{item.id}", 5, /[,0-9]+ (?:silver|for it if you want to sell|for this if you'd like)|not buying anything this valuable today/)
  value = 0
  value = $1.delete(',').to_i if line.to_s =~ /([,0-9]+) (?:silver|for it if you want to sell|for this if you'd like)/
  fput "put ##{item.id} in my #{Vars.lootsack}"
  value
end

# Public lockers (the default -- Fizzleworth's is the exception with a house
# locker) require walking into a specific booth via "go open" before "open locker"
# does anything at all -- from the Storage Hall, each hallway segment's curtained
# opening leads to a different booth, sometimes already occupied ("You'll have to
# wait, NAME is presently using that locker booth."), in which case you move east
# to the next segment and try again. House lockers (UserVars.fizzdusk
# [:locker_is_house]) skip this entirely -- "open locker" already works directly
# from the locker room itself, no booth to walk into. Confirmed live: without this,
# "open locker" from the Storage Hall just answered "What were you referring to?"
# and every subsequent put failed with "I could not find what you were referring to."
def enter_locker_booth
  return if UserVars.fizzdusk[:locker_is_house]

  10.times do
    result = dothistimeout("go open", 5, /You step through the curtained opening|You'll have to wait/i)
    return if result =~ /You step through the curtained opening/i
    fput "east" if result =~ /You'll have to wait/i
  end
end

# Tries the trunk first, falls back to the locker itself if the trunk is full.
def stow_in_locker(item)
  fput "get ##{item.id}"
  waitrt?
  result = dothistimeout("put ##{item.id} in my trunk", 5, /^You put|won't fit|can't fit|no room|too full|doesn't fit/i)
  fput "put ##{item.id} in my locker" unless result.to_s =~ /^You put/i
end

fput "open my #{Vars.lootsack}"
# "open" is a no-op ("That is already open.") once it's already open, so it can't
# be trusted alone to (re)populate GameObj's cached contents -- confirmed live as
# the exact bug behind Picko-duskattack.lic's wand sack reporting empty when it
# wasn't. "look in" always forces a fresh listing regardless of open state.
fput "look in my #{Vars.lootsack}"
sack = GameObj.inv.find { |i| i.name =~ /#{Regexp.escape(Vars.lootsack)}/i }

if sack.nil? || sack.contents.to_a.empty?
  echo "lockerstow: #{Vars.lootsack} is empty, nothing to appraise."
else
  items = sack.contents.dup
  if SELL_EXCLUDE_REGEX
    excluded, items = items.partition { |item| item.name =~ SELL_EXCLUDE_REGEX }
    echo "lockerstow: skipping #{excluded.length} item(s) on your eloot sell_exclude list." unless excluded.empty?
  end

  if items.empty?
    echo "lockerstow: nothing left to appraise after eloot exclusions."
  else
    jewelry, regular = items.partition { |item| item.type?('jewelry') }
    valuable = []

    unless regular.empty?
      start_script("go2", ["pawnshop"])
      wait_while { running?("go2") }
      regular.each { |item| valuable << item if appraise_value(item) > PAWNSHOP_LIMIT }
    end

    unless jewelry.empty?
      start_script("go2", ["gemshop"])
      wait_while { running?("go2") }
      jewelry.each { |item| valuable << item if appraise_value(item) > GEMSHOP_LIMIT }
    end

    if valuable.empty?
      echo "lockerstow: nothing appraised above your eloot sell_appraise limits."
    else
      echo "lockerstow: #{valuable.length} item(s) appraised above your eloot sell_appraise limits, moving to locker."
      start_script("go2", [UserVars.fizzdusk[:locker_location].to_s])
      wait_while { running?("go2") }
      enter_locker_booth
      fput "open locker"
      fput "open my #{Vars.lootsack}"
      valuable.each { |item| stow_in_locker(item) }
      # Public lockers refuse to let you leave the booth without this ("You must
      # close your locker before leaving!") -- closing unconditionally is harmless
      # for house lockers too.
      fput "close locker"
    end
  end
end

if Script.exists?("eloot")
  Script.run("eloot", "sell")
else
  echo "lockerstow: eloot isn't installed, skipping the sell step."
end

echo "lockerstow: done."
