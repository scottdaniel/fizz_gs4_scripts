# Fizzleworth-manalog.lic
# Debug aid: every INTERVAL seconds, write the mana (and health) the scripts
# actually see into the game log, so a "why did it rest at 56 mana?" question can be answered
# from the log instead of guessed at (10.03: bigshot rested "out of mana" and
# nothing in the log said what the mana was).
#
# Default is a one-line echo (checkmana / maxmana / percent, the same percent
# bigshot compares against `oom`) -- costs no game command and no roundtime.
# Flip USE_GAME_CMD to also send the real `mana` command each tick (12 lines of
# output, shows pulse/node regen) -- noisy, so off by default.
#
# Started from Fizzleworth-prep.lic. Stop with ;kill Fizzleworth-manalog.

INTERVAL     = 10    unless defined?(INTERVAL)
# Health is logged on the same line; while it's below DANGER_PCT sample faster so
# a near-miss (10.05: stunned + 20s roundtime in a crowd) shows up in the log.
DANGER_PCT      = 60 unless defined?(DANGER_PCT)
DANGER_INTERVAL = 2  unless defined?(DANGER_INTERVAL)
USE_GAME_CMD = false unless defined?(USE_GAME_CMD)

# The line goes to the familiar window (the tab beside speech in Saga), not the
# main window, so it doesn't scroll the screen. Saga only writes the "story" stream
# to the text log, so add "familiar" to its logged streams to keep these lines in
# the log. ;vars set manalog_main=on puts them in the main window again.
def log_line(text)
  if UserVars.manalog_main.to_s =~ /\A\s*(?:1|true|on|yes)\s*\z/i
    echo text
  else
    _respond "<pushStream id=\"familiar\" ifClosedStyle=\"watching\"/>#{text}\r\n<popStream/>\r\n"
  end
end

echo "[manalog] logging mana + health every #{INTERVAL}s (every #{DANGER_INTERVAL}s while health < #{DANGER_PCT}%) to the familiar window."
loop do
  Script.current.kill if checkdead
  mx  = (maxmana rescue 0).to_i
  cur = (checkmana rescue 0).to_i
  pct = (Char.percent_mana rescue (mx.positive? ? cur * 100 / mx : 0))
  hmx  = (maxhealth rescue 0).to_i
  hcur = (checkhealth rescue 0).to_i
  hpct = (Char.percent_health rescue (hmx.positive? ? hcur * 100 / hmx : 100))
  log_line "[manalog] mana #{cur}/#{mx} (#{pct}%) | health #{hcur}/#{hmx} (#{hpct}%)"
  fput "mana" if USE_GAME_CMD
  sleep(hpct < DANGER_PCT ? DANGER_INTERVAL : INTERVAL)
end
