#stow_the_shiny.lic
# Not character-specific: run it from a prerest right after ;eloot sell (see
# Picko-prerest.lic for the hook block that wraps the sell). Stores the items eloot
# REFUSED to sell because they appraised above your eloot sell_appraise limits
# (pawnshop / gemshop) in the locker trunk -- but ONLY while you are over
# bigshot's encumbrance limit.
#
# Why: on 10/20 a vultite half plate (appraised 187,866 silvers, over the 24,999
# pawnshop limit) stayed in the cloak, Picko sat at 50% encumbered against
# bigshot's `encumbered: 33`, and bigshot refused to hunt for 8+ hours.
#
#   ;stow_the_shiny          the normal run (what Picko-prerest calls, after its own hook)
#   ;stow_the_shiny sell     run ;eloot sell under the appraisal recorder, THEN the normal
#                            run -- one line in a prerest instead of the hook block
#                            (what Salvi-prerest calls)
#   ;stow_the_shiny dry      say what it would store, don't move anything
#   ;stow_the_shiny force    skip the encumbrance check (for testing the walk)
#
# Rules (Scott, 10/21):
#   1. Nothing goes to the locker unless Char.percent_encumbrance is at or over
#      the loaded bigshot profile's `encumbered` setting.
#   2. Only items that were too valuable to sell. The prerest watches the
#      appraisals eloot asks for while it sells ("You ask <npc> to appraise
#      <item>." plus the shopkeeper's quote that comes back) and keeps them in
#      $shiny_quotes {item name => quote}; an item is "too valuable" if its quote is at or above
#      the SMALLER of your two eloot limits (anything cheaper than that would
#      have been sold) or the gemshop refused to quote it at all. Items eloot
#      never appraised -- the moonstone cube, small statue etc. that Picko-prep
#      rubs -- are never touched.
#
#   3. They go in the mantle, not loose in the trunk: everything fresh from a hunt
#      is unloresung, so the flagged items are put in "an inky black linen
#      mantle" that lives in the trunk (get mantle from trunk / put it back at the
#      end) to carry to Vonaq at the Dreavening for loresong. Without a mantle in
#      the trunk they go straight in the trunk, with a warning.
#
#   4. The mantle holds at most 5 items (Vonaq's limit): it counts what's already
#      in it (LOOK IN) and once it has 5, further items go in the trunk.
#   5. Every too-valuable item is written to a log file the first time it's seen
#      (data/GSIV/<char>/valuable_loot.log: when, item id, name, appraised value,
#      later where it was stored) and announced on the Discord webhook that
#      exp_check uses (data/exp_check.yaml). That happens right after eloot sells,
#      whether or not you're encumbered, so you hear about it without opening the
#      locker; each item is announced once (the log is the memory). To mute it
#      add `valuable_item: false` to exp_check.yaml.
#   ;stow_the_shiny show       print the appraisals recorded from eloot so far, then exit
#   ;stow_the_shiny testhook   posts one test line to the webhook and exits
#
# Per-character locker settings -- optional file data/GSIV/<char>/stow_the_shiny.yaml:
#     locker_target: locker        # a go2 target or a room id (default: locker)
#     booth_command: go curtain    # what gets you into your booth; `none` if you open
#                                  # the locker where you arrive (a house locker)
#   Defaults: walk to `;go2 locker` and try GO CURTAIN (Icemule's Clovertooth Hall)
#   then GO OPEN (the public Moot Hall booths). Fizzleworth's locker is in the
#   Pauper's guild house, with no booth to enter -- give him booth_command: none and
#   locker_target: <the room id>. With no file, UserVars.fizzdusk[:locker_is_house]
#   (the fizzdusk setting) is honored the same way.
#
# Route (confirmed from the 10/20 log, Icemule Trace's Clovertooth Hall):
#   ;go2 locker -> "Clovertooth Hall, Lockers" -> GO CURTAIN (into a booth) ->
#   OPEN LOCKER (reveals "a dark stained antique oak trunk bound in wrought iron")
#   -> GET #id / PUT #id IN TRUNK, falling back to PUT #id IN LOCKER ->
#   CLOSE LOCKER -> ;go2 back to where it started.
#
# dusk_locker.lic (was lockerstow) isn't a fit: it is fizzdusk's dry-run -- it appraises the whole
# lootsack itself, defaults to Wehnimer's Moot Hall and enters a PUBLIC booth with
# "go open".

require 'yaml'
require 'json'
require 'net/http'
require 'uri'

module StowTheShiny

# Never touched even if eloot flagged them.
KEEP_NAME = /runestaff|\bstaff\b|sheath/i unless defined?(KEEP_NAME)

# Safety cap on how many items one visit moves.
MAX_ITEMS = 12 unless defined?(MAX_ITEMS)

# Vonaq's limit on what he'll loresing from one mantle.
MANTLE_LIMIT = 5 unless defined?(MANTLE_LIMIT)

# eloot's own limits for this character (data/GSIV/<char>/eloot.yaml); same
# defaults eloot uses when the file or key is missing.
def self.eloot_limits
  path = File.join(DATA_DIR, XMLData.game, Char.name, "eloot.yaml")
  settings = YAML.load_file(path) rescue nil
  settings = {} unless settings.is_a?(Hash)
  [(settings[:sell_appraise_gemshop] || 14_999).to_i, (settings[:sell_appraise_pawnshop] || 34_999).to_i]
end

def self.loot_container
  name = Vars.lootsack.to_s.strip
  name.empty? ? "cloak" : name
end

# bigshot's own test (`!e`): Char.percent_encumbrance >= the profile's `encumbered`.
# @return [Array(Boolean, Integer, Integer)] over?, current %, limit %
def self.encumbrance_state
  op = (defined?(UserVars) && UserVars.op.is_a?(Hash)) ? UserVars.op : {}
  limit = op["encumbered"].to_i
  current = Char.percent_encumbrance.to_i
  [limit.positive? && limit <= 100 && current >= limit, current, limit]
end

# Items eloot flagged as too valuable that are still in the loot container.
# Fresh LOOK IN so the contents (and ids) are current.
# Item name without its article, lowercased, for comparing against eloot's wording
# ("some polished vultite half plate" vs the inventory's "polished vultite half plate").
def self.plain_name(text)
  text.to_s.sub(/\A(?:an?|the|some)\s+/i, '').strip.downcase
end

def self.flagged_items
  $shiny_debug = nil
  flagged = ($shiny_quotes || {})
  return [] if flagged.empty?
  threshold = eloot_limits.min
  names = flagged.select { |_name, amount| amount == :refused || amount.to_i >= threshold }.keys.map { |n| plain_name(n) }
  $shiny_debug = "recorded #{flagged.map { |n, v| "#{n}=#{v}" }.join('; ')} (threshold #{threshold}"
  return [] if names.empty?

  fput "open my #{loot_container}"
  fput "look in my #{loot_container}"
  sleep 0.5
  box = GameObj.inv.find { |i| i.name =~ /\b#{Regexp.escape(loot_container)}\b/i }
  held = box ? box.contents.to_a : []
  $shiny_debug += "); container #{box ? "#{box.name} ##{box.id}" : 'NOT FOUND'} holds #{held.length}: #{held.map(&:name).join(', ')}"
  held.select { |item| item.name !~ KEEP_NAME && names.include?(plain_name(item.name)) }
end

# Hands must be free for GET/PUT. A wand goes to the fresh-wand container;
# anything else (the runestaff) uses STORE so it lands in its sheath.
def self.clear_hands
  op = (defined?(UserVars) && UserVars.op.is_a?(Hash)) ? UserVars.op : {}
  wands = op["fresh_wand_container"].to_s.strip
  wands = "sack" if wands.empty?
  { "right" => checkright, "left" => checkleft }.each do |hand, noun|
    next unless noun
    if noun =~ /wand/i
      fput "put my #{noun} in my #{wands}"
    else
      fput "store #{hand}"
    end
  end
end

# This character's locker settings (see the header). @return [Hash] target:, booths:
def self.locker_settings
  path = File.join(DATA_DIR, XMLData.game, Char.name, "stow_the_shiny.yaml")
  own = (YAML.load_file(path) rescue nil)
  own = {} unless own.is_a?(Hash)
  fd = (UserVars.fizzdusk.is_a?(Hash) ? UserVars.fizzdusk : {})
  house = fd[:locker_is_house] == true
  target = own["locker_target"] || (house ? fd[:locker_location] : nil) || "locker"
  booth = own.key?("booth_command") ? own["booth_command"] : (house ? "none" : nil)
  booth = booth.to_s.strip
  booths = if booth.empty? then ["go curtain", "go open"]
           elsif booth =~ /\A(?:none|no|false|nil)\z/i then []
           else [booth]
           end
  { target: target.to_s, booths: booths }
end

# Walk into a locker booth (when this locker has one) and open the locker.
# @return [Boolean]
def self.open_locker(booths)
  entered = booths.empty?
  3.times do
    break if entered
    booths.each do |cmd|
      r = dothistimeout(cmd, 5, /You step through the curtained opening|presently using|occupied|can't go|What were you referring/i)
      if r.to_s =~ /You step through the curtained opening/i
        entered = true
        break
      end
      # Public hall: that booth is in use -- the next one is a step east.
      fput "east" if r.to_s =~ /presently using|You'll have to wait/i
    end
    sleep 1 unless entered
  end
  echo "stow_the_shiny: couldn't get into a booth (tried #{booths.join(' / ')}) -- trying the locker anyway." unless entered
  r = dothistimeout("open locker", 5, /As you open the locker|already open|What were you referring/i)
  if r.nil? || r =~ /What were you referring/i
    echo "stow_the_shiny: couldn't open the locker -- leaving the items where they are."
    return false
  end
  true
end

# ---- the log file and the webhook ------------------------------------------

def self.log_file
  File.join(DATA_DIR, XMLData.game, Char.name, "valuable_loot.log")
end

def self.log_line(text)
  File.open(log_file, "a") { |f| f.puts "#{Time.now.strftime('%Y-%m-%d %H:%M')}  #{text}" }
rescue StandardError => e
  echo "stow_the_shiny: couldn't write #{log_file} (#{e.message})"
end

# Has this item already been announced? Object ids are reassigned every login, so
# the id can't be the key -- an item found once and found again in a later session
# looks new. Key on name + value instead: a FOUND line with the same article-less
# name and the same quote counts as the same item while it's "open", i.e. until a
# STORED line for that name follows it, and for at most DEDUPE_DAYS days (so an item
# that was sold or thrown away doesn't hide the next identical find forever).
DEDUPE_DAYS = 7 unless defined?(DEDUPE_DAYS)

def self.found_key(name, quote)
  [plain_name(name), quote == :refused ? "refused" : quote.to_i.to_s]
end

def self.already_found?(item, quote)
  return false unless File.exist?(log_file)
  cutoff = Time.now - DEDUPE_DAYS * 86_400
  open_keys = []
  File.foreach(log_file) do |line|
    next unless line =~ /\A(\d{4})-(\d\d)-(\d\d) (\d\d):(\d\d)\s+(FOUND|STORED)\s+#\d+\s+(.+?)\s+(?:\((.*)\)|->.*)\s*\z/
    stamp = Time.local($1.to_i, $2.to_i, $3.to_i, $4.to_i, $5.to_i)
    kind, name, detail = $6, $7, $8
    if kind == "FOUND"
      next if stamp < cutoff
      value = detail.to_s =~ /appraised at ([\d,]+) silvers/ ? $1.delete(",") : "refused"
      open_keys << [plain_name(name), value]
    else
      open_keys.delete_at(open_keys.index { |k| k[0] == plain_name(name) } || open_keys.length)
    end
  end
  open_keys.include?(found_key(item.name, quote))
end

def self.commas(number)
  number.to_i.to_s.reverse.scan(/\d{1,3}/).join(",").reverse
end

# The silver quote eloot got for this item, or :refused, or nil.
def self.quote_for(item)
  pair = ($shiny_quotes || {}).find { |name, _| plain_name(name) == plain_name(item.name) }
  pair && pair.last
end

# exp_check's webhook (data/exp_check.yaml). @return [Boolean] sent?
def self.post_webhook(text)
  cfg = (YAML.safe_load(File.read(File.join(DATA_DIR, "exp_check.yaml"))) rescue nil)
  cfg = {} unless cfg.is_a?(Hash)
  url = cfg["webhook_url"].to_s.strip
  return false if url.empty? || cfg["valuable_item"] == false
  uri = URI(url)
  return false unless uri.is_a?(URI::HTTPS)
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: true, open_timeout: 5, read_timeout: 5) do |http|
    http.post(uri.request_uri, { content: "[#{Char.name}] #{text}" }.to_json, "Content-Type" => "application/json")
  end
  res.is_a?(Net::HTTPSuccess)
rescue StandardError => e
  echo "stow_the_shiny: webhook failed (#{e.class}: #{e.message})"
  false
end

# Log and announce each too-valuable item the first time it is seen.
def self.announce_new(items)
  items.each do |item|
    quote = quote_for(item)
    next if already_found?(item, quote)
    value = quote == :refused ? "too valuable for the gemshop to quote" : "appraised at #{commas(quote)} silvers"
    log_line("FOUND   ##{item.id}  #{item.name}  (#{value})")
    sent = post_webhook("Found a valuable item: #{item.name} -- #{value}, too valuable to sell.")
    echo "stow_the_shiny: found #{item.name} (#{value})#{sent ? ' -- webhook sent' : ''}."
  end
end

# Take the mantle out of the trunk and hold it, and count what's already in it.
# @return [Integer, nil] items already in the mantle, or nil if there's no mantle
def self.fetch_mantle
  r = dothistimeout("get mantle from trunk", 4, /You remove|What were you referring|need a free hand|could not find/i)
  return nil unless r.to_s =~ /You remove .*mantle/i
  fput "open my mantle"
  line = dothistimeout("look in my mantle", 4, /Total items: (\d+)|nothing in|is empty/i)
  line.to_s =~ /Total items: (\d+)/i ? Regexp.last_match(1).to_i : 0
end

# One item: GET it and put it in the mantle -- unless the mantle is full
# (MANTLE_LIMIT) or missing -- else the trunk, then the locker. state[:mantle] is
# nil until the mantle has been asked for, then :held or :none; state[:count] is
# how many items are in it.
# @return [Symbol, nil] :mantle, :trunk, :locker, or nil if it couldn't be moved
def self.store_item(item, state)
  r = dothistimeout("get ##{item.id}", 4, /You (?:remove|get|pick up|grab)|What were you referring|need a free hand/i)
  return nil unless r.to_s =~ /You (?:remove|get|pick up|grab)/i

  if state[:mantle].nil?
    count = fetch_mantle
    state[:mantle] = count ? :held : :none
    state[:count] = count.to_i
    echo "stow_the_shiny: no mantle in the trunk -- putting the items in the trunk instead." unless count
  end

  put_rx = /You put|won't fit|can't fit|no room|too full|doesn't fit|What were you referring/i
  if state[:mantle] == :held && state[:count] < MANTLE_LIMIT
    r = dothistimeout("put ##{item.id} in my mantle", 4, put_rx)
    if r.to_s =~ /You put/i
      state[:count] += 1
      return :mantle
    end
  end
  r = dothistimeout("put ##{item.id} in trunk", 4, put_rx)
  return :trunk if r.to_s =~ /You put/i
  r = dothistimeout("put ##{item.id} in locker", 4, put_rx)
  return :locker if r.to_s =~ /You put/i
  # Couldn't place it anywhere -- back into the loot container so it isn't left in a hand.
  fput "put ##{item.id} in my #{loot_container}"
  nil
end

# ;eloot sell with a downstream hook that records every appraisal it asks a
# shopkeeper for into $shiny_quotes: the "You ask <npc> to appraise <item>." line
# names the item, the first quote after it (or the gemshop's "not buying anything
# this valuable today") is its value. Only the game's own text is needed. This is
# the same recorder Picko-prerest.lic carries inline.
def self.sell_with_recorder
  $shiny_quotes = {}
  $shiny_appraising = nil
  DownstreamHook.remove("shiny_appraise_down") rescue nil
  DownstreamHook.add("shiny_appraise_down", proc { |line|
    text = line.to_s.gsub(/<[^>]+>/, '')
    if text =~ /^You ask .+? to appraise (.+?)\.\s*$/i
      $shiny_appraising = Regexp.last_match(1).sub(/\A(?:an?|the|some)\s+/i, '').strip
    elsif $shiny_appraising
      # First quote only; later lines ("It had 235 silvers on it.") must not overwrite it.
      if text =~ /not buying anything this valuable today/i
        $shiny_quotes[$shiny_appraising] = :refused
        $shiny_appraising = nil
      elsif text =~ /([,0-9]+) (?:silvers?|for it if you want to sell|for this if you'd like)/
        $shiny_quotes[$shiny_appraising] = Regexp.last_match(1).delete(',').to_i
        $shiny_appraising = nil
      end
    end
    line
  })
  begin
    Script.run("eloot", "sell")
  ensure
    DownstreamHook.remove("shiny_appraise_down")
  end
end

mode = Script.current.vars[1].to_s.downcase
if mode == "sell"
  sell_with_recorder
  mode = ""
end

if mode == "show"
  quotes = ($shiny_quotes || {})
  echo(quotes.empty? ? "stow_the_shiny: nothing recorded from eloot yet." : "stow_the_shiny: recorded appraisals: #{quotes.map { |n, v| "#{n} = #{v}" }.join('; ')}")
  exit
end

if mode == "testhook"
  echo(post_webhook("stow_the_shiny test message -- the webhook works.") ? "stow_the_shiny: test message sent." : "stow_the_shiny: test message NOT sent (no webhook_url in exp_check.yaml, valuable_item: false, or an error above).")
  exit
end

over, current, limit = encumbrance_state
items = flagged_items
announce_new(items) unless mode == "dry"

if !over && mode != "force"
  echo "stow_the_shiny: encumbrance #{current}% is under bigshot's #{limit}% limit -- nothing to store."
elsif items.empty?
  echo "stow_the_shiny: #{current}% encumbered (limit #{limit}%), but no too-valuable item eloot flagged is in the #{loot_container} -- nothing to store.#{($shiny_quotes || {}).empty? ? ' (Nothing has been recorded from eloot yet: the sell has to run under the recorder -- see the header.)' : " [#{$shiny_debug}]"}"
elsif mode == "dry"
  echo "stow_the_shiny (dry run): would put #{items.length} item(s) in the mantle (max #{MANTLE_LIMIT}, the rest in the trunk): #{items.map(&:name).join(', ')}"
else
  echo "stow_the_shiny: #{current}% encumbered (limit #{limit}%) -- storing #{items.length} too-valuable item(s) in the locker: #{items.map(&:name).join(', ')}"
  home = Room.current.id
  begin
    clear_hands
    cfg = locker_settings
    Script.run("go2", cfg[:target])
    arrived = cfg[:target] =~ /\A\d+\z/ ? Room.current.id == cfg[:target].to_i : XMLData.room_title.to_s =~ /locker/i
    if !arrived
      echo "stow_the_shiny: didn't end up at the locker (room: #{XMLData.room_title}, wanted #{cfg[:target]}) -- giving up."
    elsif open_locker(cfg[:booths])
      state = { mantle: nil, count: 0 }
      tally = Hash.new(0)
      items.first(MAX_ITEMS).each do |item|
        where = store_item(item, state)
        break unless where
        tally[where] += 1
        log_line("STORED  ##{item.id}  #{item.name}  -> #{where}")
        $shiny_quotes.delete_if { |n, _| plain_name(n) == plain_name(item.name) }
      end
      # The mantle goes back in the trunk with whatever it now holds.
      fput "put my mantle in trunk" if state[:mantle] == :held
      echo "stow_the_shiny: stored #{tally.values.sum} of #{items.length} item(s) -- " \
           "#{tally[:mantle]} in the mantle, #{tally[:trunk]} in the trunk, #{tally[:locker]} in the locker."
      fput "close locker"
    end
  ensure
    Script.run("go2", home.to_s) if home && Room.current.id != home
  end
end

end # module
