#Htrow-prep.lic
#Sword-and-shield Sorcerer version of Brayis-prep.lic (Htrowelzzif). No Magic
#Item Use, so no gold coin and no wands -- gearing up is clearing hands,
#rubbing the five items that work without it, and GIRDing the longsword and
#shield. Replaces the bounty profile's "gird" prep command.

module HtrowPrep

# clear hands -- "store all" puts the longsword back in the hooded cloak and
# slings the reinforced shield over her shoulder (her STORE settings); "stow
# all" mops up anything else left in a hand.
fput "store all"
fput "stow all"

# rub stuff, but only if the spell isn't already active -- and only pause
# after ones that actually ran, instead of always eating 3s per item. The cube
# and orb crumble after one rub; Htrow-prerest restocks all five.
unless Spell[1712].active?   # Spirit Guard
  Script.run("qverb", "rub small statue")
  pause 3
end
unless Spell[1705].active?   # Martial Prowess
  Script.run("qverb", "rub moonstone cube")
  pause 3
end
unless Spell[1711].active?   # Mystic Focus
  Script.run("qverb", "rub quartz orb")
  pause 3
end
unless Spell[509].active?    # Strength
  Script.run("qverb", "rub white crystal")
  pause 3
end
unless Array(GameObj.loot).find { |i| i.name =~ /#{Char.name} disk/ }
  Script.run("qverb", "rub black crystal")
  pause 3
end

# longsword to the right hand, shield to the left
fput "gird"

# No sword in the right hand: it's really gone (disarmed and never recovered,
# or the STORE weapon setting points at something that isn't there). Don't let
# bigshot walk back out with just a shield -- stop it here, in town, the same
# way Brayis-prep.lic does. This runs before any travel (bigshot's
# hunting_prep_commands happen at the start of pre_hunt). Right hand only: the
# shield would still fill the left after a disarm.
pause 0.5
if checkright.nil?
  echo "Htrow-prep: no sword in the right hand after GIRD -- stopping bigshot. " \
       "Check the STORE weapon setting (STORE LIST)."
  Script.kill("bigshot") if Script.running?("bigshot")
  exit
end

# Puts away loot eloot has no room for and unpauses it, so a full cloak can't
# leave you fighting with your hands full (see eloot_guard.lic).
Script.start("eloot_guard") unless Script.running?("eloot_guard")

end #End of module
