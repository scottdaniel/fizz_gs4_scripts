# Fizzleworth-anim-cleanup.lic
# Always-on companion. End-of-hunt cleanup, run the MOMENT bigshot decides to
# rest -- before anything walks back to town. Three jobs:
#
#   1. Dismiss the ;reanim animate buddy (cat / ultima) in the field, so we
#      don't drag an animated corpse through the tunnels or lose its weapon.
#   2. Sacrifice weakened creatures still in the room for shadow essence,
#      before bigshot's oom rest and the walk home strand them. This is the
#      only place essence gets rebuilt for the mana-hungry variants -- the
#      hunt has already beaten these creatures down, so they're cheap
#      sacrifice targets, unlike the fresh full-health room sac4mana's own
#      harvest wanders off to (see the essence-spiral note in sac4mana.lic).
#   3. Watch for the animate dying IN COMBAT, mid-hunt, and race to save its
#      weapon. See "unexpected mid-hunt animate death" below -- this is what
#      was losing the claidhmore every few hunts.
#
# Why a monitor and not a bigshot hook: bigshot has exactly two command seams,
# hunting_prep_commands (before the hunt) and resting_commands (which runs
# AFTER it's travelled back to the resting room). Nothing runs in the gap
# between "hunt over" and "start walking home". bigshot sets $bigshot_status =
# :resting as soon as should_rest? / ready_to_rest? trips (often mid-room, with
# weakened creatures still present); this watches for that flip and takes the
# window: FREEZE every script that could move Fizzleworth (bigshot, go2, and
# sac4mana's wander/fizzsac cycle), do the two jobs, then unfreeze.
#
# Fizzleworth-prerest.lic still calls `;reanim die` too, as a town-side
# fallback. Both are no-ops when there's no animate.
#
# Start it always-on: added to Fizzleworth-prep.lic (up for hunt 1) and
# Fizzleworth-prerest.lic. Idle cost is one global read every POLL seconds.

module FizzleworthAnimCleanup
module_function

REANIM_SCRIPT = "reanim" unless defined?(REANIM_SCRIPT)
POLL          = 0.15 unless defined?(POLL)   # tight -- must beat go2's first step
# bigshot $bigshot_status values that mean "hunt's done, heading to rest"
REST_STATES   = %i[resting rest_stop] unless defined?(REST_STATES)
# everything that can walk Fizzleworth around at end of hunt
MOVERS        = %w[go2 bigshot sac4mana wander fizzsac] unless defined?(MOVERS)
PAUSE_SETTLE  = 4 unless defined?(PAUSE_SETTLE)

# --- essence harvest ------------------------------------------------------
ESSENCE_MAX          = 5 unless defined?(ESSENCE_MAX)
HARVEST_BELOW        = 3 unless defined?(HARVEST_BELOW)        # only bother when the pool is low
HARVEST_MAX_TARGETS  = 4 unless defined?(HARVEST_MAX_TARGETS)  # cap frozen time
HARVEST_MIN_HEALTH   = 50 unless defined?(HARVEST_MIN_HEALTH)  # abort if something's actually hitting us
HARVEST_MANA_FLOOR   = 20 unless defined?(HARVEST_MANA_FLOOR)  # leave this much for the walk home / next prep
IGNORE_NPCS          = /verlok|animated/i unless defined?(IGNORE_NPCS)
PAIN_SPELL           = 711 unless defined?(PAIN_SPELL)
TETHER_SPELL         = 706 unless defined?(TETHER_SPELL)
FRAIL_RE = /enticingly frail|ready to be severed|hovering (?:on|at) the brink|near death/i unless defined?(FRAIL_RE)
MID_RE   = /susceptible to manipulation/i unless defined?(MID_RE)
SAC_OK   = /You violently shatter the bond on the soul|forming shadow essence/i unless defined?(SAC_OK)
SAC_FAIL = /impossible to forge a bond|unable to complete the link|thrown back in a small blast/i unless defined?(SAC_FAIL)

def essence
  Resources.shadow_essence.to_i
rescue StandardError
  ESSENCE_MAX
end

def pain_cost
  c = Spell[PAIN_SPELL].mana_cost.to_i
  c.positive? ? c : 11
rescue StandardError
  11
end

def readiness(id)
  s = (Lich::Util.issue_command("appraise #{id}", /^The .+? is \w+ in size/,
         include_end: false, quiet: true, silent: true) rescue []).join(" ")
  return :frail if s =~ FRAIL_RE
  return :mid   if s =~ MID_RE
  :tough
end

def try_sacrifice(id)
  waitrt?
  waitcastrt?
  r = dothistimeout("sacrifice #{id}", 5, Regexp.union(SAC_OK, SAC_FAIL, /Roundtime: \d+/i)).to_s
  waitrt?
  r =~ SAC_OK
end

# Sacrifice the creatures the hunt already softened. Pain (711) is ~100 a cast
# and creatures have ~400-600 HP, so more than ONE nudge overshoots straight
# past "frail" into dead (= no essence). So:
#   :frail -> Tether + sacrifice
#   :mid   -> one Pain (mana permitting), re-check, sacrifice if frail now
#   :tough -> skip -- a fresh creature isn't worth soloing down here
# A dead-target check aborts the nudge so we don't Pain a corpse.
def harvest_room
  return if essence >= HARVEST_BELOW
  got = 0
  GameObj.targets.to_a.each do |t|
    break if essence >= ESSENCE_MAX
    break if got >= HARVEST_MAX_TARGETS
    break if checkdead || (Char.percent_health.to_i rescue 100) < HARVEST_MIN_HEALTH
    next if t.nil? || t.status.to_s =~ /dead|gone/
    next if t.name.to_s =~ IGNORE_NPCS
    id = "##{t.id}"

    state = readiness(id)
    next if state == :tough
    if state == :mid
      next unless checkmana.to_i >= pain_cost + HARVEST_MANA_FLOOR
      Spell[PAIN_SPELL].cast(id) rescue nil
      waitcastrt?
      waitrt?
      next if GameObj.targets.to_a.none? { |x| x && x.id == t.id && x.status.to_s !~ /dead|gone/ }
      next unless readiness(id) == :frail
    end

    (Spell[TETHER_SPELL].cast(id) rescue nil) if (Spell[TETHER_SPELL].affordable? rescue false)
    waitcastrt?
    waitrt?
    if try_sacrifice(id)
      got += 1
      echo "Fizzleworth-anim-cleanup: harvested shadow essence (#{essence}/#{ESSENCE_MAX})."
    end
  end
  echo "Fizzleworth-anim-cleanup: nothing sacrificeable in the room." if got.zero?
end

# --- the animate goes away by itself (combat death OR the 730 timer) -------
#
# Two ways the buddy vanishes with no ;reanim die: (1) it's killed in combat
# (09.14: a pestilent vision's poison gas), (2) Animate Dead simply EXPIRES --
# exactly 10:00 after the cast (10.02: 17:23:27 -> 17:33:27, by which point we
# were in town casting spellups, weapon and all). Both print
#   "You sense a loss of the connection between you and your animate."
# and bigshot's own post-kill eloot will happily auto-discard the weapon off a
# fresh corpse ("You discard the inciter's useless equipment").
#
# DON'T detect this by the animate's id going missing from GameObj.npcs: that
# list lags a beat after every room change, so a LIVE, following animate reads
# as "gone" mid-travel. (First version of this did exactly that on 10.02: it
# false-fired at 17:24:05, tried `get claidhmore from #id` on a living animate
# -- "You can't pick that up." -- and cleared $reanim_animate_live, so the
# real end-of-hunt teardown never ran and the animate followed us home.)
# A DownstreamHook on the game's own line is the only reliable signal.
COMBAT_SCRIPTS = %w[Fizzleworth-attack-ultima Fizzleworth-attack-cat
                     Fizzleworth-attack-base] unless defined?(COMBAT_SCRIPTS)
LOSS_RE   = /You sense a loss of the connection between you and your animate/i unless defined?(LOSS_RE)
HOOK_NAME = "fizz-anim-loss" unless defined?(HOOK_NAME)

def install_loss_hook
  DownstreamHook.remove(HOOK_NAME) rescue nil
  DownstreamHook.add(HOOK_NAME, proc { |line|
    $reanim_loss_at = Time.now.to_f if line =~ LOSS_RE
    line
  })
end

def remove_loss_hook
  DownstreamHook.remove(HOOK_NAME) rescue nil
end

# True only when the game said the connection broke AFTER the current animate
# was raised, and nothing deliberate (a ;reanim cast/teardown) is in flight.
def animate_lost?
  return false unless $reanim_animate_live
  return false if Script.running?(REANIM_SCRIPT)
  lost = $reanim_loss_at.to_f
  lost.positive? && lost > $reanim_raised_at.to_f
end

def same_weapon?(a, b)
  a = a.to_s.downcase.strip
  b = b.to_s.downcase.strip
  !a.empty? && !b.empty? && (a == b || a.start_with?(b) || b.start_with?(a))
end

def weapon_on_ground(noun)
  GameObj.loot.find { |o| o && o.name.to_s.split(/\s+/).any? { |w| same_weapon?(w, noun) } }
end

# Pick the weapon back up and give it to verlok. Ground first (expiry, or a
# corpse that already dissolved), then straight off the corpse by id -- NOT
# search/loot, that's the auto-discard path.
def recover_weapon(id, noun)
  got = false
  6.times do                       # GameObj.loot lags the drop a beat
    break if weapon_on_ground(noun)
    sleep 0.3
  end
  if weapon_on_ground(noun)
    r = dothistimeout("get #{noun}", 4, /You (?:pick up|get)|You already have|can't pick that up|What were you/i).to_s
    got = r =~ /You (?:pick up|get)|already have/i
  end
  if !got && id
    r = dothistimeout("get #{noun} from ##{id}", 4,
          /You (?:get|pick up)|can't pick that up|could not find|not carrying|doesn't have|must be closer|dead and cannot/i).to_s
    got = r =~ /You (?:get|pick up)/i
  end
  return false unless got
  sleep 0.3
  dothistimeout("give #{noun} to verlok", 3,
    /grudgingly accepts|hand(?:s)? .* to (?:a|an|the)|refuses|isn't interested/i)
  true
end

# Genuinely gone -- clear the globals up front so the real end-of-hunt teardown
# doesn't waste ANIMATE_CATCHUP chasing something that no longer exists.
def rescue_weapon_after_loss
  id = $reanim_animate_id
  $reanim_animate_live = false
  $reanim_animate_id   = nil
  noun = UserVars.reanim_weapon.to_s.strip
  return if noun.empty?

  mine = COMBAT_SCRIPTS.select { |s| Script.running?(s) && !Script.paused?(s) }
  mine.each { |s| Script.pause(s) }
  begin
    waitrt?
    ok = recover_weapon(id, noun)
    echo(ok ? "Fizzleworth-anim-cleanup: animate went away -- recovered the #{noun}." :
              "Fizzleworth-anim-cleanup: animate went away and the #{noun} wasn't recoverable here -- buyweapon will replace it.")
  ensure
    mine.each { |s| Script.unpause(s) if Script.paused?(s) }
  end
end

# --- lifecycle ----------------------------------------------------------

# $reanim_animate_live is reanim.lic's source of truth (set when Animate Dead
# lands, cleared by `;reanim die`). Fall back to an npc scan in case this
# script started after the reanim. NOT Spell[730].active? -- that stays true
# for the spell's whole duration even after the buddy is dismissed.
def animate_up?
  return true if $reanim_animate_live
  GameObj.npcs.any? { |n| n && n.name.to_s =~ /\banimate/i }
rescue StandardError
  false
end

def resting?
  REST_STATES.include?($bigshot_status)
end

# A living hostile in the room = DON'T drop the weapon here. 10.03: bigshot
# rested for mana with a rooted Ivasian inciter still alive; `tell anim to drop
# claidhmore` hit the floor and that inciter snatched it up the SAME second
# ("A supple Ivasian inciter drops his leather whip and snatches up a massive
# bone-hilted claidhmore!") -- no pickup could have beaten that.
def hostile_here?
  GameObj.targets.any? { |t| t && t.status.to_s !~ /dead|gone/ && t.name.to_s !~ IGNORE_NPCS }
rescue StandardError
  false
end

# Icemule Trace is protected: the animate can't follow Fizzleworth INTO town.
# Tested 2026-10-04 -- the farthest it can follow is Lich room 3055, the town
# edge. So the weapon hand-off can't happen at the resting room (that's why the
# prerest ;reanim die kept logging "animate hasn't caught up" and the
# claidhmore got lost). If the field teardown had to defer (hostile in the
# room), do the hand-off HERE, on the way home: needs bigshot's
# return_waypoint_ids to include 3055 so it walks there first, and then this
# freezes bigshot/go2 the moment we arrive.
BOUNDARY_ROOM = 3055 unless defined?(BOUNDARY_ROOM)

def at_boundary?
  Room.current.id.to_i == BOUNDARY_ROOM
rescue StandardError
  false
end

def boundary_handoff
  mine = []
  freeze = lambda do
    MOVERS.each do |s|
      next unless Script.running?(s) && !Script.paused?(s)
      Script.pause(s)
      mine << s
    end
  end
  freeze.call
  sleep 0.3
  freeze.call            # bigshot can launch the NEXT go2 a beat after the first
  echo "Fizzleworth-anim-cleanup: at the town edge (room #{BOUNDARY_ROOM}) -- handing the weapon off here."
  Script.run(REANIM_SCRIPT, "die")
ensure
  mine.to_a.each { |s| Script.unpause(s) if Script.paused?(s) }
end

# Freeze the movers, do the end-of-hunt jobs, unfreeze only what we froze.
def teardown
  mine = MOVERS.select { |s| Script.running?(s) && !Script.paused?(s) }
  mine.each { |s| Script.pause(s) }
  give = Time.now + PAUSE_SETTLE
  sleep 0.1 until mine.all? { |s| !Script.running?(s) || Script.paused?(s) } || Time.now > give

  harvest_room if essence < HARVEST_BELOW
  if animate_up?
    if hostile_here?
      # Keep the weapon on the animate and bring it along; the hand-off happens
      # at the town edge (BOUNDARY_ROOM, see boundary_handoff). It MUST be on
      # follow, not attack, or it stays behind fighting.
      echo "Fizzleworth-anim-cleanup: hostile still here -- not dropping the weapon; hand-off deferred to the town edge (room #{BOUNDARY_ROOM})."
      fput "tell anim stop"
      sleep 0.3
      fput "tell anim follow"
    else
      Script.run(REANIM_SCRIPT, "die")
    end
  end
ensure
  mine.to_a.each { |s| Script.unpause(s) if Script.paused?(s) }
end

def run
  echo "Fizzleworth-anim-cleanup: watching for end of hunt."
  install_loss_hook
  done = false
  boundary_done = false
  loop do
    Script.current.kill if checkdead

    rescue_weapon_after_loss if animate_lost?

    if at_boundary?
      if resting? && $reanim_animate_live && !boundary_done
        boundary_done = true
        boundary_handoff
      end
    else
      boundary_done = false
    end

    if !resting?
      done = false                    # $bigshot_status back to :hunting / :ready
    elsif !done
      # $bigshot_status just flipped to :resting -- decide and pause NOW, before
      # go2 gets a step in and splits Fizzleworth from the trailing animate.
      if animate_up? || essence < HARVEST_BELOW
        echo "Fizzleworth-anim-cleanup: hunt over -- cleaning up here."
        teardown
      end
      done = true                     # latch until the next hunt, pass or fail
    end

    sleep POLL
  end
rescue StandardError => e
  echo "Fizzleworth-anim-cleanup error: #{e.class} #{e.message}"
end
end

before_dying { FizzleworthAnimCleanup.remove_loss_hook }
FizzleworthAnimCleanup.run
