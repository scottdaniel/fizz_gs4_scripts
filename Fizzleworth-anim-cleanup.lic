# Fizzleworth-anim-cleanup.lic
# Always-on companion for the Fizzleworth-attack-cat variant. Dismisses the
# ;reanim animate buddy IN THE FIELD -- the moment bigshot decides to rest,
# before it walks back to town -- instead of dragging an animated corpse
# through the tunnels.
#
# Why a monitor and not a bigshot hook: bigshot has exactly two command
# seams, hunting_prep_commands (before the hunt) and resting_commands (AFTER
# it's already travelled back to the resting room). Nothing runs in the gap
# between "hunt is over" and "start walking home". bigshot's rest() sets
# $bigshot_status = :resting as soon as should_rest? / ready_to_rest? trips,
# then spends several seconds on a final loot pass + stance change + casting
# its Voln signs before the first go2 step. This watches for that status flip
# and uses that window: pause bigshot, run `;reanim die` (weapon back onto
# verlok -> "tell anim die" -> ;eloot the remains), unpause.
#
# Fizzleworth-prerest.lic still calls `;reanim die` too, as a town-side
# fallback for the rare case this monitor misses the window (or isn't
# running). Both are no-ops when no animate is up, so base / wing hunts are
# unaffected.
#
# Start it always-on: it's added to Fizzleworth-prerest.lic, or
# `;autostart add Fizzleworth-anim-cleanup`. Idle cost is one global read
# every POLL seconds.

module FizzleworthAnimCleanup
module_function

REANIM_SCRIPT = "reanim" unless defined?(REANIM_SCRIPT)
POLL          = 0.3 unless defined?(POLL)
# bigshot $bigshot_status values that mean "hunt's done, heading to rest"
REST_STATES   = %i[resting rest_stop] unless defined?(REST_STATES)
PAUSE_TIMEOUT = 5 unless defined?(PAUSE_TIMEOUT)

def animate_up?
  return true if (Spell[730].active? rescue false)
  GameObj.npcs.any? { |n| n && n.name.to_s =~ /\banimate/i }
rescue StandardError
  false
end

def resting?
  REST_STATES.include?($bigshot_status)
end

# Don't tear down the buddy while anything's still alive in the room -- a
# stray $bigshot_should_rest mid-fight shouldn't strip our tank. By the time
# bigshot is really resting the room is clear.
def room_clear?
  GameObj.targets.none? { |t| t && t.status.to_s !~ /dead|gone/ }
rescue StandardError
  false
end

def bigshot_running?
  Script.running?("bigshot")
end

# Pause bigshot (if it's running and driving), do the teardown, unpause only
# if we're the ones who paused it.
def teardown
  paused_by_us = false
  if bigshot_running? && !Script.paused?("bigshot")
    Script.pause("bigshot")
    paused_by_us = true
    # let bigshot finish whatever game command it was mid-way through
    give = Time.now + PAUSE_TIMEOUT
    sleep 0.1 until Script.paused?("bigshot") || Time.now > give || !bigshot_running?
  end

  Script.run(REANIM_SCRIPT, "die")
ensure
  Script.unpause("bigshot") if paused_by_us && Script.paused?("bigshot")
end

def run
  echo "Fizzleworth-anim-cleanup: watching for end of hunt."
  done = false
  loop do
    Script.current.kill if checkdead

    if !resting?
      done = false                    # $bigshot_status back to :hunting / :ready
    elsif done
      # already handled this rest cycle
    elsif !animate_up?
      done = true                     # nothing to dismiss -- latch
    elsif room_clear?
      echo "Fizzleworth-anim-cleanup: hunt over with an animate up -- dismissing it here."
      teardown
      done = true                     # latch until the next hunt, pass or fail
    end
    # else: resting, animate up, but room not clear yet -- recheck next poll

    sleep POLL
  end
rescue StandardError => e
  echo "Fizzleworth-anim-cleanup error: #{e.class} #{e.message}"
end
end

FizzleworthAnimCleanup.run
