# Fizzleworth-anim-cleanup.lic
# Always-on companion for the Fizzleworth-attack-cat / -ultima variants.
# Dismisses the ;reanim animate buddy IN THE FIELD -- the moment bigshot
# decides to rest, before anything walks back to town -- instead of dragging
# an animated corpse through the tunnels or losing its weapon on the way.
#
# Why a monitor and not a bigshot hook: bigshot has exactly two command
# seams, hunting_prep_commands (before the hunt) and resting_commands (which
# runs AFTER it's already travelled back to the resting room). Nothing runs
# in the gap between "hunt is over" and "start walking home". bigshot sets
# $bigshot_status = :resting as soon as should_rest? / ready_to_rest? trips;
# this watches for that flip and takes the window: FREEZE every script that
# could move Fizzleworth (bigshot, go2, and sac4mana's wander/fizzsac harvest
# cycle), run `;reanim die`, then unfreeze.
#
# Learned the hard way (2026-09-08): pausing only "bigshot" is not enough --
# by end of hunt bigshot has handed travel to go2, and sac4mana may be
# mid-wander harvesting essence. Both keep walking Fizzleworth away from the
# animate while `;reanim die` flails at an empty room. `;reanim die` now also
# waits for the animate to catch up (it's on follow), but the mover freeze is
# what actually makes that possible.
#
# Fizzleworth-prerest.lic still calls `;reanim die` too, as a town-side
# fallback for the rare case this monitor misses the window (or isn't
# running). Both are no-ops when no animate is up, so base / wing hunts are
# unaffected.
#
# Start it always-on: added to Fizzleworth-prep.lic (up for hunt 1) and
# Fizzleworth-prerest.lic. Idle cost is one global read every POLL seconds.

module FizzleworthAnimCleanup
module_function

REANIM_SCRIPT = "reanim" unless defined?(REANIM_SCRIPT)
POLL          = 0.3 unless defined?(POLL)
# bigshot $bigshot_status values that mean "hunt's done, heading to rest"
REST_STATES   = %i[resting rest_stop] unless defined?(REST_STATES)
# everything that can walk Fizzleworth around at end of hunt
MOVERS        = %w[go2 bigshot sac4mana wander fizzsac] unless defined?(MOVERS)
PAUSE_SETTLE  = 4 unless defined?(PAUSE_SETTLE)

def animate_up?
  return true if (Spell[730].active? rescue false)
  GameObj.npcs.any? { |n| n && n.name.to_s =~ /\banimate/i }
rescue StandardError
  false
end

def resting?
  REST_STATES.include?($bigshot_status)
end

# Freeze every mover we didn't already find paused, run the teardown, then
# unfreeze only the ones we froze.
def teardown
  mine = MOVERS.select { |s| Script.running?(s) && !Script.paused?(s) }
  mine.each { |s| Script.pause(s) }
  # let them settle out of whatever game command they were mid-way through
  give = Time.now + PAUSE_SETTLE
  sleep 0.1 until mine.all? { |s| !Script.running?(s) || Script.paused?(s) } || Time.now > give

  Script.run(REANIM_SCRIPT, "die")
ensure
  mine.to_a.each { |s| Script.unpause(s) if Script.paused?(s) }
end

def run
  echo "Fizzleworth-anim-cleanup: watching for end of hunt."
  done = false
  loop do
    Script.current.kill if checkdead

    if !resting?
      done = false                    # $bigshot_status back to :hunting / :ready
    elsif !done
      if animate_up?
        echo "Fizzleworth-anim-cleanup: hunt over with an animate up -- dismissing it here."
        teardown
      end
      done = true                     # latch until the next hunt, pass or fail
    end

    sleep POLL
  end
rescue StandardError => e
  echo "Fizzleworth-anim-cleanup error: #{e.class} #{e.message}"
end
end

FizzleworthAnimCleanup.run
