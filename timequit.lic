
t=Time.now
# Hour of day (0-23) a rest may quit; 5 unless listed here.
quit_hours = { "Fizzleworth" => 8, "Picko" => 8, "Salvi" => 8 }
quit_hour = quit_hours.fetch(Char.name, 5)
if t.hour == quit_hour
	echo "Quitting in 10 seconds"
	pause 10
	fput "quit"
else
	echo "Not time to quit"
    fput "sit"
    fput "rest"
    fput "meditate"
end
