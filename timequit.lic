# timequit.lic -- called by the -prerest scripts; logs out once a quit time you set has passed.
#
# Set the quit time at the keyboard (stored in UserVars.quit_at, per character):
#   ;timequit in 3h50m       a duration from now (3h, 90m, 2h30m, 1.5h; a bare number is hours)
#   ;timequit at 8am         a time of day (8am, 8:30am, 8:30 pm, 20:15, 8): today, or tomorrow if
#                            it has already passed. No am/pm = 24-hour clock.
#   ;timequit off            cancel it
#   ;timequit status         show what is set
# With no arguments (what the rest scripts run) it quits if that time has passed, else it sits,
# rests and meditates. There is no standing schedule: nothing quits unless you set a time.
#
# A quit time belongs to the login it was set in: after a re-login (a new Lich process) it is
# dropped, so a deadline set earlier can't quit you straight after you log back in.
#
# "At the first rest" because it only runs between hunts, so the real quit lands up to one rest
# after the time. A quit time more than 3 hours past is dropped too.

def tq_fmt(epoch)
  Time.at(epoch).strftime("%a %-I:%M %p")
end

# Names this login: a global lives as long as the Lich process, so a re-login gets a new one.
def tq_session
  $timequit_session ||= "#{Process.pid}-#{Time.now.to_i}"
end

# The quit time as epoch seconds, or nil. One set in an earlier login (or before logins were
# tracked) is cleared here.
def tq_quit_at
  v = UserVars.quit_at.to_s.strip
  return nil unless v =~ /\A\d+(?:\.\d+)?\z/
  if UserVars.quit_session.to_s != tq_session
    echo "timequit: the quit time (#{tq_fmt(v.to_f)}) was set before this login -- dropping it."
    tq_clear
    return nil
  end
  v.to_f
end

def tq_set(epoch)
  UserVars.quit_session = tq_session
  UserVars.quit_at = epoch.round.to_s
end

def tq_clear
  UserVars.quit_at = nil
  UserVars.quit_session = nil
end

# "3h50m", "90m", "1.5h", "2 h 30 m", "3:50", or a bare number of hours -> seconds (0 if unreadable)
def tq_parse_duration(spec)
  spec = spec.to_s.strip
  return $1.to_i * 3600 + $2.to_i * 60 if spec =~ /\A(\d+):(\d{2})\z/
  return spec.to_f * 3600 if spec =~ /\A\d+(?:\.\d+)?\z/
  return 0 unless spec =~ /\A(?:\d+(?:\.\d+)?\s*[hm]\s*)+\z/
  hours = spec[/(\d+(?:\.\d+)?)\s*h/, 1].to_f
  mins  = spec[/(\d+(?:\.\d+)?)\s*m/, 1].to_f
  hours * 3600 + mins * 60
end

# "8am", "8:30 pm", "20:15", "8" -> the next moment that clock time occurs (a Time), or nil
def tq_parse_clock(spec)
  return nil unless spec.to_s.strip =~ /\A(\d{1,2})(?::(\d{2}))?\s*(am|pm|a|p)?\z/
  h, m, ap = $1.to_i, $2.to_i, $3
  if ap
    return nil unless h.between?(1, 12)
    h = (h % 12) + (ap.start_with?("p") ? 12 : 0)
  end
  return nil if h > 23 || m > 59
  now = Time.now
  at = Time.new(now.year, now.month, now.day, h, m, 0)
  at += 86_400 if at <= now
  at
end

arg = script.vars[1..-1].to_a.join(" ").strip.downcase
unless arg.empty?
  case arg
  when /\A(?:off|cancel|clear)\z/
    tq_clear
    echo "timequit: quit time cancelled."
  when /\Astatus\z/
    d = tq_quit_at
    echo(d ? "timequit: quitting at the first rest after #{tq_fmt(d)}." : "timequit: no quit time set.")
  when /\Ain\s+(.+)\z/
    secs = tq_parse_duration($1)
    if secs <= 0
      echo "timequit: couldn't read '#{$1}' -- try ;timequit in 3h50m"
    else
      tq_set(Time.now.to_f + secs)
      echo "timequit: will quit at the first rest after #{tq_fmt(tq_quit_at)} (in #{(secs / 3600.0).round(1)} h)."
    end
  when /\Aat\s+(.+)\z/
    at = tq_parse_clock($1)
    if at
      tq_set(at.to_f)
      echo "timequit: will quit at the first rest after #{tq_fmt(at.to_f)}."
    else
      echo "timequit: '#{$1}' isn't a time of day -- try ;timequit at 8am"
    end
  else
    echo "timequit: usage -- ;timequit in 3h50m | at 8am | off | status   (no arguments = the check the rest scripts run)"
  end
  exit
end

d = tq_quit_at
if d && Time.now.to_f - d > (3 * 3600)
  echo "timequit: the quit time (#{tq_fmt(d)}) passed while you were away -- dropping it."
  tq_clear
  d = nil
end

if d && Time.now.to_f >= d
  tq_clear
  echo "Quitting in 10 seconds (the quit time you set, #{tq_fmt(d)}, has passed)"
  pause 10
  fput "quit"
else
  echo "Not time to quit#{d ? " (set to quit after #{tq_fmt(d)})" : ''}"
  fput "sit"
  fput "rest"
  fput "meditate"
end
