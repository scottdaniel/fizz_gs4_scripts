=begin
  scrollinv.lic

  Reads every scroll in your scrollsack (and vibrantscrollsack, if set --
  see fizzfuse.lic) and prints a collated table of every spell found, without
  needing to pick anything up or put anything back -- equivalent in spirit to:
      ;foreach scroll in my case; read item
  but parses each "read" response for its spell number/name and prints a
  summary table instead of dumping raw game text.

  Usage:
    ;scrollinv                    scan UserVars.scrollsack / vibrantscrollsack
    ;scrollinv backpack           scan a container nouned "backpack" instead
    ;scrollinv case, pouch        scan multiple containers (comma-separated)
    ;scrollinv help                show this message

  Set your containers with (same vars fizzfuse.lic uses):
    ;vars set scrollsack=<container name>
    ;vars set vibrantscrollsack=<container name>

    tags: scroll, scrolls, inventory, utility
=end

# Matches Lich's own "scroll" type definition in data/gameobj-data.xml (which
# eloot.lic relies on via thing.type =~ /scroll/), noun-for-noun and exclusion-
# for-exclusion, so this stays in sync with whatever counts as a scroll there.
SCROLL_NOUNS = %w[scroll vellum parchment papyrus palimpsest paper].freeze
SCROLL_NAME_EXCLUDE = /\A(?:a |an |some )?(?:birth certificate parchment|amnesty parchment)\z/i
READ_TIMEOUT = 4

# Prep/buff spells worth tracking separately, from a UserVars list you maintain
# yourself (same one Fizzleworth-prep.lic reads for its scrollbuff3 call) -- set with:
#   ;vars set scroll_buff_spells=202 211 215 ...
def buff_spells
  UserVars.scroll_buff_spells.to_s.scan(/\d+/).map(&:to_i)
end

def usage
  respond "scrollinv -- reads every scroll in a container and tables up the spells found."
  respond ""
  respond "  ;scrollinv                    scan your scrollsack / vibrantscrollsack"
  respond "  ;scrollinv backpack           scan a container nouned \"backpack\" instead"
  respond "  ;scrollinv case, pouch        scan multiple containers (comma-separated)"
  respond ""
  respond "Set your containers with (same vars fizzfuse.lic uses):"
  respond "    ;vars set scrollsack=<container name>"
  respond "    ;vars set vibrantscrollsack=<container name>"
  respond ""
  respond "CURRENT SETTINGS:"
  respond "    scrollsack:         #{UserVars.scrollsack || '(not set)'}"
  respond "    vibrantscrollsack:  #{UserVars.vibrantscrollsack || '(not set)'}"
  respond "    scroll_buff_spells: #{UserVars.scroll_buff_spells || '(not set)'}"
  respond ""
  respond "Containers must be open and worn/held (or otherwise accessible)."
  respond ""
  respond "\"Buff Scrolls\" is whatever spell numbers you list in scroll_buff_spells -- set it with:"
  respond "    ;vars set scroll_buff_spells=202 211 215 219 303 ..."
  respond "(the same var Fizzleworth-prep.lic reads for its scrollbuff3 call, so keeping it up to"
  respond "date there keeps this script's categorization in sync automatically)."
end

def find_container(noun)
  words = noun.to_s.strip.downcase.split(/\s+/)
  pools = []
  pools.concat(Array(GameObj.inv))
  pools.concat(Array(GameObj.loot))
  pools << GameObj.right_hand if GameObj.right_hand&.id
  pools << GameObj.left_hand  if GameObj.left_hand&.id
  GameObj.containers.each_key { |cid| obj = GameObj[cid]; pools << obj if obj }
  pools.compact!
  # Exact noun match first (the true GS4 noun is usually the last word, e.g.
  # "leather case" -> "case" as in "leather scroll case"). Fall back to requiring
  # every word show up somewhere in the full name, since names can have extra
  # words in between (e.g. "leather case" vs. "leather scroll case").
  pools.find { |o| o.noun.to_s.downcase == words.last } ||
    pools.find { |o| words.all? { |w| o.name.to_s.downcase.include?(w) } }
end

def refresh_container(noun)
  # "my" forces GS4 to match something you're carrying instead of a same-nouned
  # item lying in the room (e.g. a stray "wooden case" on the ground).
  target = noun.to_s.strip
  target = "my #{target}" unless target =~ /^my\b/i

  result = dothistimeout "look in #{target}", 5, /In the|Inside the|There is nothing|That is closed|isn't a container|don't see|I don't|<container|<exposeContainer/i
  if result =~ /That is closed/i
    fput "open #{target}"
    result = dothistimeout "look in #{target}", 5, /In the|Inside the|There is nothing|<container|<exposeContainer/i
  end
  find_container(noun)
end

# Marks the actual start of a "read" response, so we don't latch onto unrelated
# lines already queued up (which was causing both misses and screen spam before).
READ_START = /^(?:It takes you a moment to focus on|You continue to read|On the .* you see|You (?:don't|do not) see|There isn't any|nothing (?:scrawled|written|inscribed)|cannot be read|too dark to read|can't make out|You are unable to read)/i

# XML mode is required here: the "<prompt" end marker that signals a response is
# complete only exists on the raw XML stream, not the plain-text one, so plain mode
# (Lich::Util.quiet_command) would never see it and always burn the full timeout.
# Tags get stripped from spell names below since XML mode leaves clickable
# <a exist=... noun=...>Name</a> markup in the captured lines.
def read_scroll(scroll)
  waitrt?
  lines = Lich::Util.issue_command(
    "read ##{scroll.id}", READ_START, /<prompt/,
    include_end: false, timeout: READ_TIMEOUT, silent: true, usexml: true, quiet: true
  )
  waitrt?
  spells = []
  lines.each do |line|
    clean = line.gsub(/<\/?[^>]*>/, '')
    if clean =~ /\((\d+)\)\s+(.*?)\s*$/
      spells << [$1.to_i, $2.strip]
    end
  end
  spells
end

RESERVE_START = /^You have (?:the following items reserved for combat|no items reserved for combat)/i

def read_reserve_list
  lines = Lich::Util.issue_command(
    "reserve list", RESERVE_START, /<prompt/,
    include_end: false, timeout: 5, usexml: true, quiet: false
  )
  lines.filter_map do |line|
    clean = line.gsub(/<\/?[^>]*>/, '')
    next unless clean =~ /^\s*Slot\s+(\d+):\s*(.+?)\s*$/i
    [$1.to_i, $2.strip]
  end
end

if script.vars[1].to_s =~ /^(?:help|\?|-h|--help)$/i
  usage
  exit
end

priority_spells = buff_spells
if priority_spells.empty?
  respond "scrollinv: you must define your buff spell list - ;vars set scroll_buff_spells=<spell numbers>"
  respond "  (same var Fizzleworth-prep.lic reads for its scrollbuff3 call)"
  exit
end

container_arg = script.vars[0].to_s.strip

if container_arg.empty?
  container_nouns = [UserVars.scrollsack, UserVars.vibrantscrollsack].compact.map(&:strip).reject(&:empty?).uniq
  if container_nouns.empty?
    respond "scrollinv: you must define a scrollsack - ;vars set scrollsack=<container name>"
    respond "  (optionally also ;vars set vibrantscrollsack=<container name>)"
    exit
  end
else
  container_nouns = container_arg.split(',').map(&:strip).reject(&:empty?)
end

scrolls = []
scanned_names = []

container_nouns.each do |noun|
  container = refresh_container(noun)
  unless container
    respond "scrollinv: couldn't find a container nouned '#{noun}'; skipping."
    next
  end

  contents = Array(GameObj.containers[container.id])
  if contents.empty?
    respond "scrollinv: '#{container.name}' appears to be empty (or closed); skipping."
    next
  end

  found = contents.select do |o|
    SCROLL_NOUNS.include?(o.noun.to_s.downcase) && !(o.name.to_s =~ SCROLL_NAME_EXCLUDE)
  end
  if found.empty?
    respond "scrollinv: no scrolls found in '#{container.name}'."
  else
    scrolls.concat(found)
    scanned_names << container.name
  end
end

if scrolls.empty?
  respond "scrollinv: no scrolls found across #{container_nouns.join(', ')}."
  exit
end

respond "scrollinv: reading #{scrolls.size} scroll(s) in #{scanned_names.join(', ')}..."

spell_counts        = Hash.new(0)
spell_names         = {}
unreadable          = []
sell_list           = [] # scrolls with no buff spell on them -- [scroll_name, spells]
spells_by_item_name = Hash.new { |h, k| h[k] = [] } # for the reserve-slot lookup below
name_counts         = Hash.new(0)                   # flags ambiguous (same-named) scrolls below

# scroll.name omits the leading article ("aged scroll"), but "reserve list" and the
# "Scrolls [N]:" summary both include it ("an aged scroll") -- normalize both sides
# before comparing so the reserve-slot lookup below can actually match.
def normalize_item_name(name)
  name.to_s.strip.sub(/\A(?:a|an|some)\s+/i, '').downcase
end

scrolls.each do |scroll|
  key = normalize_item_name(scroll.name)
  name_counts[key] += 1
  spells = read_scroll(scroll)
  if spells.empty?
    unreadable << scroll.name
  else
    spells.each do |num, name|
      spell_counts[num] += 1
      spell_names[num] ||= name
    end
    spells_by_item_name[key] += spells
    has_buff = spells.any? { |num, _name| priority_spells.include?(num) }
    sell_list << [scroll.name, spells] unless has_buff
  end
end

if spell_counts.empty?
  respond "scrollinv: no spells could be identified on any scroll in #{scanned_names.join(', ')}."
  exit
end

all_nums      = spell_counts.keys
priority_nums = priority_spells.select { |num| all_nums.include?(num) }
other_nums    = (all_nums - priority_spells).sort

def print_table(title, nums, spell_names, spell_counts)
  return if nums.empty?

  rows = nums.map { |num| [num, spell_names[num], spell_counts[num]] }

  num_w   = [rows.map { |r| r[0].to_s.length }.max, "#".length].max
  spell_w = [rows.map { |r| r[1].to_s.length }.max, "Spell".length].max
  qty_w   = [rows.map { |r| r[2].to_s.length }.max, "Qty".length].max

  sep = "+-#{'-' * num_w}-+-#{'-' * spell_w}-+-#{'-' * qty_w}-+"

  respond ""
  respond title
  respond sep
  respond "| #{'#'.ljust(num_w)} | #{'Spell'.ljust(spell_w)} | #{'Qty'.ljust(qty_w)} |"
  respond sep
  rows.each do |num, name, qty|
    respond "| #{num.to_s.ljust(num_w)} | #{name.to_s.ljust(spell_w)} | #{qty.to_s.ljust(qty_w)} |"
  end
  respond sep
end

print_table("Buff Scrolls", priority_nums, spell_names, spell_counts)
print_table("Hunting / Utility", other_nums, spell_names, spell_counts)

respond ""
respond "scrollinv: #{all_nums.size} distinct spell(s) across #{scrolls.size} scroll(s)."

unless sell_list.empty?
  respond ""
  respond "Sell Candidates (no buff spell -- #{sell_list.size} scroll(s)):"
  sell_list.sort_by { |name, _spells| name.to_s }.each do |name, spells|
    spell_desc = spells.map { |num, sname| "#{num} #{sname}" }.join(", ")
    respond "  #{name}: #{spell_desc}"
  end
end

unless unreadable.empty?
  respond ""
  respond "scrollinv: couldn't identify a spell on #{unreadable.size} item(s): #{unreadable.join(', ')}"
end

reserved = read_reserve_list
unless reserved.empty?
  respond ""
  respond "Reserved for Combat:"
  reserved.each do |slot, item_name|
    key    = normalize_item_name(item_name)
    spells = spells_by_item_name[key]
    if spells.empty?
      respond "  Slot #{slot}: #{item_name} -- not found in scanned containers"
    else
      spell_desc = spells.uniq.map { |num, sname| "#{num} #{sname}" }.join(", ")
      note = name_counts[key] > 1 ? "  (#{name_counts[key]} scrolls share this name -- could be any of them)" : ""
      respond "  Slot #{slot}: #{item_name}: #{spell_desc}#{note}"
    end
  end
end
