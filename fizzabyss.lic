#Arena of the Abyss - Ebon Gate (fizzabyss)
#Fork of abyssx by Hexbane (v3.1), changed for Fizzleworth:
#  * no bigshot. `;bigshot quick` re-runs the profile's whole hunting setup (prep,
#    scrollbuff3, go2 bank, hunting scripts...) on every call -- 10.23 that wasted a minute
#    mid-fight and the arena's lightning killed him. The attack is a script now, run
#    directly each round (default Fizzleworth-attack-arena).
#  * own settings file (fizzabyss.yaml); the first run copies abyssx.yaml and switches the
#    attack mode to the script.
#
# Automates the Ebon Gate Arena of the Abyss. Checks your stored entry count
# via 'event entr', pays the entry fee, fights through each wave, loots the
# prize from the oculoth, and loops until entries run out. Entries must be
# redeemed before starting (redeem key).
#
# Attack modes (set in setup):
#   script   -- runs ;<script> each combat round until all targets are dead (default
#               Fizzleworth-attack-arena: Pain / Disintegrate / Mana Disruption by mana,
#               mana top-ups from the demon, sacrifice and Symbol of Mana)
#   spell    -- spams a single incant <number> until all targets are dead;
#               waits if mana drops below the configured minimum
#
# Voln symbols:
#   Courage, Protection and Supremacy (9805, 9806, 9816) are kept up -- cast before the
#   entry fee is paid (so it costs no arena time) and topped up before every attack pass.
#   Change the list in setup ("Symbols"); blank = none.
#
# Mind rest:
#   If your mind hits the configured pause threshold, the script navigates
#   to the rest location via ;go2 and waits until mind falls to the resume
#   threshold, then returns to the arena entrance and continues.
#   Rest location accepts a keyword (node, supernode) or a room number.
#
# Usage:
#   ;fizzabyss        -- run the arena loop using saved settings
#   ;fizzabyss setup  -- open the GTK setup GUI to configure options:
#                          Loot container, Attack mode, Attack script, Spell number,
#                          Min mana, Symbols, Pause at mind %, Resume at mind %,
#                          Rest location (node / supernode / room number)

require 'yaml'

# ---------------------------------------------------------------------------
# Settings
# ---------------------------------------------------------------------------
module FizzAbyss
  VERSION = '1.0'

  MANA_WAIT_DEFAULT   = 30
  MIND_PAUSE_DEFAULT  = 100
  MIND_RESUME_DEFAULT = 75
  REST_LOC_DEFAULT    = 'node'
  SCRIPT_DEFAULT      = 'Fizzleworth-attack-arena'
  SYMBOLS_DEFAULT     = '9805, 9806, 9816'   # Courage, Protection, Supremacy
  SYMBOL_GAP          = 60                   # secs before a symbol that didn't take is tried again

  def self.settings_path(name = 'fizzabyss.yaml')
    File.join(DATA_DIR, XMLData.game, Char.name, name)
  end

  # First run: start from abyssx's settings, but with the script attack.
  def self.load_settings
    return (YAML.load_file(settings_path) rescue {}) if File.exist?(settings_path)
    old = settings_path('abyssx.yaml')
    return {} unless File.exist?(old)
    seeded = (YAML.load_file(old) rescue {}).merge('attack_mode' => 'script', 'attack_script' => SCRIPT_DEFAULT)
    save_settings(seeded)
    echo 'fizzabyss: copied your abyssx settings (attack mode -> script).'
    seeded
  end

  def self.save_settings(data)
    dir = File.dirname(settings_path)
    Dir.mkdir(dir) unless Dir.exist?(dir)
    File.write(settings_path, data.to_yaml)
  end

  # ---------------------------------------------------------------------------
  # GUI
  # ---------------------------------------------------------------------------
  module SetupGUI
    def self.run
      unless defined?(Gtk) && Gtk::Version::MAJOR == 3
        echo 'GTK3 is not available. Cannot open setup GUI.'
        exit
      end

      saved    = FizzAbyss.load_settings
      @running = true
      @result  = nil

      Gtk.queue do
        @win = Gtk::Window.new(:toplevel)
        @win.set_title('FizzAbyss Setup')
        @win.set_default_size(380, 300)
        @win.set_border_width(12)
        @win.keep_above = true

        vbox = Gtk::Box.new(:vertical, 10)
        @win.add(vbox)

        # one labelled text row
        row = lambda do |label, text, hint = nil|
          r = Gtk::Box.new(:horizontal, 6)
          l = Gtk::Label.new(label)
          l.set_size_request(140, -1)
          l.set_halign(:start)
          e = Gtk::Entry.new
          e.text = text.to_s
          e.set_hexpand(true)
          r.pack_start(l, expand: false, fill: false, padding: 0)
          r.pack_start(e, expand: true,  fill: true,  padding: 0)
          vbox.pack_start(r, expand: false, fill: false, padding: 0)
          if hint
            h = Gtk::Label.new(hint)
            h.set_halign(:start)
            vbox.pack_start(h, expand: false, fill: false, padding: 0)
          end
          e
        end

        @entry_lootsack = row.call('Loot container:', saved.fetch('lootsack', Vars.lootsack.to_s))

        vbox.pack_start(Gtk::Separator.new(:horizontal), expand: false, fill: false, padding: 4)

        # --- Attack mode ---
        mode_lbl = Gtk::Label.new('Attack mode:')
        mode_lbl.set_halign(:start)
        vbox.pack_start(mode_lbl, expand: false, fill: false, padding: 0)

        @radio_script = Gtk::RadioButton.new(label: 'Run a script each round')
        @radio_spell  = Gtk::RadioButton.new(member: @radio_script, label: 'Spam spell')
        if saved.fetch('attack_mode', 'script') == 'spell'
          @radio_spell.active = true
        else
          @radio_script.active = true
        end
        vbox.pack_start(@radio_script, expand: false, fill: false, padding: 0)
        vbox.pack_start(@radio_spell,  expand: false, fill: false, padding: 0)

        @entry_script = row.call('Attack script:', saved.fetch('attack_script', SCRIPT_DEFAULT))
        @entry_spell  = row.call('Spell number:', saved.fetch('spell_number', '').to_s)
        @entry_mana   = row.call('Min mana (spell mode):', saved.fetch('min_mana', MANA_WAIT_DEFAULT))
        @entry_symbols = row.call('Symbols (spell #s):', saved.fetch('symbols', SYMBOLS_DEFAULT),
                                  '(9805 Courage, 9806 Protection, 9816 Supremacy; blank = none)')
        @entry_mind_pause  = row.call('Pause at mind %:', saved.fetch('mind_pause', MIND_PAUSE_DEFAULT))
        @entry_mind_resume = row.call('Resume at mind %:', saved.fetch('mind_resume', MIND_RESUME_DEFAULT))
        @entry_rest_loc    = row.call('Rest location:', saved.fetch('rest_loc', REST_LOC_DEFAULT), '(node, supernode, or room #)')

        vbox.pack_start(Gtk::Separator.new(:horizontal), expand: false, fill: false, padding: 4)

        # --- Buttons ---
        btnrow = Gtk::Box.new(:horizontal, 8)
        vbox.pack_start(btnrow, expand: false, fill: false, padding: 0)

        save_btn = Gtk::Button.new(label: 'Save & Close')
        save_btn.signal_connect('clicked') do
          data = {
            'lootsack'      => @entry_lootsack.text.strip,
            'attack_mode'   => @radio_spell.active? ? 'spell' : 'script',
            'attack_script' => @entry_script.text.strip,
            'spell_number'  => @entry_spell.text.strip.to_i,
            'min_mana'      => @entry_mana.text.strip.to_i,
            'symbols'       => @entry_symbols.text.strip,
            'mind_pause'    => @entry_mind_pause.text.strip.to_i,
            'mind_resume'   => @entry_mind_resume.text.strip.to_i,
            'rest_loc'      => @entry_rest_loc.text.strip,
          }
          FizzAbyss.save_settings(data)
          @result = data
          @win.destroy
        end

        cancel_btn = Gtk::Button.new(label: 'Cancel')
        cancel_btn.signal_connect('clicked') { @win.destroy }

        btnrow.pack_end(save_btn,   expand: false, fill: false, padding: 0)
        btnrow.pack_end(cancel_btn, expand: false, fill: false, padding: 0)

        @win.signal_connect('destroy') { Gtk.queue { @running = false } }
        @win.show_all
      end

      wait_while { @running }

      if @result
        echo 'FizzAbyss settings saved.'
      else
        echo 'Setup cancelled.'
      end
    end
  end

  # ---------------------------------------------------------------------------
  # Arena runner
  # ---------------------------------------------------------------------------
  class Runner
    def initialize(settings)
      @settings    = settings
      @lootsack    = settings.fetch('lootsack', Vars.lootsack.to_s)
      @mode        = settings.fetch('attack_mode', 'script')
      @script      = settings.fetch('attack_script', SCRIPT_DEFAULT).to_s.strip
      @spell_num   = settings.fetch('spell_number', 0).to_i
      @min_mana    = settings.fetch('min_mana',    MANA_WAIT_DEFAULT).to_i
      @symbols     = settings.fetch('symbols',     SYMBOLS_DEFAULT).to_s.scan(/\d+/).map(&:to_i)
      @mind_pause  = settings.fetch('mind_pause',  MIND_PAUSE_DEFAULT).to_i
      @mind_resume = settings.fetch('mind_resume', MIND_RESUME_DEFAULT).to_i
      @rest_loc    = settings.fetch('rest_loc',    REST_LOC_DEFAULT).to_s.strip

      @symbol_tried   = {}
      @entrance_count = 0
      @fight_count    = 0
      @run_start      = nil
    end

    def run
      if script_mode? && !Script.exists?(@script)
        echo "fizzabyss: attack script '#{@script}' not found. Fix it in ;fizzabyss setup."
        exit
      end

      echo "FizzAbyss v#{FizzAbyss::VERSION} starting. " \
           "Attack: #{script_mode? ? ";#{@script}" : "spell #{@spell_num}"}. " \
           "Loot: #{@lootsack}. Rest: #{@rest_loc}"

      loop do
        navigate_to_entrance
        enter_arena
        arena_controller
      end
    end

    private

    # a spell mode with no spell number set falls back to the script
    def script_mode?
      !(@mode == 'spell' && @spell_num > 0)
    end

    # ------------------------------------------------------------------
    # Navigation
    # ------------------------------------------------------------------
    def navigate_to_entrance
      return if Room.current.id == 28549
      echo '  [Abyss] Navigating to arena entrance (28549)...'
      Script.run('go2', '28549')
      wait_while { running?('go2') }
    end

    # ------------------------------------------------------------------
    # Mind / rest check (uses percentmind -- returns 0-100 integer)
    # ------------------------------------------------------------------
    def mind_rest_needed?
      @mind_pause > 0 && percentmind >= @mind_pause
    end

    def rest_until_clear
      echo "  [FizzAbyss] Mind at #{percentmind}% (>= #{@mind_pause}%). " \
           "Heading to #{@rest_loc} to rest..."
      Script.run('go2', @rest_loc)
      wait_while { running?('go2') }
      loop do
        break if percentmind <= @mind_resume
        sleep 5
      end
      echo "  [FizzAbyss] Mind at #{percentmind}%. Returning to arena entrance..."
      Script.run('go2', '28549')
      wait_while { running?('go2') }
      echo '  [FizzAbyss] Back at arena. Resuming.'
    end

    # ------------------------------------------------------------------
    # Entry check
    # ------------------------------------------------------------------
    def remaining_entries
      fput 'event entr'
      deadline = Time.now + 5
      while Time.now < deadline
        line = get
        return line.match(/Ebon Gate Entries:\s+(\d+)/)[1].to_i \
          if line =~ /Ebon Gate Entries:\s+(\d+)/
      end
      echo '  [Abyss] Could not read Ebon Gate entry count.'
      0
    end

    # ------------------------------------------------------------------
    # Enter
    # ------------------------------------------------------------------
    def enter_arena
      rest_until_clear if mind_rest_needed?

      entries = remaining_entries
      if entries == 0
        echo 'No Ebon Gate entries remaining. Stopping.'
        exit
      end

      echo "  [Abyss] Ebon Gate entries remaining: #{entries}"
      keep_symbols
      Lich::Messaging.stream_window(
        "Entry: #{@entrance_count + 1} (#{entries} left)\r\n", 'familiar')

      result = dothistimeout('pay', 8,
        /You raise a barrel key|no entries|you don't have/i)

      if result =~ /You raise a barrel key/
        @entrance_count += 1
        @run_start = Time.now
      else
        echo "  [Abyss] Could not enter arena: #{result.inspect}"
        exit
      end
    end

    # ------------------------------------------------------------------
    # Voln symbols
    # ------------------------------------------------------------------
    # Casts each configured symbol that isn't running. One that doesn't take (not enough
    # favor: "You strain to perform the symbol...") is left alone for SYMBOL_GAP seconds.
    def keep_symbols
      @symbols.each do |n|
        sym = Spell[n]
        next unless sym.known? && !sym.active?
        next if @symbol_tried[n] && Time.now - @symbol_tried[n] < SYMBOL_GAP
        @symbol_tried[n] = Time.now
        sym.cast
        sleep 0.3
        echo "  [FizzAbyss] #{sym.name} didn't take (Voln favor?)." unless sym.active?
      end
    end

    # ------------------------------------------------------------------
    # Combat
    # ------------------------------------------------------------------
    def cast_spell
      waitrt?
      waitcastrt?
      # checkmana returns current mana as integer
      if checkmana < @min_mana
        echo "  [Abyss] Low mana (#{checkmana}/#{maxmana}). Waiting..."
        wait_while { checkmana < @min_mana }
        echo '  [Abyss] Mana recovered. Resuming.'
      end
      fput "incant #{@spell_num}"
      waitcastrt?
    end

    # The attack script is run straight from here, one launch per pass, until the
    # arena's current fiend is dead. (It does its own roundtime / mana handling.)
    def run_attack_script
      waitrt?
      waitcastrt?
      Script.run(@script)
      wait_while { running?(@script) }
      sleep 0.2   # a script that exits at once must not spin the loop
    end

    def attack_sequence
      while GameObj.targets.any? { |t| t.status !~ /dead|gone/ }
        keep_symbols
        if script_mode?
          run_attack_script
        else
          cast_spell
        end
      end
    end

    # ------------------------------------------------------------------
    # Arena event loop
    # ------------------------------------------------------------------
    def arena_controller
      loop do
        line = get

        if line =~ /We have another living one,.*#{Char.name}.*hailing from beyond this valence!/
          fput 'beg'

        elsif line =~ /A crimson bolt of lightning strikes the arena and .* appears!/
          @fight_count += 1
          attack_sequence

        elsif line =~ /#{Char.name} is triumphant, vanquishing all those that opposed (?:her|him|them)\./
          elapsed = Time.now - @run_start
          Lich::Messaging.stream_window(
            "Total Time: #{Time.at(elapsed).strftime('%M:%S')}\r\n", 'familiar')
          @fight_count = 0

        elsif line =~ /A massive tenebrous oculoth floats in and regurgitates (.*) into your (right|left) hand\./
          prize = $1
          hand  = $2
          Lich::Messaging.stream_window("Prize: #{prize}\r\n", 'familiar')
          result = dothistimeout("put #{hand} in my #{@lootsack}", 5, /You put/)
          if result =~ /You put/
            echo "  [Abyss] Looted: #{prize} (#{hand} hand -> #{@lootsack})"
          else
            echo "  [Abyss] Warning: could not stow #{prize} from #{hand} hand " \
                 "(#{result.inspect})"
          end
          break
        end
      end
    end
  end
end

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
arg = Script.current.vars[1].to_s.strip.downcase

if arg == 'setup'
  FizzAbyss::SetupGUI.run
  exit
end

settings = FizzAbyss.load_settings
if settings.empty?
  echo 'No settings found. Run: ;fizzabyss setup'
  exit
end

FizzAbyss::Runner.new(settings).run
