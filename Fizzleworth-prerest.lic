#Fizzleworth-prerest.lic

module FizzleworthPrerest

# Always-on: clears stationary sticky-web hazards during travel before we walk
# into one (bigshot / go2 only wait webs out). Variant-independent. Restarted
# here in case it ever dies mid-run.
Script.start("Fizzleworth-webward") unless Script.running?("Fizzleworth-webward")

# Watches for end-of-hunt and dismisses the ;reanim animate buddy IN THE FIELD
# (weapon back to verlok -> "tell anim die" -> ;eloot), before bigshot walks
# home. Restarted here in case it ever dies mid-run.
Script.start("Fizzleworth-anim-cleanup") unless Script.running?("Fizzleworth-anim-cleanup")

# Town-side fallback for the above, for the rare case the monitor missed the
# window: strip the spare weapon back onto verlok, "tell anim die", ;eloot.
# No-op when no animate is up (base hunts, or already cleaned up).
Script.run("reanim", "die")

Script.run("eherbs")
Script.run("eloot", "sell")
Script.run("Fizzleworth-rest")
Script.run("undead_bounty", "kill magna vereri")
Script.run("buyitems")
Script.run("ewaggle")
Script.run("timequit")

# playsongs only when you're actually at the keyboard. Same afk_now UserVar that
# gates deadexit (unset counts as ON, i.e. AFK -> no music):
#   ;vars set afk_now=false   # at the keyboard: music plays during rest
#   ;vars set afk_now=true    # walking away: no music (and deadexit stays armed)
def self.afk_now?
  value = UserVars.afk_now
  return true if value.nil?
  return value if value == true || value == false

  value.to_s !~ /\A\s*(?:0|false|off|no)\s*\z/i
end

# Music while safe/resting -- Fizzleworth-prep.lic kills this again before combat
# resumes, which also stows the instrument (see playsongs.lic's before_dying).
Script.start("playsongs") unless afk_now? || Script.running?("playsongs")

end #End of module
